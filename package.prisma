#prisma 4.0
def package "luce-browser-foundation" {
    str owner = "dymokomi"
    str version = "0.5.0"
    str kind = "package"
    str language = "luce-base"
    str description = "The foundations of the luce-browser port of Ladybird: the AK subset, LibGC, the LibUnicode pieces LibWeb uses, LibTextCodec, LibURL and the WHATWG Infra helpers, in luce-base."
    str readme = "README.md"
    str[] public = ["ak", "gc", "text_codec", "web_infra", "web_unicode", "web_url"]

    def dependency "luce-std" {
        str owner = "dymokomi"
        str path = "../luce-std"
    }

    def dependency "luce-regex" {
        str owner = "dymokomi"
        str path = "../luce-regex"
    }
}
