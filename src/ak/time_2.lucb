# mark: timeval and timespec arithmetic =========================================================

## Ported from AK/Time.h:589 AK::timeval_sub.
pub func timeval_sub(a: Timeval, b: Timeval, result: Timeval*):
    result.tv_sec = a.tv_sec - b.tv_sec
    result.tv_usec = a.tv_usec - b.tv_usec
    if result.tv_usec < 0:
        result.tv_sec -= 1
        result.tv_usec += 1000000

## Ported from AK/Time.h:600 AK::timeval_add.
pub func timeval_add(a: Timeval, b: Timeval, result: Timeval*):
    result.tv_sec = a.tv_sec + b.tv_sec
    result.tv_usec = a.tv_usec + b.tv_usec
    if result.tv_usec >= 1000000:
        result.tv_sec += 1
        result.tv_usec -= 1000000

## Ported from AK/Time.h:611 AK::timespec_sub.
pub func timespec_sub(a: Timespec, b: Timespec, result: Timespec*):
    result.tv_sec = a.tv_sec - b.tv_sec
    result.tv_nsec = a.tv_nsec - b.tv_nsec
    if result.tv_nsec < 0:
        result.tv_sec -= 1
        result.tv_nsec += 1000000000

## Ported from AK/Time.h:622 AK::timespec_add.
pub func timespec_add(a: Timespec, b: Timespec, result: Timespec*):
    result.tv_sec = a.tv_sec + b.tv_sec
    result.tv_nsec = a.tv_nsec + b.tv_nsec
    if result.tv_nsec >= 1000000000:
        result.tv_sec += 1
        result.tv_nsec -= 1000000000

## Ported from AK/Time.h:633 AK::timespec_add_timeval.
pub func timespec_add_timeval(a: Timespec, b: Timeval, result: Timespec*):
    result.tv_sec = a.tv_sec + b.tv_sec
    result.tv_nsec = a.tv_nsec + b.tv_usec * 1000
    if result.tv_nsec >= 1000000000:
        result.tv_sec += 1
        result.tv_nsec -= 1000000000

## Ported from AK/Time.h:644 AK::timeval_to_timespec.
pub func timeval_to_timespec(tv: Timeval, ts: Timespec*):
    ts.tv_sec = tv.tv_sec
    ts.tv_nsec = tv.tv_usec * 1000

## Ported from AK/Time.h:651 AK::timespec_to_timeval.
pub func timespec_to_timeval(ts: Timespec, tv: Timeval*):
    tv.tv_sec = ts.tv_sec
    tv.tv_usec = ts.tv_nsec // 1000

# mark: TimeLiterals ============================================================================

