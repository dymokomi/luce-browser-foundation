# mark: MonotonicTime ===========================================================================

# Monotonic time represents time returned from the CLOCK_MONOTONIC clock, which has an arbitrary fixed reference point.

# The private constructor MonotonicTime(Duration), as a value.
func make_monotonic_time(offset: Duration) -> MonotonicTime:
    var t: MonotonicTime
    monotonic_time_construct(&t, offset)
    return t

## Ported from AK/Time.cpp:437 AK::MonotonicTime::now.
pub func monotonic_time_now() -> MonotonicTime:
    return make_monotonic_time(now_time_from_clock(clock_monotonic()))

## Ported from AK/Time.cpp:442 AK::MonotonicTime::now_coarse.
pub func monotonic_time_now_coarse() -> MonotonicTime:
    return make_monotonic_time(now_time_from_clock(clock_monotonic_coarse()))

## Ported from AK/Time.h:562 AK::MonotonicTime::seconds.
pub func monotonic_time_seconds(this: const MonotonicTime*) -> i64:
    return duration_to_seconds(&this.unaware_time.m_offset)

## Ported from AK/Time.h:563 AK::MonotonicTime::milliseconds.
pub func monotonic_time_milliseconds(this: const MonotonicTime*) -> i64:
    return duration_to_milliseconds(&this.unaware_time.m_offset)

## Ported from AK/Time.h:564 AK::MonotonicTime::nanoseconds.
pub func monotonic_time_nanoseconds(this: const MonotonicTime*) -> i64:
    return duration_to_nanoseconds(&this.unaware_time.m_offset)

## Ported from AK/Time.h:566 AK::MonotonicTime::truncated_seconds.
# Never returns a point in the future, since fractional seconds are cut off.
pub func monotonic_time_truncated_seconds(this: const MonotonicTime*) -> i64:
    return duration_to_truncated_seconds(&this.unaware_time.m_offset)

## Ported from AK/Time.h:567 AK::MonotonicTime::nanoseconds_within_second.
pub func monotonic_time_nanoseconds_within_second(this: const MonotonicTime*) -> i64:
    return unaware_time_to_timespec(&this.unaware_time).tv_nsec

## Ported from AK/Time.h:569 AK::MonotonicTime::operator==.
pub func monotonic_time_eq(this: const MonotonicTime*, other: MonotonicTime) -> bool:
    return this.unaware_time.m_offset == other.unaware_time.m_offset

## Ported from AK/Time.h:570 AK::MonotonicTime::operator<=>.
pub func monotonic_time_cmp(this: const MonotonicTime*, other: MonotonicTime) -> i32:
    return duration_cmp(&this.unaware_time.m_offset, other.unaware_time.m_offset)

## Ported from AK/Time.h:572 AK::MonotonicTime::operator+.
pub func monotonic_time_add(this: const MonotonicTime*, other: Duration) -> MonotonicTime:
    return make_monotonic_time(duration_add(&this.unaware_time.m_offset, other))

## Ported from AK/Time.h:573 AK::MonotonicTime::operator+=.
pub func monotonic_time_add_assign(this: MonotonicTime*, other: Duration) -> MonotonicTime*:
    this.unaware_time.m_offset = duration_add(&this.unaware_time.m_offset, other)
    return this

