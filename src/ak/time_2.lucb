#==============================================================================================
#
#   time_2 - UnawareTime, UnixDateTime, MonotonicTime and the timeval/timespec helpers
#
#   DESCRIPTION:
#       Port of AK/Time.h (lines 380-663) with the out-of-line definitions of AK/Time.cpp
#       (lines 380-487, the POSIX clock branch) and the calendar name tables of
#       AK/DateConstants.h. UnixDateTime::to_string_impl and parse are in time_3.
#       CLOCK_*_COARSE is the plain clock on macOS, as AK/Platform.h defines it there.
#
#==============================================================================================

# mark: C time functions ========================================================================

# struct tm of <time.h>: the layout of macOS and glibc (tm_gmtoff is a long, tm_zone a char*).
extern struct Tm:
    tm_sec: i32
    tm_min: i32
    tm_hour: i32
    tm_mday: i32
    tm_mon: i32
    tm_year: i32
    tm_wday: i32
    tm_yday: i32
    tm_isdst: i32
    tm_gmtoff: i64
    tm_zone: const u8*?

extern func clock_gettime(clock_id: i32, tp: Timespec*) -> i32
extern func gmtime_r(timep: const i64*, result: Tm*) -> Tm*?
extern func localtime_r(timep: const i64*, result: Tm*) -> Tm*?
extern func mktime(tm: Tm*) -> i64
extern func timegm(tm: Tm*) -> i64

# A zeroed struct tm.
func zeroed_tm() -> Tm:
    return Tm(tm_sec = 0, tm_min = 0, tm_hour = 0, tm_mday = 0, tm_mon = 0, tm_year = 0, tm_wday = 0, tm_yday = 0, tm_isdst = 0, tm_gmtoff = 0, tm_zone = none)

# CLOCK_REALTIME and CLOCK_REALTIME_COARSE: 0 on both targets; Linux's coarse clock is 5.
func clock_realtime_coarse() -> i32:
    if os.linux:
        return 5
    else:
        return 0

# CLOCK_MONOTONIC: 6 on macOS, 1 on Linux.
func clock_monotonic() -> i32:
    if os.macos:
        return 6
    else:
        return 1

# CLOCK_MONOTONIC_COARSE: CLOCK_MONOTONIC on macOS (AK/Platform.h), 6 on Linux.
func clock_monotonic_coarse() -> i32:
    if os.linux:
        return 6
    else:
        return clock_monotonic()

