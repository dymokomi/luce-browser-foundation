test "time: from_milliseconds":
    expect_duration(duration_from_milliseconds(0), 0, 0)
    expect_duration(duration_from_milliseconds(42), 0, 42000000)
    expect_duration(duration_from_milliseconds(-1), -1, 999000000)
    expect_duration(duration_from_milliseconds(-1000000000), -1000000, 0)
    expect_duration(duration_from_milliseconds(1000000000), 1000000, 0)
    expect_duration(duration_from_milliseconds(9223372036854775807), 9223372036854775, 807000000)
    expect_duration(duration_from_milliseconds(-0x8000000000000000), -9223372036854776, 192000000)

test "time: from_unix_time_parts_overflow":
    expect_duration(offset_of(unix_date_time_from_unix_time_parts(0, 1, 1, 0, 0, 0, 0)), -62167219200, 0)
    expect_duration(offset_of(unix_date_time_from_unix_time_parts(-1000000, 1, 1, 0, 0, 0, 0)), -31619119219200, 0)
    expect_duration(offset_of(unix_date_time_from_unix_time_parts(-2147483648, 1, 1, 0, 0, 0, 0)), -67768100567971200, 0)
    expect_duration(offset_of(unix_date_time_from_unix_time_parts(-2147483648, 1, 0, 0, 0, 0, 0)), -67768100568057600, 0)
    expect_duration(offset_of(unix_date_time_from_unix_time_parts(-2147483648, 0, 0, 0, 0, 0, 0)), -67768100567971200, 0)
    expect_duration(offset_of(unix_date_time_from_unix_time_parts(1970, 1, 1, 0, 0, 0, 65535)), 65, 535000000)
    expect_duration(offset_of(unix_date_time_from_unix_time_parts(1970, 1, 1, 0, 0, 255, 0)), 255, 0)
    expect_duration(offset_of(unix_date_time_from_unix_time_parts(1970, 1, 1, 0, 255, 0, 0)), 15300, 0)
    expect_duration(offset_of(unix_date_time_from_unix_time_parts(1970, 1, 1, 255, 0, 0, 0)), 918000, 0)
    expect_duration(offset_of(unix_date_time_from_unix_time_parts(1970, 1, 255, 0, 0, 0, 0)), 21945600, 0)
    expect_duration(offset_of(unix_date_time_from_unix_time_parts(1970, 12, 1, 0, 0, 0, 0)), 28857600, 0)
    expect_duration(offset_of(unix_date_time_from_unix_time_parts(1970, 255, 1, 0, 0, 0, 0)), 0, 0)
    expect_duration(offset_of(unix_date_time_from_unix_time_parts(1000000, 1, 1, 0, 0, 0, 0)), 31494784780800, 0)
    expect_duration(offset_of(unix_date_time_from_unix_time_parts(2147483647, 1, 1, 0, 0, 0, 0)), 67767976201996800, 0)
    expect_duration(offset_of(unix_date_time_from_unix_time_parts(2147483647, 12, 255, 0, 0, 0, 0)), 67767976252800000, 0)
    expect_duration(offset_of(unix_date_time_from_unix_time_parts(2147483647, 12, 255, 255, 255, 255, 65535)), 67767976253733620, 535000000)
    expect_duration(offset_of(unix_date_time_from_unix_time_parts(2147483647, 255, 255, 255, 255, 255, 65535)), 67767976202930420, 535000000)

test "time: seconds_parsing":
    expect_duration(duration_from_seconds(0), 0, 0)
    expect_duration(duration_from_seconds(42), 42, 0)
    expect_duration(duration_from_seconds(-1), -1, 0)
    expect_duration(duration_from_seconds(-0x80000000), -0x80000000, 0)
    expect_duration(duration_from_seconds(-0x8000000000000000), -0x8000000000000000, 0)
    expect_duration(duration_from_seconds(0x7fffffffffffffff), 0x7fffffffffffffff, 0)

test "time: is_negative":
    let small = duration_from_nanoseconds(10)
    let large = duration_from_nanoseconds(15)
    var result = duration_sub(&small, large)
    assert(duration_to_nanoseconds(&result) == -5)
    assert(duration_is_negative(&result))
    result = duration_sub(&large, small)
    assert(duration_to_nanoseconds(&result) == 5)
    assert(not duration_is_negative(&result))
