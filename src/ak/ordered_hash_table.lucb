pub func ordered_hash_table_try_set[T, TT: Traits[T]](this: OrderedHashTable[T, TT]*, value: T, existing_entry_behavior: HashSetExistingEntryBehavior = HashSetExistingEntryBehavior.replace) -> HashSetResult!:
