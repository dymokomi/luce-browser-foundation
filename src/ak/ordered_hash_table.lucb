#==============================================================================================
#
#   ordered_hash_table - OrderedHashTable<T>: the IsOrdered = true instantiation of HashTable
#
#   DESCRIPTION:
#       AK/HashTable.h with IsOrdered = true. OrderedHashTable[T, TT] wraps a HashTable whose
#       `m_ordered` flag each mutating member sets before delegating (a zero OrderedHashTable
#       is an empty ordered table), so every function here is the HashTable member of the
#       same name; iteration follows insertion order.
#
#==============================================================================================

## AK::OrderedHashTable copy constructor: the clone of `other` (DESIGN.md §3.3 rule 2).
pub func ordered_hash_table_clone[T, TT: Traits[T]](other: const OrderedHashTable[T, TT]*) -> OrderedHashTable[T, TT]:
    var table = OrderedHashTable[T, TT](m_table = hash_table_clone(&other.m_table))
    table.m_table.m_ordered = true
    return table

## AK::OrderedHashTable::HashTable(size_t capacity) (AK/HashTable.h, IsOrdered = true).
pub func ordered_hash_table_construct[T, TT: Traits[T]](this: OrderedHashTable[T, TT]*, capacity: usize):
    this.m_table.m_ordered = true
    hash_table_construct(&this.m_table, capacity)

## AK::OrderedHashTable::is_empty (AK/HashTable.h, IsOrdered = true).
pub func ordered_hash_table_is_empty[T, TT: Traits[T]](this: const OrderedHashTable[T, TT]*) -> bool:
    return hash_table_is_empty(&this.m_table)

## AK::OrderedHashTable::size (AK/HashTable.h, IsOrdered = true).
pub func ordered_hash_table_size[T, TT: Traits[T]](this: const OrderedHashTable[T, TT]*) -> usize:
    return hash_table_size(&this.m_table)

## AK::OrderedHashTable::capacity (AK/HashTable.h, IsOrdered = true).
pub func ordered_hash_table_capacity[T, TT: Traits[T]](this: const OrderedHashTable[T, TT]*) -> usize:
    return hash_table_capacity(&this.m_table)

## AK::OrderedHashTable::try_ensure_capacity (AK/HashTable.h, IsOrdered = true).
pub func ordered_hash_table_try_ensure_capacity[T, TT: Traits[T]](this: OrderedHashTable[T, TT]*, capacity: usize) -> !:
    this.m_table.m_ordered = true
    return try hash_table_try_ensure_capacity(&this.m_table, capacity)

## AK::OrderedHashTable::ensure_capacity (AK/HashTable.h, IsOrdered = true).
pub func ordered_hash_table_ensure_capacity[T, TT: Traits[T]](this: OrderedHashTable[T, TT]*, capacity: usize):
    this.m_table.m_ordered = true
    hash_table_ensure_capacity(&this.m_table, capacity)

## AK::OrderedHashTable::contains (AK/HashTable.h, IsOrdered = true).
pub func ordered_hash_table_contains_t[T, TT: Traits[T]](this: const OrderedHashTable[T, TT]*, value: T) -> bool:
    return hash_table_contains_t(&this.m_table, value)

## AK::OrderedHashTable::contains(K const&) (AK/HashTable.h, IsOrdered = true).
pub func ordered_hash_table_contains_k[T, TT: Traits[T], K, KT: HashCompatibleTraits[T, K]](this: const OrderedHashTable[T, TT]*, value: K) -> bool:
    return hash_table_contains_k[T, TT, K, KT](&this.m_table, value)

