#==============================================================================================
#
#   function - AK::Function<Out(In...)> as a function pointer beside its captures
#
#   DESCRIPTION:
#       Port of AK/Function.h (lines 1-390). DESIGN.md §2.7: a Function is support.lucb's
#       FunctionN[A1, ..., R], `{ call: func(void*?, A1, ...) -> R, context: void*? }`; the
#       lambda's captures are a struct in managed memory the context points at. The donor's
#       type erasure (CallableWrapperBase and its inline/outline storage) is what luce-base
#       spells as that pair, so its members are ported over the generated CallableWrapper
#       declarations for completeness, and operator(), operator bool and clear() are the
#       `functionN_call`, `functionN_is_set` and `functionN_clear` helpers below.
#
#==============================================================================================

# mark: Objective-C blocks ======================================================================

# The Blocks runtime (libclosure on macOS, libBlocksRuntime elsewhere). luce-base code never
# makes a block; these exist for a Function built around one by foreign code. Only macOS
# links a Blocks runtime by default, so elsewhere they trap (a test build keeps every
# function, so the externs must not be referenced there: COMPILER-REQUESTS item 10).
extern func c_block_copy as "_Block_copy"(block: const void*?) -> void*?
extern func c_block_release as "_Block_release"(block: const void*?)

## Ported from AK/Function.h:42 _Block_copy.
pub func block_copy(arg0: const void*?) -> void*?:
    if os.macos:
        return c_block_copy(arg0)
    else:
        trap("no Blocks runtime on this platform")

## Ported from AK/Function.h:43 _Block_release.
pub func block_release(arg0: const void*?):
    if os.macos:
        c_block_release(arg0)
    else:
        trap("no Blocks runtime on this platform")

## Ported from AK/Function.h:44 Block_size.
# Block_size reads the block descriptor: a block's layout starts with its isa, flags and
# reserved words, then the invoke pointer and the descriptor, whose second word is the size.
pub func block_size(arg0: const void*?) -> usize:
    let block = (const u8*)(arg0 else return 0)
    let descriptor = *(const (const usize*)*)(block + 24)
    return descriptor[1]

# mark: CallableWrapper =========================================================================

## Ported from AK/Function.h:206 AK::Function::CallableWrapperBase::call (virtual).
pub func callable_wrapper_base_call_impl(this: CallableWrapperBase*, arg0: void*?) -> void*?:
    _ = this
    _ = arg0
    trap("pure virtual: AK::Function::CallableWrapperBase::call")

## Ported from AK/Function.h:207 AK::Function::CallableWrapperBase::init_and_swap (virtual).
pub func callable_wrapper_base_init_and_swap_impl(this: CallableWrapperBase*, arg0: u8*?, arg1: usize):
    _ = this
    _ = arg0
    _ = arg1
    trap("pure virtual: AK::Function::CallableWrapperBase::init_and_swap")

## Ported from AK/Function.h:208 AK::Function::CallableWrapperBase::raw_callable (virtual).
pub func callable_wrapper_base_raw_callable_impl(this: CallableWrapperBase*) -> const void*?:
    _ = this
    trap("pure virtual: AK::Function::CallableWrapperBase::raw_callable")

## Ported from AK/Function.h:217 AK::Function::CallableWrapper::CallableWrapper<CallableType>.
pub func callable_wrapper_construct[TCallableType](this: CallableWrapper[TCallableType]*, callable: TCallableType):
    this.m_callable = callable

## Ported from AK/Function.h:238 AK::Function::CallableWrapper::init_and_swap.
# NOLINTNEXTLINE(readability-non-const-parameter) False positive; destination is used in a placement new expression
pub func callable_wrapper_init_and_swap[TCallableType](this: CallableWrapper[TCallableType]*, destination: u8*?, size: usize):
    assert(size >= memory.size_of(CallableWrapper[TCallableType]))
    let target = (CallableWrapper[TCallableType]*)(destination else trap("init_and_swap: null destination"))
    *target = *this

## Ported from AK/Function.h:244 AK::Function::CallableWrapper::raw_callable.
pub func callable_wrapper_raw_callable[TCallableType](this: const CallableWrapper[TCallableType]*) -> const void*?:
    return &this.m_callable

# mark: Function ================================================================================

## AK::Function<R()>::operator(): calls the function with its captures. The
## function must not be empty (VERIFY(wrapper)).
pub func function0_call[R](this: const Function0[R]*) -> R:
    let function = this.call else trap("VERIFY: calling an empty AK::Function")
    return function(this.context)

## AK::Function<R()>::operator bool: whether the function holds a callable.
pub func function0_is_set[R](this: const Function0[R]*) -> bool:
    return this.call != none

## AK::Function<R()>::operator=(nullptr_t) / clear(): empties the function.
pub func function0_clear[R](this: Function0[R]*):
    this.call = none
    this.context = none

## AK::Function<R(A1)>::operator(): calls the function with its captures. The
## function must not be empty (VERIFY(wrapper)).
