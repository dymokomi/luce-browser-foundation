## Ported from AK/JsonObjectSerializer.h:248 AK::JsonArraySerializer::add_object: a nested object.
pub func json_array_serializer_add_object(this: JsonArraySerializer[StringBuilder]*) -> JsonObjectSerializer[StringBuilder]!:
    try json_array_serializer_begin_item(this)
    return try json_object_serializer_try_create(this.m_builder)

## Ported from AK/JsonObjectSerializer.h:180 AK::JsonObjectSerializer::add_array: a nested array.
pub func json_object_serializer_add_array(this: JsonObjectSerializer[StringBuilder]*, key: StringView) -> JsonArraySerializer[StringBuilder]!:
    try json_object_serializer_begin_item(this, key)
    return try json_array_serializer_try_create(this.m_builder)

## Ported from AK/JsonObjectSerializer.h:186 AK::JsonObjectSerializer::add_object: a nested object.
pub func json_object_serializer_add_object(this: JsonObjectSerializer[StringBuilder]*, key: StringView) -> JsonObjectSerializer[StringBuilder]!:
    try json_object_serializer_begin_item(this, key)
    return try json_object_serializer_try_create(this.m_builder)

## Ported from AK/JsonObjectSerializer.h:192 AK::JsonObjectSerializer::finish: writes `}`.
pub func json_object_serializer_finish(this: JsonObjectSerializer[StringBuilder]*) -> !:
    assert(not this.m_finished)
    this.m_finished = true
    try string_builder_try_append_u8(this.m_builder, '}')

## Ported from AK/JsonObjectSerializer.h:204 AK::JsonObjectSerializer::JsonObjectSerializer<type-parameter-0-0>.
pub func json_object_serializer_construct(this: JsonObjectSerializer[StringBuilder]*, builder: StringBuilder*):
    this.m_builder = builder
    this.m_empty = true
    this.m_finished = false

## Ported from AK/JsonObjectSerializer.h:209 AK::JsonObjectSerializer::begin_item: a comma after the
## first member, then `"<key>":`.
func json_object_serializer_begin_item(this: JsonObjectSerializer[StringBuilder]*, key: StringView) -> !:
    assert(not this.m_finished)
    if not this.m_empty:
        try string_builder_try_append_u8(this.m_builder, ',')
    this.m_empty = false

    try string_builder_try_append_u8(this.m_builder, '"')
    try string_builder_try_append_escaped_for_json(this.m_builder, key)
    try string_builder_try_append_string_view(this.m_builder, sv("\":"))
