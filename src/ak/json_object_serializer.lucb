#==============================================================================================
#
#   json_object_serializer - JsonObjectSerializer: writes a JSON object member by member
#
#   DESCRIPTION:
#       Port of AK/JsonObjectSerializer.h (lines 1-258), for the one Builder LibWeb uses,
#       StringBuilder (a "legacy builder", so every write is the try_append form), with
#       JsonArraySerializer::add_object, which the header defines.
#
#==============================================================================================

## Ported from AK/JsonObjectSerializer.h:20 AK::JsonObjectSerializer::try_create: writes `{`.
pub func json_object_serializer_try_create(builder: StringBuilder*) -> JsonObjectSerializer[StringBuilder]!:
    try string_builder_try_append_u8(builder, '{')
    var serializer: JsonObjectSerializer[StringBuilder] = ---
    json_object_serializer_construct(&serializer, builder)
    return serializer

## Ported from AK/JsonObjectSerializer.h:38 AK::JsonObjectSerializer::add(StringView, JsonValue const&).
pub func json_object_serializer_add_json_value2(this: JsonObjectSerializer[StringBuilder]*, key: StringView, value: const JsonValue2*) -> !:
    try json_object_serializer_begin_item(this, key)
    json_value2_serialize(value, this.m_builder)

## Ported from AK/JsonObjectSerializer.h:45 AK::JsonObjectSerializer::add(StringView, StringView).
pub func json_object_serializer_add_string_view(this: JsonObjectSerializer[StringBuilder]*, key: StringView, value: StringView) -> !:
    try json_object_serializer_begin_item(this, key)
    try json_serializer_append_string(this.m_builder, value)

## Ported from AK/JsonObjectSerializer.h:60 AK::JsonObjectSerializer::add(StringView, String const&).
pub func json_object_serializer_add_string(this: JsonObjectSerializer[StringBuilder]*, key: StringView, value: String) -> !:
    try json_object_serializer_begin_item(this, key)
    try json_serializer_append_string(this.m_builder, string_bytes_as_string_view(&value))

## Ported from AK/JsonObjectSerializer.h:75 AK::JsonObjectSerializer::add(StringView, char const*).
pub func json_object_serializer_add_u8(this: JsonObjectSerializer[StringBuilder]*, key: StringView, value: const u8*) -> !:
    try json_object_serializer_begin_item(this, key)
    try json_serializer_append_string(this.m_builder, c_string_view((libc.str)value))

## Ported from AK/JsonObjectSerializer.h:90 AK::JsonObjectSerializer::add(StringView, bool).
pub func json_object_serializer_add_bool(this: JsonObjectSerializer[StringBuilder]*, key: StringView, value: bool) -> !:
    try json_object_serializer_begin_item(this, key)
    try string_builder_try_append_string_view(this.m_builder, sv("true") if value else sv("false"))

## Ported from AK/JsonObjectSerializer.h:100 AK::JsonObjectSerializer::add(StringView, int).
pub func json_object_serializer_add_i32(this: JsonObjectSerializer[StringBuilder]*, key: StringView, value: i32) -> !:
    try json_object_serializer_begin_item(this, key)
    try vformat_arguments(this.m_builder, sv("{}"), [arg_i64((i64)value)])

