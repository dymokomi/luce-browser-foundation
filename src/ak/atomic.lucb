#==============================================================================================
#
#   atomic - the AK atomic free functions over luce-base `@T` atomics
#
#   DESCRIPTION:
#       Port of the free functions of AK/Atomic.h (lines 1-150). The donor's `T volatile*`
#       templates wrap the __atomic builtins; here a plain `T*` location is viewed as `(@T)*`
#       (language §5.9, §15.1) and the operation is the atomic's method. The templates are
#       instantiated per type with the type as a suffix (`atomic_fetch_add_u32`); the pointer
#       overloads (`T volatile**`) are generic over the pointee. AK::MemoryOrder maps onto
#       atomics.Ordering (memory_order_consume is acquire, as compilers implement it).
#       The Atomic<T> class template is not in the phase-1 closure: `@T` fields replace it.
#
#==============================================================================================

# mark: Memory orders ===========================================================================

# AK::MemoryOrder as luce-base's atomics.Ordering.
func atomic_ordering(order: MemoryOrder) -> atomics.Ordering:
    return match order:
        .memory_order_relaxed => atomics.Ordering.relaxed
        .memory_order_consume => atomics.Ordering.acquire
        .memory_order_acquire => atomics.Ordering.acquire
        .memory_order_release => atomics.Ordering.release
        .memory_order_acq_rel => atomics.Ordering.acq_rel
        _ => atomics.Ordering.seq_cst

# atomic_compare_exchange_strong's success order: release for acq_rel and release.
func atomic_cas_success_order(order: MemoryOrder) -> atomics.Ordering:
    if order == MemoryOrder.memory_order_acq_rel or order == MemoryOrder.memory_order_release:
        return atomics.Ordering.release
    return atomic_ordering(order)

# atomic_compare_exchange_strong's failure order: acquire for acq_rel and release.
func atomic_cas_failure_order(order: MemoryOrder) -> atomics.Ordering:
    if order == MemoryOrder.memory_order_acq_rel or order == MemoryOrder.memory_order_release:
        return atomics.Ordering.acquire
    return atomic_ordering(order)

# mark: Fences ==================================================================================

## Ported from AK/Atomic.h:15 AK::atomic_signal_fence.
# luce-base has no signal-only fence in this revision; a thread fence is at least as strong.
pub func atomic_signal_fence(order: MemoryOrder):
    atomics.fence(atomic_ordering(order))

## Ported from AK/Atomic.h:20 AK::atomic_thread_fence.
pub func atomic_thread_fence(order: MemoryOrder):
    atomics.fence(atomic_ordering(order))

## Ported from AK/Atomic.h:25 AK::full_memory_barrier.
pub func full_memory_barrier():
    atomic_signal_fence(MemoryOrder.memory_order_acq_rel)
    atomic_thread_fence(MemoryOrder.memory_order_acq_rel)

# mark: Scalar locations ========================================================================

# The atomic view of a plain `u8` location.
type AtomicU8Ptr = (@u8)*

# The atomic view of a plain `u16` location.
type AtomicU16Ptr = (@u16)*

# The atomic view of a plain `u32` location.
type AtomicU32Ptr = (@u32)*

# The atomic view of a plain `u64` location.
type AtomicU64Ptr = (@u64)*

# The atomic view of a plain `usize` location.
type AtomicUsizePtr = (@usize)*

# The atomic view of a plain `i32` location.
type AtomicI32Ptr = (@i32)*

# The atomic view of a plain `i64` location.
type AtomicI64Ptr = (@i64)*

# The atomic view of a plain `bool` location.
type AtomicBoolPtr = (@bool)*

## Ported from AK/Atomic.h:32 AK::atomic_exchange, for u8.
pub func atomic_exchange_u8(var_: u8*, desired: u8, order: MemoryOrder = MemoryOrder.memory_order_seq_cst) -> u8:
    return ((AtomicU8Ptr)(void*)var_).swap(desired, atomic_ordering(order))

