## Ported from AK/Atomic.h:50 AK::atomic_compare_exchange_strong, for u8.
pub func atomic_compare_exchange_strong_u8(var_: u8*, expected: u8*, desired: u8, order: MemoryOrder = MemoryOrder.memory_order_seq_cst) -> bool:
    let a = (AtomicU8Ptr)(void*)var_
    let (exchanged, observed) = a.cas(*expected, desired, atomic_cas_success_order(order), atomic_cas_failure_order(order))
    # __atomic_compare_exchange_n writes the observed value back into `expected` on failure.
    if not exchanged:
        *expected = observed
    return exchanged

## Ported from AK/Atomic.h:50 AK::atomic_compare_exchange_strong, for u16.
pub func atomic_compare_exchange_strong_u16(var_: u16*, expected: u16*, desired: u16, order: MemoryOrder = MemoryOrder.memory_order_seq_cst) -> bool:
    let a = (AtomicU16Ptr)(void*)var_
    let (exchanged, observed) = a.cas(*expected, desired, atomic_cas_success_order(order), atomic_cas_failure_order(order))
    # __atomic_compare_exchange_n writes the observed value back into `expected` on failure.
    if not exchanged:
