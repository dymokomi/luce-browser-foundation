# mark: Pointer locations =======================================================================

# The atomic view of a plain pointer location.
type AtomicPointerPtr = (@void*?)*

## Ported from AK/Atomic.h:38 AK::atomic_exchange (T volatile**, V*).
pub func atomic_exchange_v[V](var_: (V*?)*, desired: V*?, order: MemoryOrder = MemoryOrder.memory_order_seq_cst) -> V*?:
    return (V*?)((AtomicPointerPtr)(void*)var_).swap(desired, atomic_ordering(order))

## Ported from AK/Atomic.h:44 AK::atomic_exchange (T volatile**, nullptr_t).
pub func atomic_exchange_void[V](var_: (V*?)*, order: MemoryOrder = MemoryOrder.memory_order_seq_cst) -> V*?:
    return (V*?)((AtomicPointerPtr)(void*)var_).swap(none, atomic_ordering(order))

## Ported from AK/Atomic.h:58 AK::atomic_compare_exchange_strong (T volatile**, V*&, V*).
pub func atomic_compare_exchange_strong_v_v[V](var_: (V*?)*, expected: (V*?)*, desired: V*?, order: MemoryOrder = MemoryOrder.memory_order_seq_cst) -> bool:
    let a = (AtomicPointerPtr)(void*)var_
    let (exchanged, observed) = a.cas(*expected, desired, atomic_cas_success_order(order), atomic_cas_failure_order(order))
    if not exchanged:
        *expected = (V*?)observed
    return exchanged

## Ported from AK/Atomic.h:66 AK::atomic_compare_exchange_strong (T volatile**, V*&, nullptr_t).
pub func atomic_compare_exchange_strong_v_void[V](var_: (V*?)*, expected: (V*?)*, order: MemoryOrder = MemoryOrder.memory_order_seq_cst) -> bool:
    return atomic_compare_exchange_strong_v_v(var_, expected, none, order)

## Ported from AK/Atomic.h:110 AK::atomic_load (T volatile**).
pub func atomic_load_2[V](var_: (V*?)*, order: MemoryOrder = MemoryOrder.memory_order_seq_cst) -> V*?:
    return (V*?)((AtomicPointerPtr)(void*)var_).load(atomic_ordering(order))

## Ported from AK/Atomic.h:131 AK::atomic_store (T volatile**, V*).
pub func atomic_store_v[V](var_: (V*?)*, desired: V*?, order: MemoryOrder = MemoryOrder.memory_order_seq_cst):
