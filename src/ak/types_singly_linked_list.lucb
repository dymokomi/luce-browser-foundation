    pub var m_prev: SinglyLinkedListNode[T]*?  # C++ default: { nullptr }
    pub var m_next: SinglyLinkedListNode[T]*?  # C++ default: { nullptr }

    pub func iterator() -> SinglyLinkedListIterator[T]: return self

    pub func next() -> T*?: return singly_linked_list_iterator_next(&self)

