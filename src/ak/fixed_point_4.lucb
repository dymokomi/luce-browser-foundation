## Ported from AK/FixedPoint.h:313 AK::FixedPoint::operator*=(FixedPoint), for u8.
pub func fixed_point_mul_assign_fixed_point_u8[P: FixedPointPrecision](this: FixedPoint[u8, P]*, other: FixedPoint[u8, P]) -> FixedPoint[u8, P]*:
    *this = fixed_point_mul_fixed_point_u8(this, other)
