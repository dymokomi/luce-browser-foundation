# mark: FixedPoint<precision, u8> ===============================================================

# radix_mask for u8: the fraction bits.
func fixed_point_radix_mask_u8(precision: usize) -> u8:
    return ((u8)1 << (u8)precision) -% 1

## Ported from AK/FixedPoint.h:41 AK::FixedPoint::FixedPoint(Integral), for u8: `value` in the
## integer part.
pub func fixed_point_fixed_point_precision_underlying_u8[P: FixedPointPrecision](this: FixedPoint[u8, P]*, value: i64):
    let precision = fixed_point_precision[P]()
    this.m_value = (u8)value << (u8)precision

## Ported from AK/FixedPoint.h:46 AK::FixedPoint::FixedPoint(FloatingPoint), for u8 and f64:
## rounded to nearest, ties to even.
pub func fixed_point_construct_f64_u8[P: FixedPointPrecision](this: FixedPoint[u8, P]*, value: f64):
    let precision = fixed_point_precision[P]()
    this.m_value = (u8)rounding_round_to_f64_u32(value * (f64)((u8)1 << (u8)precision))

## Ported from AK/FixedPoint.h:46 AK::FixedPoint::FixedPoint(FloatingPoint), for u8 and f32.
pub func fixed_point_construct_f32_u8[P: FixedPointPrecision](this: FixedPoint[u8, P]*, value: f32):
    let precision = fixed_point_precision[P]()
    this.m_value = (u8)rounding_round_to_f32_u32(value * (f32)((u8)1 << (u8)precision))

## Ported from AK/FixedPoint.h:59 AK::FixedPoint::operator F, for u8 and f64.
pub func fixed_point_to_f64_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*) -> f64:
    let precision = fixed_point_precision[P]()
    return (f64)this.m_value * pow_f64(0.5, (f64)precision)

## Ported from AK/FixedPoint.h:59 AK::FixedPoint::operator F, for u8 and f32.
pub func fixed_point_to_f32_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*) -> f32:
    let precision = fixed_point_precision[P]()
    return (f32)this.m_value * pow_f32(0.5, (f32)precision)

## Ported from AK/FixedPoint.h:65 AK::FixedPoint::operator I, for u8: the truncated integer part.
pub func fixed_point_to_integer_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*) -> u8:
    let precision = fixed_point_precision[P]()
    let truncated = fixed_point_trunc_u8(this)
    return truncated.m_value >> (u8)precision

## Ported from AK/FixedPoint.h:70 AK::FixedPoint::create_raw, for u8.
pub func fixed_point_create_raw_u8[P: FixedPointPrecision](value: u8) -> FixedPoint[u8, P]:
    return FixedPoint[u8, P](m_value = value)

## Ported from AK/FixedPoint.h:77 AK::FixedPoint::raw, for u8.
pub func fixed_point_raw_const_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*) -> u8:
    return this.m_value

## Ported from AK/FixedPoint.h:81 AK::FixedPoint::raw, for u8.
pub func fixed_point_raw_u8[P: FixedPointPrecision](this: FixedPoint[u8, P]*) -> u8*:
    return &this.m_value

## Ported from AK/FixedPoint.h:86 AK::FixedPoint::fract, for u8.
pub func fixed_point_fract_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*) -> FixedPoint[u8, P]:
    let precision = fixed_point_precision[P]()
    return fixed_point_create_raw_u8[P](this.m_value & fixed_point_radix_mask_u8(precision))

## Ported from AK/FixedPoint.h:91 AK::FixedPoint::clamp, for u8.
pub func fixed_point_clamp_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*, minimum: FixedPoint[u8, P], maximum: FixedPoint[u8, P]) -> FixedPoint[u8, P]:
    if fixed_point_lt_fixed_point_u8(this, minimum):
        return minimum
    if fixed_point_gt_fixed_point_u8(this, maximum):
        return maximum
    return *this

## Ported from AK/FixedPoint.h:100 AK::FixedPoint::rint, for u8.
pub func fixed_point_rint_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*) -> FixedPoint[u8, P]:
    let precision = fixed_point_precision[P]()
    let radix_mask = fixed_point_radix_mask_u8(precision)
    # Note: Round fair, break tie to even
    var value = this.m_value >> (u8)precision

    # Note: For negative numbers the ordering are reversed,
    #       and they were already decremented by the shift, so we need to
    #       add 1 when we see a fract values behind the `.5`s place set,
    #       because that means they are smaller than .5
    # fract(m_value) >= .5?
    if (this.m_value & ((u8)1 << (u8)(precision - 1))) != 0:
        # fract(m_value) > .5?
        if (this.m_value & (radix_mask >> 1)) != 0:
            # yes: round "up";
            value = value +% 1
        else:
            #  no: round to even;
            value = value +% (value & 1)
    var result: FixedPoint[u8, P] = ---
    fixed_point_fixed_point_precision_underlying_u8(&result, (i64)value)
    return result

## Ported from AK/FixedPoint.h:122 AK::FixedPoint::floor, for u8.
pub func fixed_point_floor_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*) -> FixedPoint[u8, P]:
    let precision = fixed_point_precision[P]()
    return fixed_point_create_raw_u8[P](this.m_value & ~fixed_point_radix_mask_u8(precision))

## Ported from AK/FixedPoint.h:126 AK::FixedPoint::ceil, for u8.
pub func fixed_point_ceil_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*) -> FixedPoint[u8, P]:
    let precision = fixed_point_precision[P]()
    let radix_mask = fixed_point_radix_mask_u8(precision)
    let one: u8 = (u8)1 << (u8)precision
    return fixed_point_create_raw_u8[P]((this.m_value & ~radix_mask) +% (one if (this.m_value & radix_mask) != 0 else 0))

## Ported from AK/FixedPoint.h:131 AK::FixedPoint::trunc, for u8.
pub func fixed_point_trunc_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*) -> FixedPoint[u8, P]:
    let precision = fixed_point_precision[P]()
    let radix_mask = fixed_point_radix_mask_u8(precision)
    let one: u8 = (u8)1 << (u8)precision
    var adjustment: u8 = 0
    if (this.m_value & radix_mask) != 0:
        adjustment = 0 if this.m_value > 0 else one
    return fixed_point_create_raw_u8[P]((this.m_value & ~radix_mask) +% adjustment)

## Ported from AK/FixedPoint.h:139 AK::FixedPoint::lrint, for u8.
pub func fixed_point_lrint_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*) -> u8:
    let precision = fixed_point_precision[P]()
    let rounded = fixed_point_rint_u8(this)
    return rounded.m_value >> (u8)precision

## Ported from AK/FixedPoint.h:140 AK::FixedPoint::lfloor, for u8.
pub func fixed_point_lfloor_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*) -> u8:
    let precision = fixed_point_precision[P]()
    return this.m_value >> (u8)precision

## Ported from AK/FixedPoint.h:141 AK::FixedPoint::lceil, for u8.
pub func fixed_point_lceil_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*) -> u8:
    let precision = fixed_point_precision[P]()
    let radix_mask = fixed_point_radix_mask_u8(precision)
    return (this.m_value >> (u8)precision) +% (1 if (this.m_value & radix_mask) != 0 else 0)

## Ported from AK/FixedPoint.h:146 AK::FixedPoint::ltrunc, for u8.
pub func fixed_point_ltrunc_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*) -> u8:
    let precision = fixed_point_precision[P]()
    let radix_mask = fixed_point_radix_mask_u8(precision)
    var adjustment: u8 = 0
    if (this.m_value & radix_mask) != 0:
        adjustment = 0 if this.m_value > 0 else 1
    return (this.m_value >> (u8)precision) +% adjustment

## Ported from AK/FixedPoint.h:155 AK::FixedPoint::log2, for u8.
# http://www.claysturner.com/dsp/BinaryLogarithm.pdf
pub func fixed_point_log2_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*) -> FixedPoint[u8, P]:
    let precision = fixed_point_precision[P]()
    # 0.5
    var b = fixed_point_create_raw_u8[P]((u8)1 << (u8)(precision - 1))
    var y: FixedPoint[u8, P] = ---
    fixed_point_fixed_point_precision_underlying_u8(&y, 0)
    var x = *this

    # FIXME: There's no negative infinity.
    if x.m_value <= 0:
        return fixed_point_create_raw_u8[P](u8_min)

    if fixed_point_ne_i_u8(&x, 1):
        let shift_amount = (i32)log2_u8(x.m_value) - (i32)precision
        if shift_amount > 0:
            _ = fixed_point_shr_assign_u8(&x, (i64)shift_amount)
        else:
            _ = fixed_point_shl_assign_u8(&x, (i64)-shift_amount)
        _ = fixed_point_add_assign_i_u8(&y, (i64)shift_amount)

    for _i in 0..<precision:
        _ = fixed_point_mul_assign_fixed_point_u8(&x, x)
        if fixed_point_ge_i_u8(&x, 2):
            _ = fixed_point_shr_assign_u8(&x, 1)
            _ = fixed_point_add_assign_fixed_point_u8(&y, b)
        _ = fixed_point_shr_assign_u8(&b, 1)

    return y

## Ported from AK/FixedPoint.h:199 AK::FixedPoint::operator+(FixedPoint), for u8.
pub func fixed_point_add_fixed_point_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*, other: FixedPoint[u8, P]) -> FixedPoint[u8, P]:
    return fixed_point_create_raw_u8[P]((u8)((i32)this.m_value +% (i32)other.m_value))

## Ported from AK/FixedPoint.h:203 AK::FixedPoint::operator-(FixedPoint), for u8.
pub func fixed_point_sub_fixed_point_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*, other: FixedPoint[u8, P]) -> FixedPoint[u8, P]:
    return fixed_point_create_raw_u8[P]((u8)((i32)this.m_value -% (i32)other.m_value))

## Ported from AK/FixedPoint.h:207 AK::FixedPoint::operator*(FixedPoint), for u8 (the
## __SIZEOF_INT128__ branch: MulRes is i64).
pub func fixed_point_mul_fixed_point_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*, other: FixedPoint[u8, P]) -> FixedPoint[u8, P]:
    let precision = fixed_point_precision[P]()
    # FIXME: Figure out a nicer way to use more narrow types and avoid __int128
    var value = (i64)this.m_value
    value = value *% (i64)other.m_value

    var ret = fixed_point_create_raw_u8[P]((u8)(value >> (i64)precision))
    # Rounding:
    # If last bit cut off is 1:
    if (value & (i64)((u8)1 << (u8)(precision - 1))) != 0:
        # If the bit after is 1 as well
        if (value & (i64)(fixed_point_radix_mask_u8(precision) >> 1)) != 0:
            # We round away from 0
            ret.m_value = (u8)((i32)ret.m_value +% 1)
        else:
            # Otherwise we round to the next even value
            # Which means we add the least significant bit of the raw return value
            ret.m_value = (u8)((i32)ret.m_value +% (i32)(ret.m_value & 1))
    return ret

## Ported from AK/FixedPoint.h:240 AK::FixedPoint::operator/(FixedPoint), for u8 (DivRes is i64).
pub func fixed_point_div_fixed_point_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*, other: FixedPoint[u8, P]) -> FixedPoint[u8, P]:
    let precision = fixed_point_precision[P]()
    # FIXME: Figure out a nicer way to use more narrow types and avoid __int128
    var value = (i64)this.m_value
    value = value << (i64)precision
    value = value // (i64)other.m_value

    return fixed_point_create_raw_u8[P]((u8)value)

## Ported from AK/FixedPoint.h:273 AK::FixedPoint::operator+(Integral), for u8.
pub func fixed_point_add_i_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*, other: i64) -> FixedPoint[u8, P]:
    let precision = fixed_point_precision[P]()
    return fixed_point_create_raw_u8[P]((u8)((i32)this.m_value +% (i32)((u8)other << (u8)precision)))

## Ported from AK/FixedPoint.h:278 AK::FixedPoint::operator-(Integral), for u8.
pub func fixed_point_sub_i_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*, other: i64) -> FixedPoint[u8, P]:
    let precision = fixed_point_precision[P]()
    return fixed_point_create_raw_u8[P]((u8)((i32)this.m_value -% (i32)((u8)other << (u8)precision)))

## Ported from AK/FixedPoint.h:283 AK::FixedPoint::operator*(Integral), for u8.
pub func fixed_point_mul_i_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*, other: i64) -> FixedPoint[u8, P]:
    return fixed_point_create_raw_u8[P]((u8)((i32)this.m_value *% (i32)other))

## Ported from AK/FixedPoint.h:288 AK::FixedPoint::operator/(Integral), for u8.
pub func fixed_point_div_i_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*, other: i64) -> FixedPoint[u8, P]:
    return fixed_point_create_raw_u8[P]((u8)((i32)this.m_value // (i32)other))

## Ported from AK/FixedPoint.h:293 AK::FixedPoint::operator>>(Integral), for u8.
pub func fixed_point_shr_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*, other: i64) -> FixedPoint[u8, P]:
    return fixed_point_create_raw_u8[P]((u8)((i32)this.m_value >> (i32)other))

## Ported from AK/FixedPoint.h:298 AK::FixedPoint::operator<<(Integral), for u8.
pub func fixed_point_shl_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*, other: i64) -> FixedPoint[u8, P]:
    return fixed_point_create_raw_u8[P]((u8)((i32)this.m_value << (i32)other))

## Ported from AK/FixedPoint.h:303 AK::FixedPoint::operator+=(FixedPoint), for u8.
pub func fixed_point_add_assign_fixed_point_u8[P: FixedPointPrecision](this: FixedPoint[u8, P]*, other: FixedPoint[u8, P]) -> FixedPoint[u8, P]*:
    this.m_value = (u8)((i32)this.m_value +% (i32)other.m_value)
    return this

## Ported from AK/FixedPoint.h:308 AK::FixedPoint::operator-=(FixedPoint), for u8.
pub func fixed_point_sub_assign_fixed_point_u8[P: FixedPointPrecision](this: FixedPoint[u8, P]*, other: FixedPoint[u8, P]) -> FixedPoint[u8, P]*:
    this.m_value = (u8)((i32)this.m_value -% (i32)other.m_value)
