## Ported from AK/FixedPoint.h:337 AK::FixedPoint::operator*=(Integral), for u8.
pub func fixed_point_mul_assign_i_u8[P: FixedPointPrecision](this: FixedPoint[u8, P]*, other: i64) -> FixedPoint[u8, P]*:
    *this = fixed_point_mul_i_u8(this, other)
    return this

## Ported from AK/FixedPoint.h:343 AK::FixedPoint::operator/=(Integral), for u8.
