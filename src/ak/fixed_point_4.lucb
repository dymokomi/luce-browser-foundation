pub func fixed_point_shr_assign_u8[P: FixedPointPrecision](this: FixedPoint[u8, P]*, other: i64) -> FixedPoint[u8, P]*:
    *this = fixed_point_shr_u8(this, other)
    return this

## Ported from AK/FixedPoint.h:355 AK::FixedPoint::operator<<=(Integral), for u8.
pub func fixed_point_shl_assign_u8[P: FixedPointPrecision](this: FixedPoint[u8, P]*, other: i64) -> FixedPoint[u8, P]*:
    *this = fixed_point_shl_u8(this, other)
    return this

## Ported from AK/FixedPoint.h:361 AK::FixedPoint::operator==(FixedPoint), for u8.
pub func fixed_point_eq_fixed_point_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*, other: FixedPoint[u8, P]) -> bool:
    return this.m_value == other.m_value

## Ported from AK/FixedPoint.h:362 AK::FixedPoint::operator!=(FixedPoint), for u8.
pub func fixed_point_ne_fixed_point_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*, other: FixedPoint[u8, P]) -> bool:
    return this.m_value != other.m_value

## Ported from AK/FixedPoint.h:363 AK::FixedPoint::operator>(FixedPoint), for u8.
pub func fixed_point_gt_fixed_point_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*, other: FixedPoint[u8, P]) -> bool:
    return this.m_value > other.m_value

## Ported from AK/FixedPoint.h:364 AK::FixedPoint::operator>=(FixedPoint), for u8.
pub func fixed_point_ge_fixed_point_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*, other: FixedPoint[u8, P]) -> bool:
    return this.m_value >= other.m_value

## Ported from AK/FixedPoint.h:365 AK::FixedPoint::operator<(FixedPoint), for u8.
pub func fixed_point_lt_fixed_point_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*, other: FixedPoint[u8, P]) -> bool:
    return this.m_value < other.m_value

## Ported from AK/FixedPoint.h:366 AK::FixedPoint::operator<=(FixedPoint), for u8.
pub func fixed_point_le_fixed_point_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*, other: FixedPoint[u8, P]) -> bool:
    return this.m_value <= other.m_value

## Ported from AK/FixedPoint.h:370 AK::FixedPoint::operator==(Integral), for u8.
# FIXME: There are probably better ways to do these
pub func fixed_point_eq_i_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*, other: i64) -> bool:
    let precision = fixed_point_precision[P]()
    return (i32)(this.m_value >> (u8)precision) == (i32)other and (this.m_value & fixed_point_radix_mask_u8(precision)) == 0

## Ported from AK/FixedPoint.h:375 AK::FixedPoint::operator!=(Integral), for u8.
pub func fixed_point_ne_i_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*, other: i64) -> bool:
    let precision = fixed_point_precision[P]()
    return (i32)(this.m_value >> (u8)precision) != (i32)other or (this.m_value & fixed_point_radix_mask_u8(precision)) != 0

## Ported from AK/FixedPoint.h:380 AK::FixedPoint::operator>(Integral), for u8.
pub func fixed_point_gt_i_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*, other: i64) -> bool:
    return not fixed_point_le_i_u8(this, other)

## Ported from AK/FixedPoint.h:385 AK::FixedPoint::operator>=(Integral), for u8.
pub func fixed_point_ge_i_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*, other: i64) -> bool:
    return not fixed_point_lt_i_u8(this, other)

## Ported from AK/FixedPoint.h:390 AK::FixedPoint::operator<(Integral), for u8.
pub func fixed_point_lt_i_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*, other: i64) -> bool:
    let precision = fixed_point_precision[P]()
    return (i32)(this.m_value >> (u8)precision) < (i32)other or this.m_value < ((u8)other << (u8)precision)

## Ported from AK/FixedPoint.h:395 AK::FixedPoint::operator<=(Integral), for u8.
pub func fixed_point_le_i_u8[P: FixedPointPrecision](this: const FixedPoint[u8, P]*, other: i64) -> bool:
    return fixed_point_lt_i_u8(this, other) or fixed_point_eq_i_u8(this, other)
