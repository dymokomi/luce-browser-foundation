# mark: FormatIfSupported =======================================================================

## Ported from AK/Format.h:751 AK::FormatIfSupported::FormatIfSupported<T>.
pub func format_if_supported_construct[T](this: FormatIfSupported[T]*, value: const T*):
    this.m_value = value

## Ported from AK/Format.h:756 AK::FormatIfSupported::value.
pub func format_if_supported_value[T](this: const FormatIfSupported[T]*) -> const T*:
    return this.m_value

## Ported from AK/Format.h:763 AK::__FormatIfSupported::format, for a T without a Formatter:
## a "?" with the parsed flags. (__FormatIfSupported<T, true> is Formatter<T> itself: a value
## whose type has a formatter is passed with that formatter.)
pub func format_if_supported2_format[T](this: FormatIfSupported2[T]*, builder: FormatBuilder*, arg1: const FormatIfSupported[T]*) -> !:
    try formatter_string_view_format(&this.formatter, builder, sv("?"))

## __format_value<FormatIfSupported<T>> for a T without a Formatter; `value` points at the
## FormatIfSupported.
pub func format_value_format_if_supported(params: TypeErasedFormatParams*, builder: FormatBuilder*, parser: FormatParser*, value: const void*?) -> !:
    var formatter = FormatIfSupported2[u8](formatter = standard_formatter_create())
    standard_formatter_parse(&formatter.formatter, params, parser)
    try format_if_supported2_format(&formatter, builder, (const FormatIfSupported[u8]*)format_value_target(value))

# mark: Formatter<Optional<T>> ==================================================================

## Ported from AK/Format.h:835 AK::Formatter<Optional<T>>::format: the value with its own
## formatter ("{}"), or "None".
pub func formatter_optional_format(this: StandardFormatter*, builder: FormatBuilder*, value: TypeErasedParameter?) -> !:
    if let present = value:
        return try formatter_format_string_format(this, builder, sv("{}"), [present])
    return try format_builder_put_literal(builder, sv("None"))
