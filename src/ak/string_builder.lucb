## Ported from AK/StringBuilder.cpp:385 AK::StringBuilder::append_code_point.
pub func string_builder_append_code_point(this: StringBuilder*, code_point: u32):
    if not is_unicode(code_point):
        string_builder_append_code_point(this, unicode_utils_replacement_code_point)
        return

    let append_as_utf8 = this.m_mode == StringBuilderMode.utf8 or (this.m_utf16_builder_is_ascii and is_ascii(code_point))

    if not append_as_utf8:
        string_builder_ensure_storage_is_utf16(this) else trap("MUST: ensure_storage_is_utf16")
        _ = string_builder_will_append(this, 2) catch: recover ()

        if code_point < unicode_utils_first_supplementary_plane_code_point:
            string_builder_append_code_unit_bytes(this, (u16)code_point) else trap("MUST: append_code_point")
            return

        _ = string_builder_will_append(this, 2) catch: recover ()
        let supplementary = code_point - unicode_utils_first_supplementary_plane_code_point

        var code_unit = (u16)((u32)unicode_utils_high_surrogate_min | (supplementary >> 10))
        string_builder_append_code_unit_bytes(this, code_unit) else trap("MUST: append_code_point")

        code_unit = (u16)((u32)unicode_utils_low_surrogate_min | (supplementary & 0x3ff))
        string_builder_append_code_unit_bytes(this, code_unit) else trap("MUST: append_code_point")

        return

    if code_point <= 0x7f:
        byte_buffer_append_u8(&this.m_buffer, (u8)code_point)
    elif code_point <= 0x07ff:
        _ = string_builder_will_append(this, 2) catch: recover ()
        byte_buffer_append_u8(&this.m_buffer, (u8)(((code_point >> 6) & 0x1f) | 0xc0))
        byte_buffer_append_u8(&this.m_buffer, (u8)(((code_point >> 0) & 0x3f) | 0x80))
    elif code_point <= 0xffff:
        _ = string_builder_will_append(this, 3) catch: recover ()
        byte_buffer_append_u8(&this.m_buffer, (u8)(((code_point >> 12) & 0x0f) | 0xe0))
        byte_buffer_append_u8(&this.m_buffer, (u8)(((code_point >> 6) & 0x3f) | 0x80))
        byte_buffer_append_u8(&this.m_buffer, (u8)(((code_point >> 0) & 0x3f) | 0x80))
    else:
        _ = string_builder_will_append(this, 4) catch: recover ()
        byte_buffer_append_u8(&this.m_buffer, (u8)(((code_point >> 18) & 0x07) | 0xf0))
        byte_buffer_append_u8(&this.m_buffer, (u8)(((code_point >> 12) & 0x3f) | 0x80))
        byte_buffer_append_u8(&this.m_buffer, (u8)(((code_point >> 6) & 0x3f) | 0x80))
        byte_buffer_append_u8(&this.m_buffer, (u8)(((code_point >> 0) & 0x3f) | 0x80))

