# mark: Results =================================================================================

## Ported from AK/StringBuilder.cpp:294 AK::StringBuilder::to_byte_string.
pub func string_builder_to_byte_string(this: const StringBuilder*) -> ByteString:
    assert(this.m_mode == StringBuilderMode.utf8)
    if string_builder_is_empty(this):
        return byte_string_empty()
    let view = string_builder_string_view(this)
    return byte_string_from_string_view(view)

## Ported from AK/StringBuilder.cpp:310 AK::StringBuilder::to_string_without_validation.
pub func string_builder_to_string_without_validation(this: StringBuilder*) -> String:
    assert(this.m_mode == StringBuilderMode.utf8)
    if byte_buffer_is_inline(&this.m_buffer):
        let view = string_builder_string_view(this)
        return string_from_utf8_without_validation(string_view_bytes(&view))
    return string_from_string_builder_without_validation(this)

## Ported from AK/StringBuilder.cpp:302 AK::StringBuilder::to_string: fails when the text is
## not valid UTF-8.
pub func string_builder_to_string(this: StringBuilder*) -> String!:
    assert(this.m_mode == StringBuilderMode.utf8)
    if byte_buffer_is_inline(&this.m_buffer):
        return try string_from_utf8(string_builder_string_view(this))
    return try string_from_string_builder(this)

## Ported from AK/StringBuilder.cpp:318 AK::StringBuilder::to_fly_string_without_validation.
pub func string_builder_to_fly_string_without_validation(this: const StringBuilder*) -> FlyString:
    assert(this.m_mode == StringBuilderMode.utf8)
    let view = string_builder_string_view(this)
    return fly_string_from_utf8_without_validation(string_view_bytes(&view))

## Ported from AK/StringBuilder.cpp:324 AK::StringBuilder::to_fly_string.
pub func string_builder_to_fly_string(this: const StringBuilder*) -> FlyString!:
    assert(this.m_mode == StringBuilderMode.utf8)
    return try fly_string_from_utf8(string_builder_string_view(this))

## Ported from AK/StringBuilder.cpp:330 AK::StringBuilder::to_utf16_string.
pub func string_builder_to_utf16_string(this: StringBuilder*) -> Utf16String:
    assert(this.m_mode == StringBuilderMode.utf16)
    return utf16_string_from_string_builder(this)

## Ported from AK/StringBuilder.cpp:289 AK::StringBuilder::to_byte_buffer.
pub func string_builder_to_byte_buffer(this: const StringBuilder*) -> ByteBuffer!:
    let data = string_builder_data_const(this) else return try byte_buffer_copy_span_u8(b"")
    return try byte_buffer_copy_span_u8(u8[]((u8*)data, string_builder_length(this)))

## Ported from AK/StringBuilder.cpp:346 AK::StringBuilder::string_view.
pub func string_builder_string_view(this: const StringBuilder*) -> StringView:
    assert(this.m_mode == StringBuilderMode.utf8)
    return string_view_from_bytes(byte_buffer_span_const(&this.m_buffer)[string_builder_prefix_size(this.m_mode)..])

## Ported from AK/StringBuilder.cpp:352 AK::StringBuilder::utf16_string_view.
pub func string_builder_utf16_string_view(this: const StringBuilder*) -> Utf16View:
    assert(this.m_mode == StringBuilderMode.utf16)
    let view = byte_buffer_span_const(&this.m_buffer)[string_builder_prefix_size(this.m_mode)..]

    if this.m_utf16_builder_is_ascii:
        return utf16_view_from_ascii(view)
    return utf16_view_from_utf16(u16[]((u16*)view.data, view.length // 2))

## Ported from AK/StringBuilder.cpp:362 AK::StringBuilder::clear.
pub func string_builder_clear(this: StringBuilder*):
    byte_buffer_resize(&this.m_buffer, string_builder_prefix_size(this.m_mode))

## Ported from AK/StringBuilder.cpp:108 AK::StringBuilder::length: the bytes (UTF-8) or bytes of
## code units (UTF-16) appended.
pub func string_builder_length(this: const StringBuilder*) -> usize:
    return byte_buffer_size(&this.m_buffer) - string_builder_prefix_size(this.m_mode)

## Ported from AK/StringBuilder.cpp:113 AK::StringBuilder::is_empty.
pub func string_builder_is_empty(this: const StringBuilder*) -> bool:
    return string_builder_length(this) == 0

## Ported from AK/StringBuilder.cpp:118 AK::StringBuilder::trim: drops `count` code units from the end.
pub func string_builder_trim(this: StringBuilder*, count: usize):
    var units = count
    if this.m_mode == StringBuilderMode.utf16:
        units *= 2

    let size = byte_buffer_size(&this.m_buffer)
    let decrease_count = size if size < units else units
    byte_buffer_resize(&this.m_buffer, size - decrease_count)

# mark: Joining =================================================================================

## Ported from AK/StringBuilder.h:100 AK::StringBuilder::join over StringViews with the default
## "{}" format.
pub func string_builder_join_string_view(this: StringBuilder*, separator: StringView, collection: const StringView[]):
    string_builder_try_join_string_view(this, separator, collection) else trap("MUST: StringBuilder::join")

## Ported from AK/StringBuilder.h:106 AK::StringBuilder::try_join over StringViews with the
## default "{}" format.
pub func string_builder_try_join_string_view(this: StringBuilder*, separator: StringView, collection: const StringView[]) -> !:
    var first = true
    for item in collection:
        if not first:
            try string_builder_try_append_string_view(this, separator)
        try string_builder_try_append_string_view(this, item)
        first = false

## Ported from AK/StringBuilder.h:100 AK::StringBuilder::join over Strings with the default "{}"
## format.
pub func string_builder_join_string(this: StringBuilder*, separator: StringView, collection: const String[]):
    string_builder_try_join_string(this, separator, collection) else trap("MUST: StringBuilder::join")

## Ported from AK/StringBuilder.h:106 AK::StringBuilder::try_join over Strings with the default
## "{}" format.
pub func string_builder_try_join_string(this: StringBuilder*, separator: StringView, collection: const String[]) -> !:
    var first = true
    for item in &collection:
        if not first:
            try string_builder_try_append_string_view(this, separator)
        try string_builder_try_append_string_view(this, string_bytes_as_string_view(item))
        first = false

## Ported from AK/StringBuilder.h:100 AK::StringBuilder::join over FlyStrings with the default
## "{}" format.
pub func string_builder_join_fly_string(this: StringBuilder*, separator: StringView, collection: const FlyString[]):
    var first = true
    for item in &collection:
        if not first:
            string_builder_append_string_view(this, separator)
        string_builder_append_string_view(this, fly_string_bytes_as_string_view(item))
        first = false

## Ported from AK/StringBuilder.h:100 AK::StringBuilder::join over Utf16Views with the default "{}"
## format (Formatter<Utf16View> appends the view).
pub func string_builder_join_utf16_view(this: StringBuilder*, separator: Utf16View, collection: const Utf16View[]):
    var first = true
    for item in collection:
        if not first:
            string_builder_append_utf16_view(this, separator)
        string_builder_append_utf16_view(this, item)
        first = false

# mark: Buffer management =======================================================================

## Ported from AK/StringBuilder.h:118 AK::StringBuilder::leak_buffer_for_string_construction(Badge<StringData>).
pub func string_builder_leak_buffer_for_string_construction_string_data(this: StringBuilder*) -> ByteBufferOutlineBuffer?:
    return string_builder_leak_buffer_for_string_construction(this)

## Ported from AK/StringBuilder.h:119 AK::StringBuilder::leak_buffer_for_string_construction(Badge<Utf16StringData>).
pub func string_builder_leak_buffer_for_string_construction_utf16_string_data(this: StringBuilder*) -> ByteBufferOutlineBuffer?:
    return string_builder_leak_buffer_for_string_construction(this)

## Ported from AK/StringBuilder.cpp:37 AK::StringBuilder::initialize_buffer.
func string_builder_initialize_buffer(this: StringBuilder*, mode: StringBuilderMode, capacity: usize):
    let prefix_size = string_builder_prefix_size(mode)
    if capacity > string_builder_inline_capacity:
        byte_buffer_ensure_capacity(&this.m_buffer, prefix_size + capacity)
    byte_buffer_resize(&this.m_buffer, prefix_size)

## Ported from AK/StringBuilder.cpp:559 AK::StringBuilder::leak_buffer_for_string_construction:
## the heap buffer (the ByteBuffer's OutlineBuffer), leaving the builder empty, or none while the
## buffer is inline. String creation copies instead (string_data), so nothing calls it yet.
func string_builder_leak_buffer_for_string_construction(this: StringBuilder*) -> ByteBufferOutlineBuffer?:
    if let buffer = byte_buffer_leak_outline_buffer(&this.m_buffer):
        string_builder_clear(this)
        return buffer

    return none

## Ported from AK/StringBuilder.cpp:70 AK::StringBuilder::will_append: makes room for
## `size_in_bytes` more bytes, doubling the needed capacity when it grows.
func string_builder_will_append(this: StringBuilder*, size_in_bytes: usize) -> !:
    let needed_capacity = byte_buffer_size(&this.m_buffer) +? size_in_bytes else trap("VERIFY: will_append overflow")
    # Prefer to completely use the existing capacity first
    if needed_capacity <= byte_buffer_capacity(&this.m_buffer):
        return
    let expanded_capacity = needed_capacity *? 2 else trap("VERIFY: will_append overflow")
    try byte_buffer_try_ensure_capacity(&this.m_buffer, expanded_capacity)

## Ported from AK/StringBuilder.cpp:85 AK::StringBuilder::ensure_storage_is_utf16: widens the
## ASCII bytes written so far to code units.
func string_builder_ensure_storage_is_utf16(this: StringBuilder*) -> !:
    let was_ascii = this.m_utf16_builder_is_ascii
    this.m_utf16_builder_is_ascii = false
    if not was_ascii:
        return
    if string_builder_is_empty(this):
        return

    let ascii_length = string_builder_length(this)
    try byte_buffer_try_resize(&this.m_buffer, byte_buffer_size(&this.m_buffer) + ascii_length)

    let data = string_builder_data(this) else trap("VERIFY: builder data")
    let source = u8[](data, ascii_length)
    let target = u8[](data, ascii_length * 2)

    var i = ascii_length
    while i > 0:
        let index = i - 1

        let ch = source[index]
        target[index * 2] = ch
        target[index * 2 + 1] = 0
        i -= 1

## Ported from AK/StringBuilder.cpp:336 AK::StringBuilder::data.
func string_builder_data(this: StringBuilder*) -> u8*?:
    let data = byte_buffer_data(&this.m_buffer) else return none
    return data + string_builder_prefix_size(this.m_mode)

## Ported from AK/StringBuilder.cpp:341 AK::StringBuilder::data (const).
func string_builder_data_const(this: const StringBuilder*) -> const u8*?:
    let data = byte_buffer_data_const(&this.m_buffer) else return none
    return data + string_builder_prefix_size(this.m_mode)
