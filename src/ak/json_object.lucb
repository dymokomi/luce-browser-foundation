#==============================================================================================
#
#   json_object - JsonObject: an insertion-ordered map from strings to JSON values
#
#   DESCRIPTION:
#       Port of AK/JsonObject.cpp (lines 1-297) with the inline members of AK/JsonObject.h
#       (lines 1-119).
#
#       The members are an OrderedHashMap<String, JsonValue>. C++ looks a StringView key up
#       directly (a HashCompatible lookup); here the key is made a String first, which finds
#       the same member. Iteration in insertion order goes over keys(). The copy constructor
#       copies each value deeply (json_object_clone), and for_each_member takes a function with
#       a context pointer (DESIGN.md §2.7).
#
#==============================================================================================

# mark: Construction and copies =================================================================

## Ported from AK/JsonObject.cpp:15 AK::JsonObject::JsonObject: no members.
pub func json_object_construct(this: JsonObject*):
    var members: OrderedHashMap[String, JsonValue2, StringTraits]
    this.m_members = members

## AK::JsonObject::JsonObject(JsonObject const&) (AK/JsonObject.cpp:18): a copy whose values are
## copies, in the same order.
pub func json_object_clone(this: const JsonObject*) -> JsonObject:
    var copy: JsonObject
    json_object_construct(&copy)
    let keys = ordered_hash_map_keys(&this.m_members)
    for i in 0..<vector_size(&keys):
        let key = *vector_at_const(&keys, i)
        let value = ordered_hash_map_get_k_const(&this.m_members, key) else trap("VERIFY_NOT_REACHED")
        _ = ordered_hash_map_set(&copy.m_members, key, json_value2_clone(value))
    return copy

## The String for a StringView key (the C++ lookups take the StringView itself).
func json_object_key(key: StringView) -> String:
    return string_from_utf8(key) else trap("MUST: String::from_utf8")

## Ported from AK/JsonObject.cpp:42 AK::JsonObject::size.
pub func json_object_size(this: const JsonObject*) -> usize:
    return ordered_hash_map_size(&this.m_members)

## Ported from AK/JsonObject.cpp:47 AK::JsonObject::is_empty.
pub func json_object_is_empty(this: const JsonObject*) -> bool:
    return ordered_hash_map_is_empty(&this.m_members)

# mark: Lookups =================================================================================

## Ported from AK/JsonObject.cpp:52 AK::JsonObject::get.
pub func json_object_get(this: JsonObject*, key: StringView) -> JsonValue2*?:
    return ordered_hash_map_get_k(&this.m_members, json_object_key(key))

## Ported from AK/JsonObject.cpp:60 AK::JsonObject::get.
pub func json_object_get_const(this: const JsonObject*, key: StringView) -> const JsonValue2*?:
    return ordered_hash_map_get_k_const(&this.m_members, json_object_key(key))

## Ported from AK/JsonObject.cpp:68 AK::JsonObject::get_i8.
pub func json_object_get_i8(this: const JsonObject*, key: StringView) -> i8?:
    if let value = json_object_get_const(this, key):
        return json_value2_get_integer_i8(value)
    return none

