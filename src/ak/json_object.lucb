# mark: Changes, iteration and serialization ====================================================

## Ported from AK/JsonObject.cpp:265 AK::JsonObject::set(String, JsonValue).
pub func json_object_set_string(this: JsonObject*, key: String, value: JsonValue2):
    _ = ordered_hash_map_set(&this.m_members, key, value)

## Ported from AK/JsonObject.cpp:270 AK::JsonObject::set(StringView, JsonValue).
pub func json_object_set_string_view(this: JsonObject*, key: StringView, value: JsonValue2):
    json_object_set_string(this, string_from_utf8(key) else trap("MUST: String::from_utf8"), value)

## Ported from AK/JsonObject.h:92 AK::JsonObject::for_each_member: calls
## `callback(context, key, value)` for each member, in insertion order.
pub func json_object_for_each_member(this: const JsonObject*, callback: func(void*?, const String*, const JsonValue2*) -> unit, context: void*?):
    let keys = ordered_hash_map_keys(&this.m_members)
    for i in 0..<vector_size(&keys):
        let key = vector_at_const(&keys, i)
        let value = ordered_hash_map_get_k_const(&this.m_members, *key) else trap("VERIFY_NOT_REACHED")
        callback(context, key, value)

## Ported from AK/JsonObject.h:99 AK::JsonObject::try_for_each_member: stops at the first failure.
pub func json_object_try_for_each_member(this: const JsonObject*, callback: func(void*?, const String*, const JsonValue2*) -> unit!, context: void*?) -> !:
    let keys = ordered_hash_map_keys(&this.m_members)
    for i in 0..<vector_size(&keys):
        let key = vector_at_const(&keys, i)
        let value = ordered_hash_map_get_k_const(&this.m_members, *key) else trap("VERIFY_NOT_REACHED")
        try callback(context, key, value)

## Ported from AK/JsonObject.cpp:275 AK::JsonObject::remove.
pub func json_object_remove(this: JsonObject*, key: StringView) -> bool:
    return ordered_hash_map_remove_k(&this.m_members, json_object_key(key))

## Ported from AK/JsonObject.cpp:280 AK::JsonObject::serialized.
pub func json_object_serialized(this: const JsonObject*) -> String:
    var builder: StringBuilder
    string_builder_construct(&builder)
    json_object_serialize(this, &builder)

    return string_builder_to_string(&builder) else trap("MUST: StringBuilder::to_string")

## Ported from AK/JsonObject.cpp:288 AK::JsonObject::serialize.
pub func json_object_serialize(this: const JsonObject*, builder: StringBuilder*):
    var serializer = json_object_serializer_try_create(builder) else trap("MUST: JsonObjectSerializer::try_create")
    let keys = ordered_hash_map_keys(&this.m_members)
    for i in 0..<vector_size(&keys):
        let key = vector_at_const(&keys, i)
        let value = ordered_hash_map_get_k_const(&this.m_members, *key) else trap("VERIFY_NOT_REACHED")
        json_object_serializer_add_json_value2(&serializer, string_bytes_as_string_view(key), value) else trap("MUST: JsonObjectSerializer::add")
    json_object_serializer_finish(&serializer) else trap("MUST: JsonObjectSerializer::finish")
