#==============================================================================================
#
#   ordered_hash_map - OrderedHashMap<K, V>: the IsOrdered = true instantiation of HashMap
#
#   DESCRIPTION:
#       AK/HashMap.h with IsOrdered = true. OrderedHashMap[K, V, KT] has the layout of
#       HashMap[K, V, KT] around an ordered table: each member sets the table's `m_ordered`
#       flag (mutating members only; a zero OrderedHashMap is an empty ordered map) and runs
#       the HashMap member of the same name, so iteration follows insertion order.
#
#==============================================================================================

## AK::OrderedHashMap::HashMap(std::initializer_list<Entry>) (IsOrdered = true).
pub func ordered_hash_map_construct[K, V, KT: Traits[K]](this: OrderedHashMap[K, V, KT]*, list: const HashMapEntry[K, V][]):
    this.m_table.m_table.m_ordered = true
    hash_map_construct[K, V, KT]((HashMap[K, V, KT]*)this, list)

## AK::OrderedHashMap::clone: an ordered map with its own table holding the same entries in
## the same order (IsOrdered = true).
pub func ordered_hash_map_clone[K, V, KT: Traits[K]](this: const OrderedHashMap[K, V, KT]*) -> OrderedHashMap[K, V, KT]!:
    var clone_: OrderedHashMap[K, V, KT]
    clone_.m_table.m_table.m_ordered = true
    try ordered_hash_map_try_ensure_capacity(&clone_, ordered_hash_map_size(this))
    for entry in ordered_hash_map_begin_const(this):
        discard(ordered_hash_map_set(&clone_, entry.key, entry.value))
    return clone_

## AK::OrderedHashMap::is_empty (IsOrdered = true).
pub func ordered_hash_map_is_empty[K, V, KT: Traits[K]](this: const OrderedHashMap[K, V, KT]*) -> bool:
    return hash_map_is_empty[K, V, KT]((const HashMap[K, V, KT]*)this)

## AK::OrderedHashMap::size (IsOrdered = true).
pub func ordered_hash_map_size[K, V, KT: Traits[K]](this: const OrderedHashMap[K, V, KT]*) -> usize:
    return hash_map_size[K, V, KT]((const HashMap[K, V, KT]*)this)

## AK::OrderedHashMap::capacity (IsOrdered = true).
pub func ordered_hash_map_capacity[K, V, KT: Traits[K]](this: const OrderedHashMap[K, V, KT]*) -> usize:
    return hash_map_capacity[K, V, KT]((const HashMap[K, V, KT]*)this)

## AK::OrderedHashMap::clear (IsOrdered = true).
pub func ordered_hash_map_clear[K, V, KT: Traits[K]](this: OrderedHashMap[K, V, KT]*):
    this.m_table.m_table.m_ordered = true
    hash_map_clear[K, V, KT]((HashMap[K, V, KT]*)this)

