## Ported from AK/Time.cpp:197 AK::Duration::to_nanoseconds.
pub func duration_to_nanoseconds(this: const Duration*) -> i64:
    assert(this.m_nanoseconds < 1000000000)
    var nanoseconds = make_checked[i64]((this.m_seconds + 1) if this.m_seconds < 0 else this.m_seconds)
    _ = checked_mul_assign_t_i64(&nanoseconds, 1000000000)
    _ = checked_add_assign_t_i64(&nanoseconds, (i64)this.m_nanoseconds)
    if this.m_seconds < 0:
        # We dropped one second previously, put it back in now that we have handled the rounding.
        _ = checked_sub_assign_t_i64(&nanoseconds, 1000000000)
    if not checked_has_overflow(&nanoseconds):
        return checked_value(&nanoseconds)
    return i64_min if this.m_seconds < 0 else i64_max

## Ported from AK/Time.cpp:212 AK::Duration::to_timespec.
pub func duration_to_timespec(this: const Duration*) -> Timespec:
    assert(this.m_nanoseconds < 1000000000)
    return Timespec(tv_sec = this.m_seconds, tv_nsec = (i64)this.m_nanoseconds)

## Ported from AK/Time.cpp:218 AK::Duration::to_timeval.
# Rounds towards -inf (it was the easiest to implement).
pub func duration_to_timeval(this: const Duration*) -> Timeval:
    assert(this.m_nanoseconds < 1000000000)
    return Timeval(tv_sec = this.m_seconds, tv_usec = (i64)this.m_nanoseconds // 1000)

## Ported from AK/Time.cpp:227 AK::Duration::to_time_units.
pub func duration_to_time_units(this: const Duration*, numerator: u32, denominator: u32) -> i64:
    assert(numerator != 0)
    assert(denominator != 0)

    let seconds_product = saturating_mul_i64(this.m_seconds, (i64)denominator)
    var time_units = seconds_product // (i64)numerator
    let seconds_remainder_dividend = seconds_product % (i64)numerator

    let seconds_remainder_nanosecond_dividend = seconds_remainder_dividend * 1000000000
    let rounding_half_nanosecond_dividend = (i64)numerator * 500000000
    let sub_seconds_nanosecond_dividend = ((i64)this.m_nanoseconds * (i64)denominator) + seconds_remainder_nanosecond_dividend

    let sub_seconds_nanosecond_units = sub_seconds_nanosecond_dividend // (i64)numerator
    let sub_seconds_units_remainder_nanosecond_dividend = sub_seconds_nanosecond_dividend % (i64)numerator
    let rounding_adjustment_nanosecond_units = (rounding_half_nanosecond_dividend + sub_seconds_units_remainder_nanosecond_dividend) // (i64)numerator

    time_units = saturating_add_i64(time_units, (sub_seconds_nanosecond_units + rounding_adjustment_nanosecond_units) // 1000000000)

    return time_units

## Ported from AK/Time.h:270 AK::Duration::is_zero.
pub func duration_is_zero(this: const Duration*) -> bool:
    return this.m_seconds == 0 and this.m_nanoseconds == 0

## Ported from AK/Time.h:271 AK::Duration::is_negative.
pub func duration_is_negative(this: const Duration*) -> bool:
    return this.m_seconds < 0

## Ported from AK/Time.h:273 AK::Duration::operator+.
pub func duration_add(this: const Duration*, other: Duration) -> Duration:
    assert(this.m_nanoseconds < 1000000000)
    assert(other.m_nanoseconds < 1000000000)

    var new_nsecs: u32 = this.m_nanoseconds + other.m_nanoseconds
    let extra_secs: u32 = new_nsecs // 1000000000
    new_nsecs = new_nsecs % 1000000000

    var this_secs = this.m_seconds
    var other_secs = other.m_seconds
    # We would like to just add "this_secs + other_secs + extra_secs".
    # However, computing this naively may overflow even though the result is in-bounds.
    # Example in 8-bit: (-127) + (-2) + (+1) = (-128), which fits in an i8.
    # Example in 8-bit, the other way around: (-2) + (127) + (+1) = 126.
    # So we do something more sophisticated:
    if extra_secs != 0:
        assert(extra_secs == 1)
        if this_secs != 0x7fffffffffffffff:
            this_secs += 1
        elif other_secs != 0x7fffffffffffffff:
            other_secs += 1
        else:
            # If *both* are INT64_MAX, then adding them will overflow in any case.
            return duration_max()

    var new_secs = make_checked[i64](this_secs)
    _ = checked_add_assign_t_i64(&new_secs, other_secs)
    if checked_has_overflow(&new_secs):
        if other_secs > 0:
            return duration_max()
        else:
            return duration_min()

    return make_duration(checked_value(&new_secs), new_nsecs)

## Ported from AK/Time.h:313 AK::Duration::operator+=.
pub func duration_add_assign(this: Duration*, other: Duration) -> Duration*:
    *this = duration_add(this, other)
    return this

## Ported from AK/Time.h:319 AK::Duration::operator-.
pub func duration_sub(this: const Duration*, other: Duration) -> Duration:
    assert(this.m_nanoseconds < 1000000000)
    assert(other.m_nanoseconds < 1000000000)

    if other.m_nanoseconds != 0:
        return duration_add(this, make_duration((i64)~(u64)other.m_seconds, 1000000000 - other.m_nanoseconds))

    if other.m_seconds != i64_min:
        return duration_add(this, make_duration(-other.m_seconds, 0))

    # Only remaining case: We want to subtract -0x8000'0000'0000'0000 seconds,
    # i.e. add a very large number.

    if this.m_seconds >= 0:
        return duration_max()
    return make_duration((this.m_seconds + 0x4000000000000000) + 0x4000000000000000, this.m_nanoseconds)

## Ported from AK/Time.h:338 AK::Duration::operator-=.
pub func duration_sub_assign(this: Duration*, other: Duration) -> Duration*:
    *this = duration_sub(this, other)
    return this

## Ported from AK/Time.h:345 AK::Duration::operator<=>.
pub func duration_cmp(this: const Duration*, other: Duration) -> i32:
    let seconds_cmp: i32 = 1 if this.m_seconds > other.m_seconds else (-1 if this.m_seconds < other.m_seconds else 0)
    if seconds_cmp != 0:
        return seconds_cmp
    let nanoseconds_cmp: i32 = 1 if this.m_nanoseconds > other.m_nanoseconds else (-1 if this.m_nanoseconds < other.m_nanoseconds else 0)
    if nanoseconds_cmp != 0:
        return nanoseconds_cmp
    return 0

## Ported from AK/Time.h:361 AK::Duration::Duration.
pub func duration_construct(this: Duration*, seconds: i64, nanoseconds: u32):
    this.m_seconds = seconds
    this.m_nanoseconds = nanoseconds

## Ported from AK/Time.cpp:249 AK::Duration::from_half_sanitized.
pub func duration_from_half_sanitized(seconds: i64, extra_seconds: i32, nanoseconds: u32) -> Duration:
    assert(nanoseconds < 1000000000)

    var secs = seconds
    var extra: i64 = extra_seconds
    if (secs <= 0 and extra > 0) or (secs >= 0 and extra < 0):
        # Opposite signs mean that we can definitely add them together without fear of overflowing i64:
        secs += extra
        extra = 0

    # Now the only possible way to become invalid is overflowing i64 towards positive infinity:
    if checked_addition_would_overflow_i64(secs, extra):
        if secs < 0:
            return duration_min()
        else:
            return duration_max()

    return make_duration(secs + extra, nanoseconds)
