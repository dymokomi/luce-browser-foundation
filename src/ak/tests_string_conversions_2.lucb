#==============================================================================================
#
#   tests_string_conversions_2 - parse_first_number and parse_number edge cases
#
#   DESCRIPTION:
#       Port of Tests/AK/TestStringConversions.cpp: the special values of simple_cases,
#       partial_parse_stops_at_right_spot, invalid_parse, detect_out_of_range_values and
#       parse_completely_must_be_just_floating_point. Every check runs over a StringView and
#       over UTF-16 storage (the C++'s u"..."sv).
#
#==============================================================================================

## `parse_number<double>` of `text` over a StringView and over UTF-16 storage; both must agree.
func test_parse_complete_double(text: str) -> f64?:
    with memory.heap:
        let from_bytes = parse_number_string_view_f64(sv(text), TrimWhitespace.no)
        let utf16 = utf16_string_from_utf8_without_validation(sv(text))
        var view = utf16_string_base_utf16_view(&utf16.utf16_string_base)
        let storage = new u16[text.length + 1] else trap("out of memory")
        if utf16_view_has_ascii_storage(&view):
            view = test_conversions_utf16(text, storage)
        let from_code_units = parse_number_utf16_view_f64(view, TrimWhitespace.no)
        if from_bytes == none:
            assert(from_code_units == none)
            return none
        let value = from_bytes else trap("unreachable")
        let other = from_code_units else trap("parse over UTF-16 failed")
        assert(value.bits() == other.bits())
        return value

## `parse_number<float>` of `text`, both ways.
func test_parse_complete_float(text: str) -> f32?:
    with memory.heap:
        let from_bytes = parse_number_string_view_f32(sv(text), TrimWhitespace.no)
        let storage = new u16[text.length + 1] else trap("out of memory")
        let from_code_units = parse_number_utf16_view_f32(test_conversions_utf16(text, storage), TrimWhitespace.no)
        if from_bytes == none:
            assert(from_code_units == none)
            return none
        let value = from_bytes else trap("unreachable")
        assert(value.bits() == (from_code_units else trap("parse over UTF-16 failed")).bits())
        return value

## `parse_first_number<double>` of `text`, both ways: the value's bits and the characters taken.
func test_parse_first_double(text: str) -> (u64, usize)?:
    with memory.heap:
        let storage = new u16[text.length + 1] else trap("out of memory")
        let from_code_units = parse_first_number_utf16_view_f64(test_conversions_utf16(text, storage))
        let maybe_from_bytes = parse_first_number_string_view_f64(sv(text))
        if maybe_from_bytes == none:
            assert(from_code_units == none)
            return none
        let from_bytes = maybe_from_bytes else trap("unreachable")
        let other = from_code_units else trap("parse over UTF-16 failed")
        assert(from_bytes.value.bits() == other.value.bits())
        assert(from_bytes.characters_parsed == other.characters_parsed)
        return (from_bytes.value.bits(), from_bytes.characters_parsed)

test "StringConversions: simple_cases (special values)":
    let negative_zero: u64 = 0x8000000000000000
    assert((test_parse_complete_double("0") else trap("0")).bits() == 0)
    assert((test_parse_complete_double("-0") else trap("-0")).bits() == negative_zero)
    assert((test_parse_complete_double("-0.") else trap("-0.")).bits() == negative_zero)
    assert((test_parse_complete_double("-0.0") else trap("-0.0")).bits() == negative_zero)

    assert((test_parse_complete_double("67677557565221539913") else trap("big")) == 67677557565221539913.0)

    assert((test_parse_complete_double("2.-324") else trap("zero")) == 0.0)
    assert((test_parse_complete_double("2.-324") else trap("zero")) == 0.0)

    # EXPECT_TO_PARSE_TO_VALUE_EQUAL_TO
    assert((test_parse_complete_double("1e-324") else trap("v")).bits() == 0)
    assert((test_parse_complete_double("-1e-324") else trap("v")).bits() == negative_zero)
    assert((test_parse_complete_double("+.09289376810193062") else trap("v")) == 0.09289376810193062)
    assert((test_parse_complete_double("-.09289376810193062") else trap("v")) == -0.09289376810193062)
    assert((test_parse_complete_double("+.0e10") else trap("v")).bits() == 0)
    assert((test_parse_complete_double("-.0e10") else trap("v")).bits() == negative_zero)

## EXPECT_TO_PARSE_TO_INFINITY: `text`, "+" `text` and "-" `text` overflow to ±infinity.
func test_parse_to_infinity(text: str):
    with memory.heap:
        let positive = new u8[text.length + 1] else trap("out of memory")
        let negative = new u8[text.length + 1] else trap("out of memory")
        positive[0] = '+'
        negative[0] = '-'
        copy_bytes(positive[1..], text.bytes)
        copy_bytes(negative[1..], text.bytes)
        let infinity: u64 = 0x7ff0000000000000
        let infinity_bits_f32: u32 = 0x7f800000
        assert((test_parse_complete_double(text) else trap("inf")).bits() == infinity)
        assert((test_parse_complete_double((str)positive) else trap("inf")).bits() == infinity)
        assert((test_parse_complete_double((str)negative) else trap("inf")).bits() == infinity | 0x8000000000000000)
        assert((test_parse_complete_float(text) else trap("inf")).bits() == infinity_bits_f32)
        assert((test_parse_complete_float((str)positive) else trap("inf")).bits() == infinity_bits_f32)
        assert((test_parse_complete_float((str)negative) else trap("inf")).bits() == infinity_bits_f32 | 0x80000000)

test "StringConversions: simple_cases (infinities)":
    test_parse_to_infinity("123.456e789")
    test_parse_to_infinity("123456.456789e789")
    test_parse_to_infinity(".738475042362596875449154552392299548947138162081694168675340677843807613129780449323363759027012972466987370921816813162658754726545121090545507240267000456594786540949605260722461937870630634874991729398208026467698131898691830012167897399682179601734569071423681e-733")
    test_parse_to_infinity("3e182947912346759234")
    test_parse_to_infinity("3e70000000000000")
    test_parse_to_infinity("3e70000000000")
    test_parse_to_infinity("3e70000000")
    test_parse_to_infinity("1e681")
    test_parse_to_infinity("7e312")
    test_parse_to_infinity("184467440737095516151234567890e2147483639")

## EXPECT_PARSE_TO_VALUE_AND_CONSUME_CHARS
func test_parse_first_consumes(text: str, bits: u64, characters: usize):
    let (value_bits, parsed) = test_parse_first_double(text) else trap("parse_first_number failed")
    assert(value_bits == bits)
    assert(parsed == characters)

test "StringConversions: partial_parse_stops_at_right_spot":
    test_parse_first_consumes("0x", 0, 1)
    test_parse_first_consumes("0e", 0, 1)
    test_parse_first_consumes("0e+", 0, 1)
    test_parse_first_consumes("0e1", 0, 3)
    test_parse_first_consumes("0beef", 0, 1)
    test_parse_first_consumes("0p123", 0, 1)
    test_parse_first_consumes("0e1", 0, 3)
    test_parse_first_consumes("0e1abc", 0, 3)
    test_parse_first_consumes("0e1e1", 0, 3)
    test_parse_first_consumes("0e1+", 0, 3)
    test_parse_first_consumes("0e-+1", 0, 1)

test "StringConversions: invalid_parse":
    let failures: str[17] = ["", "e", ".", "-.", "+.", ".e", "-.e", "+.e", ".e1", "-.e1", "+.e1", "++2", "++1", "++0", "++2e1", "++1e1", "++0e1"]
    for text in failures:
        assert(test_parse_first_double(text) == none)
    let bases: str[7] = ["1", "1.", "1e1", "1.e1", "1.0e1", "1.0e+1", "1.0e-1"]
    let signs: str[4] = ["++", "--", "+-", "-+"]
    var buffer: u8[16]
    for base_text in bases:
        for sign_text in signs:
            let text = format(buffer, f"{sign_text}{base_text}") else trap("format")
            assert(test_parse_first_double(text) == none)

test "StringConversions: detect_out_of_range_values":
    let (small, _small_length) = test_parse_first_double("10e-10000") else trap("small")
    assert(small == 0)
    let (negative_small, _negative_small_length) = test_parse_first_double("-10e-10000") else trap("small")
    assert(negative_small == 0x8000000000000000)
    let (large, _large_length) = test_parse_first_double("10e10000") else trap("large")
    assert(large == 0x7ff0000000000000)
    let (negative_large, _negative_large_length) = test_parse_first_double("-10e10000") else trap("large")
    assert(negative_large == 0xfff0000000000000)

test "StringConversions: parse_completely_must_be_just_floating_point":
    let failures: str[39] = [
        "", "-", "+", "++1", "+-1", "-+1", "--1",
        "1 ", "1. ", "1e ", "1.e ", "1.e123 ",
        "-1 ", "-1. ", "-1e ", "-1.e ", "-1.e123 ",
        "1A", "1.C", "1e*", "1.e(", "1.e123]", "1.e123&", "1.e123               ",
        ":1234567890", "1:234567890", "12:34567890", "123:4567890", "1234:567890", "12345:67890",
        "123456:7890", "1234567:890", "12345678:90", "123456789:0", "1234567890:",
        "1;234567890", "1234567;890", "1=234567890", "1234567=890",
    ]
    for text in failures:
        assert(test_parse_complete_double(text) == none)
