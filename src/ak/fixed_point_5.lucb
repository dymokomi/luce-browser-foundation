#==============================================================================================
#
#   fixed_point_5 - FixedPoint: casts between instantiations
#
#   DESCRIPTION:
#       Port of AK/FixedPoint.h (lines 52-57, 441-462: the converting constructor, the
#       conversion operator and cast_to) for every pair of the instantiated underlying
#       types; see fixed_point_1.
#
#==============================================================================================

# mark: Casts between instantiations ============================================================

## Ported from AK/FixedPoint.h:52 AK::FixedPoint::FixedPoint(FixedPoint<P, U>) and
## AK/FixedPoint.h:452 cast_to, from FixedPoint<PS, i32> to FixedPoint<PD, i32>.
pub func fixed_point_cast_to_i32_from_i32[PS: FixedPointPrecision, PD: FixedPointPrecision](this: const FixedPoint[i32, PS]*) -> FixedPoint[i32, PD]:
    let precision = fixed_point_precision[PS]()
    let other_precision = fixed_point_precision[PD]()
    var raw_value = (i32)(this.m_value >> (i32)precision) << (i32)other_precision
    let fraction = this.m_value & fixed_point_radix_mask_i32(precision)
    if precision > other_precision:
        raw_value = raw_value | (i32)(fraction >> (i32)(precision - other_precision))
    elif precision < other_precision:
        raw_value = raw_value | ((i32)fraction << (i32)(other_precision - precision))
    else:
        raw_value = raw_value | (i32)fraction

    return FixedPoint[i32, PD](m_value = raw_value)

