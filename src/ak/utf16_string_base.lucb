# mark: Comparison ==============================================================================

## Ported from AK/Utf16StringBase.h:131 AK::Detail::Utf16StringBase::operator==(Utf16StringBase const&).
pub func utf16_string_base_eq_utf16_string_base(this: const Utf16StringBase*, other: const Utf16StringBase*) -> bool:
    if utf16_string_base_has_short_ascii_storage(this) and utf16_string_base_has_short_ascii_storage(other):
        return utf16_string_base_raw(this) == utf16_string_base_raw(other)

    if utf16_string_base_has_long_storage(this) and utf16_string_base_has_long_storage(other):
        let this_data = utf16_string_base_data_without_union_member_assertion(this) else trap("unreachable: long storage has data")
        let other_data = utf16_string_base_data_without_union_member_assertion(other) else trap("unreachable: long storage has data")

        return utf16_string_data_eq_utf16_string_data(this_data, other_data)

    let view = utf16_string_base_utf16_view(this)
    let other_view = utf16_string_base_utf16_view(other)
    return utf16_view_eq_utf16_view(&view, &other_view)

## Ported from AK/Utf16StringBase.h:149 AK::Detail::Utf16StringBase::operator==(Utf16View const&).
pub func utf16_string_base_eq_utf16_view(this: const Utf16StringBase*, other: const Utf16View*) -> bool:
    let view = utf16_string_base_utf16_view(this)
    return utf16_view_eq_utf16_view(&view, other)

## Ported from AK/Utf16StringBase.h:150 AK::Detail::Utf16StringBase::operator==(StringView).
