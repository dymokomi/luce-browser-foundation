#==============================================================================================
#
#   utf16_string_base - Utf16StringBase: the eight bytes shared by Utf16String and Utf16FlyString
#
#   DESCRIPTION:
#       Port of AK/Utf16StringBase.h (lines 1-365).
#
#       A Utf16StringBase is a union of a short ASCII string (up to seven bytes inline, flagged
#       like StringBase's) and a pointer to a Utf16StringData. Copies are plain copies (no
#       reference count). The pointer member is read through the union's bits (`raw`).
#
#       As for StringBase (string_base), eight zero bytes are the empty string: a zeroed
#       Utf16StringBase, as a cell or blob is allocated, has short ASCII storage and is
#       `Utf16StringBase {}`. The C++ null pointer (the sentinel of `Optional<Utf16String>` and
#       `Optional<Utf16FlyString>`) has no counterpart: those are Luce optionals.
#
#==============================================================================================

# mark: Construction ============================================================================

## Ported from AK/Utf16StringBase.h:20 AK::Detail::Utf16StringBase::Utf16StringBase(): empty.
pub func utf16_string_base_construct(this: Utf16StringBase*):
    utf16_string_base_construct_short_string(this, short_string_create_empty())

## Ported from AK/Utf16StringBase.h:25 AK::Detail::Utf16StringBase::Utf16StringBase(ShortString).
pub func utf16_string_base_construct_short_string(this: Utf16StringBase*, short_string: ShortString):
    this.m_value.short_ascii_string = short_string

## Ported from AK/Utf16StringBase.h:30 AK::Detail::Utf16StringBase::Utf16StringBase(NonnullRefPtr<Utf16StringData const>).
pub func utf16_string_base_construct_utf16_string_data(this: Utf16StringBase*, value: const Utf16StringData*):
    this.m_value.data = value

## `Utf16StringBase {}`: the empty string.
pub func utf16_string_base_new() -> Utf16StringBase:
    var base: Utf16StringBase
    utf16_string_base_construct(&base)
    return base

# mark: Views and conversions ===================================================================

## Ported from AK/Utf16StringBase.h:57 AK::Detail::Utf16StringBase::operator Utf16View.
pub func utf16_string_base_to_utf16_view(this: const Utf16StringBase*) -> Utf16View:
    return utf16_string_base_utf16_view(this)

## Ported from AK/Utf16StringBase.h:60 AK::Detail::Utf16StringBase::to_utf8.
pub func utf16_string_base_to_utf8(this: const Utf16StringBase*, allow_lonely_surrogates: AllowLonelySurrogates = AllowLonelySurrogates.yes) -> String:
    let view = utf16_string_base_utf16_view(this)
