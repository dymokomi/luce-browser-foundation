# mark: Storage =================================================================================

## Ported from AK/Utf16StringBase.h:274 AK::Detail::Utf16StringBase::has_short_ascii_storage.
## This is primarily interesting to unit tests.
pub func utf16_string_base_has_short_ascii_storage(this: const Utf16StringBase*) -> bool:
    if (utf16_string_base_short_ascii_string_without_union_member_assertion(this).byte_count_and_short_string_flag & (u8)string_base_short_string_flag) != 0:
        return true
    # Zeroed memory is the empty short string (see the header).
    return memory.read[usize](&this.m_value) == 0

## Ported from AK/Utf16StringBase.h:284 AK::Detail::Utf16StringBase::has_long_ascii_storage.
## This is primarily interesting to unit tests.
pub func utf16_string_base_has_long_ascii_storage(this: const Utf16StringBase*) -> bool:
    if utf16_string_base_has_short_ascii_storage(this):
        return false

    let data = utf16_string_base_data_without_union_member_assertion(this) else trap("unreachable: long storage has data")
    return utf16_string_data_has_ascii_storage(data)

## Ported from AK/Utf16StringBase.h:294 AK::Detail::Utf16StringBase::has_ascii_storage.
pub func utf16_string_base_has_ascii_storage(this: const Utf16StringBase*) -> bool:
    return utf16_string_base_has_short_ascii_storage(this) or utf16_string_base_has_long_ascii_storage(this)

## Ported from AK/Utf16StringBase.h:300 AK::Detail::Utf16StringBase::has_long_utf16_storage.
pub func utf16_string_base_has_long_utf16_storage(this: const Utf16StringBase*) -> bool:
    if utf16_string_base_has_short_ascii_storage(this):
        return false

