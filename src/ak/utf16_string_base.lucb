## Ported from AK/Utf16StringBase.h:75 AK::Detail::Utf16StringBase::ascii_view: the ASCII
## storage (inside this Utf16StringBase for a short string).
pub func utf16_string_base_ascii_view(this: const Utf16StringBase*) -> StringView:
    if utf16_string_base_has_short_ascii_storage(this):
        return string_view_from_bytes(short_string_bytes(&this.m_value.short_ascii_string))

    let data = utf16_string_base_data_without_union_member_assertion(this) else trap("unreachable: long storage has data")
    return utf16_string_data_ascii_view(data)

## Ported from AK/Utf16StringBase.h:84 AK::Detail::Utf16StringBase::utf16_view.
pub func utf16_string_base_utf16_view(this: const Utf16StringBase*) -> Utf16View:
    if utf16_string_base_has_short_ascii_storage(this):
        return utf16_view_from_ascii(short_string_bytes(&this.m_value.short_ascii_string))

    let data = utf16_string_base_data_without_union_member_assertion(this) else trap("unreachable: long storage has data")
    return utf16_string_data_utf16_view(data)

