#==============================================================================================
#
#   pattern_canonicalization - URLPattern: canonicalizing each component with the URL parser
#
#   DESCRIPTION:
#       Port of Libraries/LibURL/Pattern/Canonicalization.cpp (lines 1-262). Each function is
#       an encoding callback of the pattern parser (EncodingCallback).
#
#==============================================================================================

## Ported from Libraries/LibURL/Pattern/Canonicalization.cpp:13 URL::Pattern::create_a_dummy_url.
# https://urlpattern.spec.whatwg.org/#url-pattern-create-a-dummy-url
func pattern_create_a_dummy_url() -> Url:
    # 1. Let dummyInput be "https://dummy.invalid/".
    # 2. Return the result of running the basic URL parser on dummyInput.
    return parser_basic_parse(sv("https://dummy.invalid/")) else trap("VERIFY: Optional::release_value")

## Ported from Libraries/LibURL/Pattern/Canonicalization.cpp:21 URL::Pattern::canonicalize_a_protocol.
# https://urlpattern.spec.whatwg.org/#canonicalize-a-protocol
pub func pattern_canonicalize_a_protocol(value: ak.String) -> ak.String!:
    # 1. If value is the empty string, return value.
    if ak.string_is_empty(&value):
        return value

    # 2. Let parseResult be the result of running the basic URL parser given value followed by "://dummy.invalid/".
    # NOTE: Note, state override is not used here because it enforces restrictions that are only appropriate for the
    #       protocol setter. Instead we use the protocol to parse a dummy URL using the normal parsing entry point.
    var input: ak.StringBuilder
    ak.string_builder_construct(&input)
    append_string(&input, value)
    append_literal(&input, "://dummy.invalid")
    let parse_result = parser_basic_parse(ak.string_builder_string_view(&input))

    # 4. If parseResult is failure, then throw a TypeError.
    if parse_result == none:
        try pattern_throw("Failed to canonicalize URL protocol string")
    let url = parse_result else trap("unreachable")

    # 5. Return parseResult’s scheme.
    return url_scheme(&url)

## Ported from Libraries/LibURL/Pattern/Canonicalization.cpp:41 URL::Pattern::canonicalize_a_username.
# https://urlpattern.spec.whatwg.org/#canonicalize-a-username
pub func pattern_canonicalize_a_username(value: ak.String) -> ak.String:
    # 1. If value is the empty string, return value.
    if ak.string_is_empty(&value):
        return value

    # 2. Let dummyURL be the result of creating a dummy URL.
    var dummy_url = pattern_create_a_dummy_url()

    # 3. Set the username given dummyURL and value.
    url_set_username(&dummy_url, view_of(value))

    # 4. Return dummyURL’s username.
    return url_username(&dummy_url)

## Ported from Libraries/LibURL/Pattern/Canonicalization.cpp:58 URL::Pattern::canonicalize_a_password.
