# mark: Processing one component ================================================================

## Ported from Libraries/LibURL/Pattern/Init.cpp:15 URL::Pattern::process_a_base_url_string.
# https://urlpattern.spec.whatwg.org/#process-a-base-url-string
func pattern_process_a_base_url_string(input: ak.String, type_: PatternProcessType) -> ak.String:
    # 1. Assert: input is not null.
    # 2. If type is not "pattern" return input.
    if type_ != PatternProcessType.pattern:
        return input

    # 3. Return the result of escaping a pattern string given input.
    return pattern_escape_a_pattern_string(input)

## Ported from Libraries/LibURL/Pattern/Init.cpp:27 URL::Pattern::is_an_absolute_pathname.
# https://urlpattern.spec.whatwg.org/#is-an-absolute-pathname
func pattern_is_an_absolute_pathname(input: ak.String, type_: PatternProcessType) -> bool:
    # 1. If input is the empty string, then return false.
    if ak.string_is_empty(&input):
        return false

    let bytes = ak.string_base_bytes(&input.string_base)

    # 2. If input[0] is U+002F (/), then return true.
    if bytes[0] == '/':
        return true

    # 3. If type is "url", then return false.
    if type_ == PatternProcessType.url:
        return false

    # 4. If input’s code point length is less than 2, then return false.
    if bytes.length < 2:
        return false

    # 5. If input[0] is U+005C (\) and input[1] is U+002F (/), then return true.
    if bytes[0] == '\\' and bytes[1] == '/':
        return true

    # 6. If input[0] is U+007B ({) and input[1] is U+002F (/), then return true.
    if bytes[0] == '{' and bytes[1] == '/':
        return true

    # 7. Return false.
    return false

## Ported from Libraries/LibURL/Pattern/Init.cpp:58 URL::Pattern::process_protocol_for_init.
# https://urlpattern.spec.whatwg.org/#process-protocol-for-init
func pattern_process_protocol_for_init(value: ak.String, type_: PatternProcessType) -> ak.String!:
    # 1. Let strippedValue be the given value with a single trailing U+003A (:) removed, if any.
    var stripped_value = value
    if ak.string_ends_with(&stripped_value, (u32)':'):
        stripped_value = ak.string_substring_from_byte_offset_usize(&stripped_value, 0,
                                                                    ak.string_base_byte_count(&stripped_value.string_base) - 1) else trap("MUST: String::substring_from_byte_offset")

    # 2. If type is "pattern" then return strippedValue.
    if type_ == PatternProcessType.pattern:
        return stripped_value

    # 3. Return the result of running canonicalize a protocol given strippedValue.
    return try pattern_canonicalize_a_protocol(stripped_value)

## Ported from Libraries/LibURL/Pattern/Init.cpp:74 URL::Pattern::process_username_for_init.
# https://urlpattern.spec.whatwg.org/#process-username-for-init
func pattern_process_username_for_init(value: ak.String, type_: PatternProcessType) -> ak.String:
    # 1. If type is "pattern" then return value.
    if type_ == PatternProcessType.pattern:
        return value

    # 2. Return the result of running canonicalize a username given value.
    return pattern_canonicalize_a_username(value)

## Ported from Libraries/LibURL/Pattern/Init.cpp:85 URL::Pattern::process_password_for_init.
# https://urlpattern.spec.whatwg.org/#process-password-for-init
func pattern_process_password_for_init(value: ak.String, type_: PatternProcessType) -> ak.String:
    # 1. If type is "pattern" then return value.
    if type_ == PatternProcessType.pattern:
