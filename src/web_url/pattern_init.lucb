## Ported from Libraries/LibURL/Pattern/Init.cpp:96 URL::Pattern::process_hostname_for_init.
# https://urlpattern.spec.whatwg.org/#process-hostname-for-init
func pattern_process_hostname_for_init(value: ak.String, type_: PatternProcessType) -> ak.String!:
    # 1. If type is "pattern" then return value.
    if type_ == PatternProcessType.pattern:
