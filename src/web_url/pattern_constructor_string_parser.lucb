## Ported from Libraries/LibURL/Pattern/ConstructorStringParser.cpp:648 URL::Pattern::ConstructorStringParser::get_a_safe_token.
# https://urlpattern.spec.whatwg.org/#get-a-safe-token
pub func constructor_string_parser_get_a_safe_token(this: const ConstructorStringParser*, index: u32) -> const Token*:
    # 1. If index is less than parser’s token list's size, then return parser’s token list[index].
    if (usize)index < ak.vector_size(&this.m_token_list):
        return ak.vector_at_const(&this.m_token_list, (usize)index)

    # 2. Assert: parser’s token list's size is greater than or equal to 1.
    assert(not ak.vector_is_empty(&this.m_token_list))

    # 3. Let last index be parser’s token list's size − 1.
    # 4. Let token be parser’s token list[last index].
    let token = ak.vector_last_const(&this.m_token_list)

    # 5. Assert: token’s type is "end".
    assert(token.type_ == TokenType.end)

    # 6. Return token.
    return token

## Ported from Libraries/LibURL/Pattern/ConstructorStringParser.cpp:669 URL::Pattern::ConstructorStringParser::is_a_non_special_pattern_char.
# https://urlpattern.spec.whatwg.org/#is-a-non-special-pattern-char
pub func constructor_string_parser_is_a_non_special_pattern_char(this: const ConstructorStringParser*, index: u32, value: u8) -> bool:
    # 1. Let token be the result of running get a safe token given parser and index.
    let token = constructor_string_parser_get_a_safe_token(this, index)

    # 2. If token’s value is not value, then return false.
    if ak.string_is_empty(&token.value) or ak.string_base_bytes(&token.value.string_base)[0] != value:
        return false

    # 3. If any of the following are true:
    #     * token’s type is "char";
    #     * token’s type is "escaped-char"; or
    #     * token’s type is "invalid-char",
    #    then return true.
    if (token.type_ == TokenType.char_ or token.type_ == TokenType.escaped_char or token.type_ == TokenType.invalid_char):
        return true

    # 4. Return false.
    return false

## Ported from Libraries/LibURL/Pattern/ConstructorStringParser.cpp:694 URL::Pattern::ConstructorStringParser::rewind.
# https://urlpattern.spec.whatwg.org/#rewind
pub func constructor_string_parser_rewind(this: ConstructorStringParser*):
    # 1. Set parser’s token index to parser’s component start.
    this.m_token_index = this.m_component_start

    # 2. Set parser’s token increment to 0.
    this.m_token_increment = 0

## Ported from Libraries/LibURL/Pattern/ConstructorStringParser.cpp:704 URL::Pattern::ConstructorStringParser::rewind_and_set_state.
# https://urlpattern.spec.whatwg.org/#rewind-and-set-state
pub func constructor_string_parser_rewind_and_set_state(this: ConstructorStringParser*, state: ConstructorStringParserState):
    # 1. Run rewind given parser.
    constructor_string_parser_rewind(this)

    # 2. Set parser’s state to state.
    this.m_state = state
