#==============================================================================================
#
#   pattern_constructor_string_parser - URLPattern: splitting a constructor string into parts
#
#   DESCRIPTION:
#       Port of Libraries/LibURL/Pattern/ConstructorStringParser.cpp (lines 1-713) and
#       Libraries/LibURL/Pattern/ConstructorStringParser.h (lines 1-106).
