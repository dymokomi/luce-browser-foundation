#==============================================================================================
#
#   encoder_1 - the encoder instances, encoder lookup, and the UTF-8, EUC-JP and ISO-2022-JP
#               encoders
#
#   DESCRIPTION:
#       Port of Libraries/LibTextCodec/Encoder.cpp (lines 1-336) with the pure virtual of
#       Encoder.h: one encoder instance per encoding, encoder_for_exact_name and encoder_for,
#       and the encoders of UTF-8, EUC-JP and ISO-2022-JP (whose state machine restores a code
#       point to the queue by calling process_item again in the new state).
#
#==============================================================================================

# mark: Encoder instances ======================================================================

# The C++ globals of Encoder.cpp's anonymous namespace. Their constructors only set the vtable
# pointer (and GBK's flag, or a single-byte encoder's table), so each is a constant-initialized
# global here; the class id is the class's first id in types_encoder.

var s_utf8_encoder: Utf8Encoder = Utf8Encoder(encoder_base = Encoder(vtable = &utf8_encoder_vtable.encoder_vtable, class_id = 7))
var s_gb18030_encoder: Gb18030Encoder = Gb18030Encoder(encoder_base = Encoder(vtable = &gb18030_encoder_vtable.encoder_vtable, class_id = 4), m_is_gbk = Gb18030EncoderIsGbk.no)
var s_gbk_encoder: Gb18030Encoder = Gb18030Encoder(encoder_base = Encoder(vtable = &gb18030_encoder_vtable.encoder_vtable, class_id = 4), m_is_gbk = Gb18030EncoderIsGbk.yes)
var s_big5_encoder: Big5Encoder = Big5Encoder(encoder_base = Encoder(vtable = &big5_encoder_vtable.encoder_vtable, class_id = 1))
var s_euc_jp_encoder: EucjpEncoder = EucjpEncoder(encoder_base = Encoder(vtable = &eucjp_encoder_vtable.encoder_vtable, class_id = 2))
var s_iso_2022_jp_encoder: Iso2022JpEncoder = Iso2022JpEncoder(encoder_base = Encoder(vtable = &iso2022_jp_encoder_vtable.encoder_vtable, class_id = 5))
var s_shift_jis_encoder: ShiftJisEncoder = ShiftJisEncoder(encoder_base = Encoder(vtable = &shift_jis_encoder_vtable.encoder_vtable, class_id = 6))
var s_euc_kr_encoder: EuckrEncoder = EuckrEncoder(encoder_base = Encoder(vtable = &euckr_encoder_vtable.encoder_vtable, class_id = 3))

# s_{encoding}_index is generated from https://encoding.spec.whatwg.org/indexes.json
# Found separately in https://encoding.spec.whatwg.org/index-{encoding}.txt
var s_ibm866_encoder: SingleByteEncoder[u16] = SingleByteEncoder[u16](encoder_base = Encoder(vtable = &single_byte_encoder_vtable.encoder_vtable, class_id = 8), m_translation_table = s_ibm866_index)
var s_latin2_encoder: SingleByteEncoder[u16] = SingleByteEncoder[u16](encoder_base = Encoder(vtable = &single_byte_encoder_vtable.encoder_vtable, class_id = 8), m_translation_table = s_iso_8859_2_index)
var s_latin3_encoder: SingleByteEncoder[u16] = SingleByteEncoder[u16](encoder_base = Encoder(vtable = &single_byte_encoder_vtable.encoder_vtable, class_id = 8), m_translation_table = s_iso_8859_3_index)
var s_latin4_encoder: SingleByteEncoder[u16] = SingleByteEncoder[u16](encoder_base = Encoder(vtable = &single_byte_encoder_vtable.encoder_vtable, class_id = 8), m_translation_table = s_iso_8859_4_index)
var s_latin_cyrillic_encoder: SingleByteEncoder[u16] = SingleByteEncoder[u16](encoder_base = Encoder(vtable = &single_byte_encoder_vtable.encoder_vtable, class_id = 8), m_translation_table = s_iso_8859_5_index)
var s_latin_arabic_encoder: SingleByteEncoder[u16] = SingleByteEncoder[u16](encoder_base = Encoder(vtable = &single_byte_encoder_vtable.encoder_vtable, class_id = 8), m_translation_table = s_iso_8859_6_index)
var s_latin_greek_encoder: SingleByteEncoder[u16] = SingleByteEncoder[u16](encoder_base = Encoder(vtable = &single_byte_encoder_vtable.encoder_vtable, class_id = 8), m_translation_table = s_iso_8859_7_index)
var s_latin_hebrew_encoder: SingleByteEncoder[u16] = SingleByteEncoder[u16](encoder_base = Encoder(vtable = &single_byte_encoder_vtable.encoder_vtable, class_id = 8), m_translation_table = s_iso_8859_8_index)
var s_latin6_encoder: SingleByteEncoder[u16] = SingleByteEncoder[u16](encoder_base = Encoder(vtable = &single_byte_encoder_vtable.encoder_vtable, class_id = 8), m_translation_table = s_iso_8859_10_index)
var s_latin7_encoder: SingleByteEncoder[u16] = SingleByteEncoder[u16](encoder_base = Encoder(vtable = &single_byte_encoder_vtable.encoder_vtable, class_id = 8), m_translation_table = s_iso_8859_13_index)
var s_latin8_encoder: SingleByteEncoder[u16] = SingleByteEncoder[u16](encoder_base = Encoder(vtable = &single_byte_encoder_vtable.encoder_vtable, class_id = 8), m_translation_table = s_iso_8859_14_index)
var s_latin9_encoder: SingleByteEncoder[u16] = SingleByteEncoder[u16](encoder_base = Encoder(vtable = &single_byte_encoder_vtable.encoder_vtable, class_id = 8), m_translation_table = s_iso_8859_15_index)
var s_latin10_encoder: SingleByteEncoder[u16] = SingleByteEncoder[u16](encoder_base = Encoder(vtable = &single_byte_encoder_vtable.encoder_vtable, class_id = 8), m_translation_table = s_iso_8859_16_index)
