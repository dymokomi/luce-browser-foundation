#==============================================================================================
#
#   lookup_tables - index code point and index pointer lookups over the Encoding indexes
#
#   DESCRIPTION:
#       Port of Build/Libraries/LibTextCodec/LookupTables.cpp (lines 1-666), which Ladybird
#       generates with Meta/Generators/generate_encoding_indexes.py: for each index, the index
#       code point for a pointer and the index pointer for a code point
#       (https://encoding.spec.whatwg.org/#index-code-point). 0xfffd marks a null entry.
#
#==============================================================================================

# mark: gb18030 ===============================================================================

## Ported from Build/Libraries/LibTextCodec/LookupTables.cpp:6 TextCodec::index_gb18030_code_point.
pub func index_gb18030_code_point(pointer: u32) -> u32?:
    if pointer >= s_gb18030_index.length:
        return none
    let value = s_gb18030_index[pointer]
    if value == 0xfffd:
        return none
    return value

## Ported from Build/Libraries/LibTextCodec/LookupTables.cpp:16 TextCodec::code_point_gb18030_index.
pub func code_point_gb18030_index(code_point: u32) -> u32?:
    for i in 0..<s_gb18030_index.length:
        if s_gb18030_index[i] == code_point:
            return (u32)i
    return none

# mark: big5 ==================================================================================

## Ported from Build/Libraries/LibTextCodec/LookupTables.cpp:26 TextCodec::index_big5_code_point.
pub func index_big5_code_point(pointer: u32) -> u32?:
    if pointer < s_big5_index_first_pointer or pointer - s_big5_index_first_pointer >= s_big5_index.length:
        return none
    let value = s_big5_index[pointer - s_big5_index_first_pointer]
    if value == 0xfffd:
        return none
    return value

## Ported from Build/Libraries/LibTextCodec/LookupTables.cpp:36 TextCodec::code_point_big5_index.
pub func code_point_big5_index(code_point: u32) -> u32?:
    for i in 0..<s_big5_index.length:
        if s_big5_index[i] == code_point:
            return s_big5_index_first_pointer + (u32)i
    return none

