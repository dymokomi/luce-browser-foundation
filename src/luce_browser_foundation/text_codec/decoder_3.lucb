# mark: Latin-1, PDFDocEncoding, x-user-defined ==============================================

## Ported from Libraries/LibTextCodec/Decoder.cpp:738 TextCodec::Latin1Decoder::process (override).
pub func latin1_decoder_process_impl(base: Decoder*, input: ak.StringView, on_code_point: ak.Function1[u32, unit]) -> !:
    for ch in ak.string_view_bytes(&input):
        # Latin1 is the same as the first 256 Unicode code_points, so no mapping is needed, just utf-8 encoding.
        call_function1(on_code_point, (u32)ch)

## Ported from Libraries/LibTextCodec/Decoder.h:80 TextCodec::Latin1Decoder::validate (override).
pub func latin1_decoder_validate_impl(base: Decoder*, arg0: ak.StringView) -> bool:
    return true

# PDFDocEncodingDecoder::process's static translation table.
# PDF 1.7 spec, Appendix D.2 "PDFDocEncoding Character Set"
# Character codes 0-8, 11-12, 14-23, 127, 159, 173 are not defined per spec.
