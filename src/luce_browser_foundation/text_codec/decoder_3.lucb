#==============================================================================================
#
#   decoder_3 - the Unicode, Latin-1, PDFDocEncoding, x-user-defined and single-byte decoders
#
#   DESCRIPTION:
#       Port of Libraries/LibTextCodec/Decoder.cpp (lines 692-841) with the inline functions of
#       Decoder.h they override: UTF-8, UTF-16BE/LE (which decode through AK::String), Latin-1,
#       PDFDocEncoding, x-user-defined, and the single-byte decoder over an index of 128 code
#       points.
#
#==============================================================================================

# mark: UTF-8 ==================================================================================

## Ported from Libraries/LibTextCodec/Decoder.cpp:692 TextCodec::UTF8Decoder::process (override).
pub func utf8_decoder_process_impl(base: Decoder*, input: ak.StringView, on_code_point: ak.Function1[u32, unit]) -> !:
    # for (auto c : Utf8View(input))
    var view: ak.Utf8View
    ak.utf8_view_construct_string_view(&view, input)
    let end = ak.utf8_view_end(&view)
    var iterator = ak.utf8_view_begin(&view)
    while iterator != end:
        let c = ak.utf8_code_point_iterator_deref(&iterator)
        call_function1(on_code_point, c)
        discard(ak.utf8_code_point_iterator_inc(&iterator))

## Ported from Libraries/LibTextCodec/Decoder.cpp:700 TextCodec::UTF8Decoder::validate (override).
pub func utf8_decoder_validate_impl(base: Decoder*, input: ak.StringView) -> bool:
    var view: ak.Utf8View
    ak.utf8_view_construct_string_view(&view, input)
    return ak.utf8_view_validate_allow_lonely_surrogates(&view)

## Ported from Libraries/LibTextCodec/Decoder.cpp:705 TextCodec::UTF8Decoder::to_utf8 (override).
pub func utf8_decoder_to_utf8_impl(base: Decoder*, input: ak.StringView) -> ak.String!:
    return ak.string_from_utf8_with_replacement_character(input)

# mark: UTF-16 =================================================================================

## Ported from Libraries/LibTextCodec/Decoder.cpp:710 TextCodec::UTF16BEDecoder::validate (override).
pub func utf16_be_decoder_validate_impl(base: Decoder*, input: ak.StringView) -> bool:
    return ak.validate_utf16_be(ak.string_view_bytes(&input))

## Ported from Libraries/LibTextCodec/Decoder.cpp:715 TextCodec::UTF16BEDecoder::to_utf8 (override).
pub func utf16_be_decoder_to_utf8_impl(base: Decoder*, input: ak.StringView) -> ak.String!:
    var remaining_input = input  # C++ reassigns the `input` parameter

    # Discard the BOM
    let bytes = ak.string_view_bytes(&input)
    if bytes.length >= 2 and bytes[0] == 0xFE and bytes[1] == 0xFF:
        remaining_input = ak.string_view_substring_view(&input, 2)

    return try ak.string_from_utf16_be_with_replacement_character(ak.string_view_bytes(&remaining_input))

## Ported from Libraries/LibTextCodec/Decoder.h:50 TextCodec::UTF16BEDecoder::process (override):
## never called, to_utf8 and validate do not go through it.
pub func utf16_be_decoder_process_impl(base: Decoder*, arg0: ak.StringView, arg1: ak.Function1[u32, unit]) -> !:
    trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibTextCodec/Decoder.cpp:724 TextCodec::UTF16LEDecoder::validate (override).
pub func utf16_le_decoder_validate_impl(base: Decoder*, input: ak.StringView) -> bool:
    return ak.validate_utf16_le(ak.string_view_bytes(&input))

## Ported from Libraries/LibTextCodec/Decoder.cpp:729 TextCodec::UTF16LEDecoder::to_utf8 (override).
pub func utf16_le_decoder_to_utf8_impl(base: Decoder*, input: ak.StringView) -> ak.String!:
    var remaining_input = input  # C++ reassigns the `input` parameter

    # Discard the BOM
    let bytes = ak.string_view_bytes(&input)
    if bytes.length >= 2 and bytes[0] == 0xFF and bytes[1] == 0xFE:
        remaining_input = ak.string_view_substring_view(&input, 2)

    return try ak.string_from_utf16_le_with_replacement_character(ak.string_view_bytes(&remaining_input))

