## Ported from Libraries/LibTextCodec/Decoder.cpp:748 TextCodec::PDFDocEncodingDecoder::process (override).
pub func pdf_doc_encoding_decoder_process_impl(base: Decoder*, input: ak.StringView, on_code_point: ak.Function1[u32, unit]) -> !:
    for ch in ak.string_view_bytes(&input):
        call_function1(on_code_point, pdf_doc_encoding_translation_table[ch])

## Ported from Libraries/LibTextCodec/Decoder.h:86 TextCodec::PDFDocEncodingDecoder::validate (override).
pub func pdf_doc_encoding_decoder_validate_impl(base: Decoder*, arg0: ak.StringView) -> bool:
    return true

# XUserDefinedDecoder::process's lambda convert_x_user_defined_to_utf8.
func convert_x_user_defined_to_utf8(ch: u8) -> u32:
    # 2. If byte is an ASCII byte, return a code point whose value is byte.
    # https://infra.spec.whatwg.org/#ascii-byte
    # An ASCII byte is a byte in the range 0x00 (NUL) to 0x7F (DEL), inclusive.
    # NOTE: This doesn't check for ch >= 0x00, as that would always be true due to being unsigned.
    if ch <= 0x7f:
        return ch

    # 3. Return a code point whose value is 0xF780 + byte − 0x80.
    return 0xF780 + (u32)ch - 0x80

## Ported from Libraries/LibTextCodec/Decoder.cpp:796 TextCodec::XUserDefinedDecoder::process (override).
## https://encoding.spec.whatwg.org/#x-user-defined-decoder
pub func x_user_defined_decoder_process_impl(base: Decoder*, input: ak.StringView, on_code_point: ak.Function1[u32, unit]) -> !:
    for ch in ak.string_view_bytes(&input):
        call_function1(on_code_point, convert_x_user_defined_to_utf8(ch))

    # 1. If byte is end-of-queue, return finished.
    return

## Ported from Libraries/LibTextCodec/Decoder.h:92 TextCodec::XUserDefinedDecoder::validate (override).
pub func x_user_defined_decoder_validate_impl(base: Decoder*, arg0: ak.StringView) -> bool:
    return true

# mark: Single-byte decoder ====================================================================

# The donor instantiates SingleByteDecoder<ArrayType> only with ArrayType = u16 (its tables are
# Array<u16, 128>), and a Base generic body cannot convert a T to u32, so the port's functions take
# the u16 instantiation.

## Ported from Libraries/LibTextCodec/Decoder.h:66 TextCodec::SingleByteDecoder::SingleByteDecoder<ArrayType>:
## a single-byte decoder over an index of the code points of bytes 0x80 to 0xFF.
pub func single_byte_decoder_construct(this: SingleByteDecoder[u16]*, translation_table: u16[128]):
    this.decoder_base.vtable = &single_byte_decoder_vtable.decoder_vtable  # the C++ vptr
    this.decoder_base.class_id = single_byte_decoder_class.first_id
    this.m_translation_table = translation_table

## Ported from Libraries/LibTextCodec/Decoder.cpp:821 TextCodec::SingleByteDecoder::process.
## https://encoding.spec.whatwg.org/#single-byte-decoder
pub func single_byte_decoder_process(this: SingleByteDecoder[u16]*, input: ak.StringView, on_code_point: ak.Function1[u32, unit]) -> !:
    for byte in ak.string_view_bytes(&input):
        if byte < 0x80:
            # 2. If byte is an ASCII byte, return a code point whose value is byte.
            call_function1(on_code_point, (u32)byte)
        else:
            # 3. Let code point be the index code point for byte − 0x80 in index single-byte.
            let code_point = this.m_translation_table[byte - 0x80]

            # 4. If code point is null, return error.
            # NOTE: Error is communicated with 0xFFFD

            # 5. Return a code point whose value is code point.
            call_function1(on_code_point, (u32)code_point)
    # 1. If byte is end-of-queue, return finished.
    return

## The vtable slot of SingleByteDecoder<u16>::process (override): dispatches to
## single_byte_decoder_process.
pub func single_byte_decoder_process_impl(base: Decoder*, input: ak.StringView, on_code_point: ak.Function1[u32, unit]) -> !:
    try single_byte_decoder_process((SingleByteDecoder[u16]*)base, input, on_code_point)
