## Ported from AK/SaturatingMath.h:58 AK::saturating_mul (signed), for i8.
pub func saturating_mul_i8(a: i8, b: i8) -> i8:
    let result = a *% b
    let overflowed: u8 = 0 if (a *? b) != none else 1
    # Same signs → positive overflow → max. Different signs → negative overflow → min.
    let saturated = (i8)((u8)i8_max +% (((u8)a ^ (u8)b) >> (8 - 1)))
    let mask = -%overflowed
    return (i8)(((u8)saturated & mask) | ((u8)result & ~mask))

## Ported from AK/SaturatingMath.h:58 AK::saturating_mul (signed), for i16.
pub func saturating_mul_i16(a: i16, b: i16) -> i16:
    let result = a *% b
    let overflowed: u16 = 0 if (a *? b) != none else 1
    # Same signs → positive overflow → max. Different signs → negative overflow → min.
    let saturated = (i16)((u16)i16_max +% (((u16)a ^ (u16)b) >> (16 - 1)))
    let mask = -%overflowed
    return (i16)(((u16)saturated & mask) | ((u16)result & ~mask))

