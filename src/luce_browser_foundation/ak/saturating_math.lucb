## Ported from AK/SaturatingMath.h:37 AK::saturating_sub (signed), for i8.
pub func saturating_sub_i8(a: i8, b: i8) -> i8:
    let result = a -% b
    let overflowed: u8 = 0 if (a -? b) != none else 1
    let saturated = (i8)((u8)i8_max +% ((u8)a >> (8 - 1)))
