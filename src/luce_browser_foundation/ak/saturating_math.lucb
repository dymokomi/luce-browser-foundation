#==============================================================================================
#
#   saturating_math - saturating add, sub and mul on integers
#
#   DESCRIPTION:
#       Port of AK/SaturatingMath.h (lines 1-85), each template instantiated per integer
#       type with the type as a suffix (`saturating_add_i32`). The branch-free formulas are
#       kept; `__builtin_*_overflow` is the `+?` family.
#
#==============================================================================================

# mark: Signed ==================================================================================

## Ported from AK/SaturatingMath.h:16 AK::saturating_add (signed), for i8.
pub func saturating_add_i8(a: i8, b: i8) -> i8:
    let result = a +% b
    let overflowed: u8 = 0 if (a +? b) != none else 1
    let saturated = (i8)((u8)i8_max +% ((u8)a >> (8 - 1)))
    let mask = -%overflowed
    return (i8)(((u8)saturated & mask) | ((u8)result & ~mask))

## Ported from AK/SaturatingMath.h:16 AK::saturating_add (signed), for i16.
pub func saturating_add_i16(a: i16, b: i16) -> i16:
    let result = a +% b
    let overflowed: u16 = 0 if (a +? b) != none else 1
    let saturated = (i16)((u16)i16_max +% ((u16)a >> (16 - 1)))
    let mask = -%overflowed
    return (i16)(((u16)saturated & mask) | ((u16)result & ~mask))

