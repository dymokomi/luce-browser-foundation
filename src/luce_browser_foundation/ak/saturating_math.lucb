# mark: Unsigned ================================================================================

## Ported from AK/SaturatingMath.h:28 AK::saturating_add (unsigned), for u8.
pub func saturating_add_u8(a: u8, b: u8) -> u8:
    var result = a +% b
    result = result | -%(u8)(result < a)
    return result

## Ported from AK/SaturatingMath.h:28 AK::saturating_add (unsigned), for u16.
pub func saturating_add_u16(a: u16, b: u16) -> u16:
    var result = a +% b
    result = result | -%(u16)(result < a)
    return result

## Ported from AK/SaturatingMath.h:28 AK::saturating_add (unsigned), for u32.
pub func saturating_add_u32(a: u32, b: u32) -> u32:
    var result = a +% b
    result = result | -%(u32)(result < a)
    return result

## Ported from AK/SaturatingMath.h:28 AK::saturating_add (unsigned), for u64.
pub func saturating_add_u64(a: u64, b: u64) -> u64:
    var result = a +% b
    result = result | -%(u64)(result < a)
    return result

## Ported from AK/SaturatingMath.h:28 AK::saturating_add (unsigned), for usize.
pub func saturating_add_usize(a: usize, b: usize) -> usize:
    var result = a +% b
    result = result | -%(usize)(result < a)
    return result

## Ported from AK/SaturatingMath.h:49 AK::saturating_sub (unsigned), for u8.
pub func saturating_sub_u8(a: u8, b: u8) -> u8:
    var result = a -% b
    result = result & -%(u8)(result <= a)
    return result

## Ported from AK/SaturatingMath.h:49 AK::saturating_sub (unsigned), for u16.
pub func saturating_sub_u16(a: u16, b: u16) -> u16:
    var result = a -% b
    result = result & -%(u16)(result <= a)
    return result

## Ported from AK/SaturatingMath.h:49 AK::saturating_sub (unsigned), for u32.
pub func saturating_sub_u32(a: u32, b: u32) -> u32:
    var result = a -% b
    result = result & -%(u32)(result <= a)
    return result

## Ported from AK/SaturatingMath.h:49 AK::saturating_sub (unsigned), for u64.
pub func saturating_sub_u64(a: u64, b: u64) -> u64:
    var result = a -% b
    result = result & -%(u64)(result <= a)
    return result

## Ported from AK/SaturatingMath.h:49 AK::saturating_sub (unsigned), for usize.
pub func saturating_sub_usize(a: usize, b: usize) -> usize:
    var result = a -% b
    result = result & -%(usize)(result <= a)
    return result

## Ported from AK/SaturatingMath.h:72 AK::saturating_mul (unsigned), for u8.
pub func saturating_mul_u8(a: u8, b: u8) -> u8:
    let result = a *? b else return u8_max
    return result

## Ported from AK/SaturatingMath.h:72 AK::saturating_mul (unsigned), for u16.
pub func saturating_mul_u16(a: u16, b: u16) -> u16:
    let result = a *? b else return u16_max
    return result

## Ported from AK/SaturatingMath.h:72 AK::saturating_mul (unsigned), for u32.
pub func saturating_mul_u32(a: u32, b: u32) -> u32:
    let result = a *? b else return u32_max
    return result

## Ported from AK/SaturatingMath.h:72 AK::saturating_mul (unsigned), for u64.
pub func saturating_mul_u64(a: u64, b: u64) -> u64:
    let result = a *? b else return u64_max
    return result

## Ported from AK/SaturatingMath.h:72 AK::saturating_mul (unsigned), for usize.
pub func saturating_mul_usize(a: usize, b: usize) -> usize:
    let result = a *? b else return usize_max
    return result
