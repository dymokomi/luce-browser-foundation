test "to_ascii_lowercase":
    test_to_ascii_lowercase()

noinline func test_to_ascii_lowercase():
    compare_value_output_over(ascii_range, c_tolower, to_ascii_lowercase)

test "to_ascii_uppercase":
    test_to_ascii_uppercase()

noinline func test_to_ascii_uppercase():
    compare_value_output_over(ascii_range, c_toupper, to_ascii_uppercase)

test "parse_ascii_base36_digit":
    test_parse_ascii_base36_digit()

noinline func test_parse_ascii_base36_digit():
    assert(parse_ascii_base36_digit((u32)'0') == 0)
    assert(parse_ascii_base36_digit((u32)'9') == 9)
    assert(parse_ascii_base36_digit((u32)'A') == 10)
    assert(parse_ascii_base36_digit((u32)'Z') == 35)
    assert(parse_ascii_base36_digit((u32)'a') == 10)
    assert(parse_ascii_base36_digit((u32)'z') == 35)

test "parse_ascii_digit":
    test_parse_ascii_digit()

noinline func test_parse_ascii_digit():
    assert(parse_ascii_digit((u32)'0') == 0)
    assert(parse_ascii_digit((u32)'9') == 9)

test "parse_ascii_hex_digit":
    test_parse_ascii_hex_digit()

noinline func test_parse_ascii_hex_digit():
    assert(parse_ascii_hex_digit((u32)'0') == 0)
    assert(parse_ascii_hex_digit((u32)'F') == 15)
    assert(parse_ascii_hex_digit((u32)'f') == 15)

test "is_ascii_unicode (randomized)":
    test_is_ascii_unicode_randomized()

noinline func test_is_ascii_unicode_randomized():
    randomized_compare_bool_output_over(unicode_range, c_isascii, is_ascii)

test "to_ascii_lowercase_unicode (randomized)":
    test_to_ascii_lowercase_unicode_randomized()

noinline func test_to_ascii_lowercase_unicode_randomized():
    randomized_compare_value_output_over(unicode_range, c_tolower, to_ascii_lowercase)

