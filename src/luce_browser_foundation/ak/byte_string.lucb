## Ported from AK/ByteString.h:140 AK::ByteString::trim.
pub func byte_string_trim(this: const ByteString*, characters: StringView, mode: TrimMode = TrimMode.both) -> ByteString:
    let view = byte_string_view(this)
    let trimmed_view = string_utils_trim(view, characters, mode)
    if string_view_eq_string_view(&view, trimmed_view):
        return *this
    return byte_string_from_string_view(trimmed_view)

