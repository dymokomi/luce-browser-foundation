# mark: Splitting and searching =================================================================

## Ported from AK/ByteString.cpp:84 AK::ByteString::split_limit.
pub func byte_string_split_limit(this: const ByteString*, separator: u8, limit: usize, split_behavior: SplitBehavior = SplitBehavior.nothing) -> Vector[ByteString]:
    var v: Vector[ByteString]
    if byte_string_is_empty(this):
        return v

    var substart: usize = 0
    let keep_empty = has_flag(split_behavior, SplitBehavior.keep_empty)
    let keep_separator = has_flag(split_behavior, SplitBehavior.keep_trailing_separator)
    let characters = byte_string_bytes(this)
    var i: usize = 0
    while i < characters.length and (vector_size(&v) + 1) != limit:
        let ch = characters[i]
        if ch == separator:
            let sublen = i - substart
            if sublen != 0 or keep_empty:
                vector_append_t(&v, byte_string_substring_usize(this, substart, sublen + 1 if keep_separator else sublen))
            substart = i + 1
        i += 1
    let taillen = byte_string_length(this) - substart
    if taillen != 0 or keep_empty:
        vector_append_t(&v, byte_string_substring_usize(this, substart, taillen))
    return v

## Ported from AK/ByteString.cpp:79 AK::ByteString::split.
pub func byte_string_split(this: const ByteString*, separator: u8, split_behavior: SplitBehavior = SplitBehavior.nothing) -> Vector[ByteString]:
    return byte_string_split_limit(this, separator, 0, split_behavior)

## The `[separator](char ch) { return ch == separator; }` predicate of ByteString::split_view(char).
struct ByteStringSplitViewIsSeparator: CharPredicate:
    var separator: u8

    func matches(ch: u8) -> bool:
        return ch == self.separator

## Ported from AK/ByteString.cpp:132 AK::ByteString::split_view(char, SplitBehavior).
pub func byte_string_split_view_u8(this: const ByteString*, separator: u8, split_behavior: SplitBehavior = SplitBehavior.nothing) -> Vector[StringView]:
    let is_separator = ByteStringSplitViewIsSeparator(separator = separator)
    return byte_string_split_view_if(this, &is_separator, split_behavior)

## Ported from AK/ByteString.cpp:108 AK::ByteString::split_view(Function<bool(char)>, SplitBehavior).
## The predicate is a CharPredicate.
pub func byte_string_split_view_if[P: CharPredicate](this: const ByteString*, separator: const P*, split_behavior: SplitBehavior = SplitBehavior.nothing) -> Vector[StringView]:
    var v: Vector[StringView]
    if byte_string_is_empty(this):
        return v

    var substart: usize = 0
    let keep_empty = has_flag(split_behavior, SplitBehavior.keep_empty)
    let keep_separator = has_flag(split_behavior, SplitBehavior.keep_trailing_separator)
    let characters = byte_string_bytes(this)
    for i in 0..<characters.length:
        let ch = characters[i]
        if separator.matches(ch):
            let sublen = i - substart
            if sublen != 0 or keep_empty:
                vector_append_t(&v, byte_string_substring_view_usize(this, substart, sublen + 1 if keep_separator else sublen))
            substart = i + 1
    let taillen = byte_string_length(this) - substart
    if taillen != 0 or keep_empty:
        vector_append_t(&v, byte_string_substring_view_usize(this, substart, taillen))
    return v

