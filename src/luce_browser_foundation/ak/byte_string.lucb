## Ported from AK/ByteString.cpp:51 AK::ByteString::substring(size_t, size_t).
pub func byte_string_substring_usize(this: const ByteString*, start: usize, length: usize) -> ByteString:
    if length == 0:
        return byte_string_empty()
    let end = start +? length else trap("VERIFY: substring overflow")
    assert(end <= byte_string_impl_length(this.m_impl))
    return byte_string_from_string_view(string_view_from_bytes(byte_string_bytes(this)[start..<end]))

## Ported from AK/ByteString.cpp:60 AK::ByteString::substring(size_t).
pub func byte_string_substring(this: const ByteString*, start: usize) -> ByteString:
    assert(start <= byte_string_length(this))
    return byte_string_from_string_view(string_view_from_bytes(byte_string_bytes(this)[start..]))

## Ported from AK/ByteString.cpp:66 AK::ByteString::substring_view(size_t, size_t).
pub func byte_string_substring_view_usize(this: const ByteString*, start: usize, length: usize) -> StringView:
    let end = start +? length else trap("VERIFY: substring_view overflow")
    assert(end <= byte_string_impl_length(this.m_impl))
    return StringView(m_characters = byte_string_characters(this) + start, m_length = length)

## Ported from AK/ByteString.cpp:73 AK::ByteString::substring_view(size_t).
pub func byte_string_substring_view(this: const ByteString*, start: usize) -> StringView:
    assert(start <= byte_string_length(this))
    return StringView(m_characters = byte_string_characters(this) + start, m_length = byte_string_length(this) - start)

# mark: Accessors ===============================================================================

## Ported from AK/ByteString.h:190 AK::ByteString::is_empty.
pub func byte_string_is_empty(this: const ByteString*) -> bool:
    return byte_string_length(this) == 0

## Ported from AK/ByteString.h:191 AK::ByteString::length.
pub func byte_string_length(this: const ByteString*) -> usize:
    return byte_string_impl_length(this.m_impl)

## Ported from AK/ByteString.h:193 AK::ByteString::characters: includes the NUL terminator.
pub func byte_string_characters(this: const ByteString*) -> const u8*:
    return byte_string_impl_characters(this.m_impl)

## Ported from AK/ByteString.cpp:39 AK::ByteString::copy_characters_to_buffer: copies as much as
## fits and a NUL; answers whether everything fit.
pub func byte_string_copy_characters_to_buffer(this: const ByteString*, buffer: u8[]) -> bool:
    # We must fit at least the NUL-terminator.
    assert(buffer.length > 0)

    let length = byte_string_length(this)
    let characters_to_copy = length if length < buffer.length - 1 else buffer.length - 1
    copy_bytes(buffer, byte_string_bytes(this)[..<characters_to_copy])
    buffer[characters_to_copy] = 0

    return characters_to_copy == length

