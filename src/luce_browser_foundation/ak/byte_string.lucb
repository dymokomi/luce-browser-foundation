#==============================================================================================
#
#   byte_string - ByteString: an immutable NUL-terminated byte string
#
#   DESCRIPTION:
#       Port of AK/ByteString.h (lines 1-332) and AK/ByteString.cpp (lines 1-298), in the
#       header's order with the .cpp bodies in place of their declarations.
#
#       A ByteString points at a ByteStringImpl (never null: the empty string is the static
#       empty impl). Copies share the impl. Unlike String, a ByteString's bytes always live in
#       the impl, so views of a ByteString value stay valid while the impl is reachable.
#
#==============================================================================================

# mark: Construction ============================================================================

## Ported from AK/ByteString.h:43 AK::ByteString::ByteString(): the empty string.
pub func byte_string_construct(this: ByteString*):
    this.m_impl = byte_string_impl_the_empty_stringimpl()

## Ported from AK/ByteString.h:48 AK::ByteString::ByteString(StringView).
pub func byte_string_construct_string_view(this: ByteString*, view: StringView):
    this.m_impl = byte_string_impl_create_u8_usize(string_view_characters_without_null_termination(&view) else "".bytes.data, string_view_length(&view))

## Ported from AK/ByteString.h:64 AK::ByteString::ByteString(char const*, ShouldChomp).
pub func byte_string_construct_u8_should_chomp(this: ByteString*, cstring: const u8*?, should_chomp: ShouldChomp = ShouldChomp.no_chomp):
    this.m_impl = byte_string_impl_create_u8_should_chomp(cstring, should_chomp)

## Ported from AK/ByteString.h:69 AK::ByteString::ByteString(char const*, size_t, ShouldChomp).
pub func byte_string_construct_u8_usize(this: ByteString*, cstring: const u8*?, length: usize, should_chomp: ShouldChomp = ShouldChomp.no_chomp):
    this.m_impl = byte_string_impl_create_u8_usize(cstring, length, should_chomp)

## Ported from AK/ByteString.h:74 AK::ByteString::ByteString(ReadonlyBytes, ShouldChomp).
pub func byte_string_construct_span_u8(this: ByteString*, bytes: const u8[], should_chomp: ShouldChomp = ShouldChomp.no_chomp):
    this.m_impl = byte_string_impl_create_span_u8(bytes, should_chomp)

## Ported from AK/ByteString.h:79 AK::ByteString::ByteString(ByteStringImpl const&).
pub func byte_string_construct_byte_string_impl(this: ByteString*, impl: const ByteStringImpl*):
    this.m_impl = impl

## Ported from AK/ByteString.h:84 AK::ByteString::ByteString(NonnullRefPtr<ByteStringImpl const>&&).
pub func byte_string_construct_byte_string_impl_2(this: ByteString*, impl: const ByteStringImpl*):
    this.m_impl = impl

## Ported from AK/ByteString.cpp:240 AK::ByteString::ByteString(FlyString const&).
pub func byte_string_construct_fly_string(this: ByteString*, string: const FlyString*):
    this.m_impl = byte_string_impl_create_span_u8(fly_string_bytes(string))

## `ByteString(view)`: a ByteString of a view's bytes (the value form of the StringView
## constructor).
pub func byte_string_from_string_view(view: StringView) -> ByteString:
    var result = ByteString(m_impl = byte_string_impl_the_empty_stringimpl())
    byte_string_construct_string_view(&result, view)
    return result

## `ByteString("text")`: a ByteString of a literal or any other `str`.
pub func byte_string_from_str(text: str) -> ByteString:
    return byte_string_from_string_view(sv(text))

## `ByteString(impl)`: the value form of the ByteStringImpl constructors.
pub func byte_string_from_impl(impl: const ByteStringImpl*) -> ByteString:
    return ByteString(m_impl = impl)

## Ported from AK/ByteString.cpp:167 AK::ByteString::repeated(char, size_t).
pub func byte_string_repeated_u8(ch: u8, count: usize) -> ByteString:
    if count == 0:
        return byte_string_empty()
    var buffer: u8*? = none
    let impl = byte_string_impl_create_uninitialized(count, &buffer)
    memory.set(u8[](buffer else trap("VERIFY: buffer"), count), ch)
    return byte_string_from_impl(impl)

## Ported from AK/ByteString.cpp:177 AK::ByteString::repeated(StringView, size_t).
pub func byte_string_repeated_string_view(string: StringView, count: usize) -> ByteString:
    if count == 0 or string_view_is_empty(&string):
        return byte_string_empty()
    var buffer: u8*? = none
    let length = string_view_length(&string)
    let impl = byte_string_impl_create_uninitialized(count * length, &buffer)
    let destination = u8[](buffer else trap("VERIFY: buffer"), count * length)
    for i in 0..<count:
        copy_bytes(destination[(i * length)..], string_view_bytes(&string))
    return byte_string_from_impl(impl)

## Ported from AK/ByteString.h:112 AK::ByteString::join over StringViews with the default "{}"
## format.
pub func byte_string_join_string_view(separator: StringView, collection: const StringView[]) -> ByteString:
    var builder = string_builder_new()
    string_builder_join_string_view(&builder, separator, collection)
    return string_builder_to_byte_string(&builder)

