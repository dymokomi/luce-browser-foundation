## `Traits<ByteString>::hash`: the impl's hash.
pub func byte_string_traits_hash(s: const ByteString*) -> u32:
    return byte_string_impl_hash(byte_string_impl(s))

## Ported from AK/ByteString.h:321 AK::CaseInsensitiveASCIIStringTraits::hash.
pub func case_insensitive_ascii_string_traits_hash(s: const ByteString*) -> u32:
    return byte_string_impl_case_insensitive_hash(byte_string_impl(s))

## Ported from AK/ByteString.h:322 AK::CaseInsensitiveASCIIStringTraits::equals.
pub func case_insensitive_ascii_string_traits_equals(a: const ByteString*, b: const ByteString*) -> bool:
    return byte_string_equals_ignoring_ascii_case(a, byte_string_view(b))

## Ported from AK/ByteString.cpp:222 AK::escape_html_entities.
pub func escape_html_entities(html: StringView) -> ByteString:
    var builder = string_builder_new()
    for ch in string_view_bytes(&html):
        if ch == '<':
            string_builder_append(&builder, "&lt;")
        elif ch == '>':
            string_builder_append(&builder, "&gt;")
        elif ch == '&':
            string_builder_append(&builder, "&amp;")
        elif ch == '"':
            string_builder_append(&builder, "&quot;")
        else:
            string_builder_append_u8(&builder, ch)
    return string_builder_to_byte_string(&builder)
