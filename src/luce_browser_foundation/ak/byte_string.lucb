pub func byte_string_vformatted(fmtstr: StringView, params: TypeErasedFormatParams*) -> ByteString:
    var builder = string_builder_new()
    vformat(&builder, fmtstr, params) else trap("MUST: ByteString::vformatted")
    return string_builder_to_byte_string(&builder)

## Ported from AK/ByteString.h:286 AK::ByteString::view.
pub func byte_string_view(this: const ByteString*) -> StringView:
    return StringView(m_characters = byte_string_characters(this), m_length = byte_string_length(this))

## Ported from AK/ByteString.h:289 AK::ByteString::replace.
pub func byte_string_replace(this: const ByteString*, needle: StringView, replacement: StringView, replace_mode: ReplaceMode = ReplaceMode.all) -> ByteString:
    return string_utils_replace_string_view(byte_string_view(this), needle, replacement, replace_mode)

## Ported from AK/ByteString.h:290 AK::ByteString::count.
pub func byte_string_count(this: const ByteString*, needle: StringView) -> usize:
    return string_utils_count_string_view(byte_string_view(this), needle)

## Ported from AK/ByteString.cpp:213 AK::ByteString::reverse.
pub func byte_string_reverse(this: const ByteString*) -> ByteString:
    var reversed_string = string_builder_new_usize(byte_string_length(this))
    let characters = byte_string_bytes(this)
    var i = characters.length
    while i > 0:
        i -= 1
        string_builder_append_u8(&reversed_string, characters[i])
    return string_builder_to_byte_string(&reversed_string)

