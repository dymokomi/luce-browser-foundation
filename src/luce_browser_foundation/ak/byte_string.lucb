# mark: Case and trimming =======================================================================

## Ported from AK/ByteString.cpp:245 AK::ByteString::to_lowercase.
pub func byte_string_to_lowercase(this: const ByteString*) -> ByteString:
    var has_upper = false
    for byte in byte_string_bytes(this):
        if is_ascii_upper_alpha(byte):
            has_upper = true
            break
    if not has_upper:
        return *this

    var buffer: u8*? = none
    let impl = byte_string_impl_create_uninitialized(byte_string_length(this), &buffer)
    let destination = buffer else trap("VERIFY: buffer")

    let characters = byte_string_bytes(this)
    for i in 0..<characters.length:
        destination[i] = (u8)to_ascii_lowercase(characters[i])

    return byte_string_from_impl(impl)

## Ported from AK/ByteString.cpp:259 AK::ByteString::to_uppercase.
pub func byte_string_to_uppercase(this: const ByteString*) -> ByteString:
    var has_lower = false
    for byte in byte_string_bytes(this):
        if is_ascii_lower_alpha(byte):
            has_lower = true
            break
    if not has_lower:
        return *this

    var buffer: u8*? = none
    let impl = byte_string_impl_create_uninitialized(byte_string_length(this), &buffer)
    let destination = buffer else trap("VERIFY: buffer")

    let characters = byte_string_bytes(this)
    for i in 0..<characters.length:
        destination[i] = (u8)to_ascii_uppercase(characters[i])

    return byte_string_from_impl(impl)

