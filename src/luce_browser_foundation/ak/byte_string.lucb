# mark: Comparison ==============================================================================

## Ported from AK/ByteString.cpp:19 AK::ByteString::operator==(ByteString const&).
pub func byte_string_eq_byte_string(this: const ByteString*, other: const ByteString*) -> bool:
    if this.m_impl == byte_string_impl(other):
        return true
    let view = byte_string_view(this)
    return string_view_eq_string_view(&view, byte_string_view(other))

## Ported from AK/ByteString.cpp:24 AK::ByteString::operator==(StringView).
pub func byte_string_eq_string_view(this: const ByteString*, other: StringView) -> bool:
    let view = byte_string_view(this)
    return string_view_eq_string_view(&view, other)

## Ported from AK/ByteString.cpp:29 AK::ByteString::operator<.
pub func byte_string_lt(this: const ByteString*, other: const ByteString*) -> bool:
    let view = byte_string_view(this)
    return string_view_lt(&view, byte_string_view(other))

## Ported from AK/ByteString.h:225 AK::ByteString::operator>=(ByteString const&).
pub func byte_string_ge_byte_string(this: const ByteString*, other: const ByteString*) -> bool:
    return not byte_string_lt(this, other)

## Ported from AK/ByteString.h:226 AK::ByteString::operator>=(char const*): `!(*this < other)`,
## with `other` converted to a ByteString.
pub func byte_string_ge_u8(this: const ByteString*, other: const u8*?) -> bool:
    var other_string = byte_string_empty()
    byte_string_construct_u8_should_chomp(&other_string, other)
    return not byte_string_lt(this, &other_string)

## Ported from AK/ByteString.cpp:34 AK::ByteString::operator>.
pub func byte_string_gt(this: const ByteString*, other: const ByteString*) -> bool:
    let view = byte_string_view(this)
    return string_view_gt(&view, byte_string_view(other))

## Ported from AK/ByteString.h:229 AK::ByteString::operator<=(ByteString const&).
pub func byte_string_le_byte_string(this: const ByteString*, other: const ByteString*) -> bool:
    return not byte_string_gt(this, other)

## Ported from AK/ByteString.h:230 AK::ByteString::operator<=(char const*).
pub func byte_string_le_u8(this: const ByteString*, other: const u8*?) -> bool:
    var other_string = byte_string_empty()
    byte_string_construct_u8_should_chomp(&other_string, other)
    return not byte_string_gt(this, &other_string)

## Ported from AK/ByteString.cpp:278 AK::ByteString::operator==(char const*).
pub func byte_string_eq_u8(this: const ByteString*, cstring: const u8*?) -> bool:
    if cstring == none:
        return byte_string_is_empty(this)

    let view = byte_string_view(this)
    return string_view_eq_u8_const(&view, cstring)

