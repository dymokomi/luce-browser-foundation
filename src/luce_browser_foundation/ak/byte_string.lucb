## Ported from AK/ByteString.cpp:137 AK::ByteString::to_byte_buffer.
pub func byte_string_to_byte_buffer(this: const ByteString*) -> ByteBuffer:
    # FIXME: Handle OOM failure.
    return byte_buffer_copy_span_u8(byte_string_bytes(this)) else trap("FIXME: should propagate errors")

## Ported from AK/ByteString.h:270 AK::ByteString::copy: a ByteString of a buffer's bytes.
pub func byte_string_copy(buffer: const u8[], should_chomp: ShouldChomp = ShouldChomp.no_chomp) -> ByteString:
    if buffer.length == 0:
        return byte_string_empty()
    var result = byte_string_empty()
    byte_string_construct_u8_usize(&result, buffer.data, buffer.length, should_chomp)
    return result

