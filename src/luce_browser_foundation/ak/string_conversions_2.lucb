#==============================================================================================
#
#   string_conversions_2 - parse_first_number, parse_number and parse_hexadecimal_number
#
#   DESCRIPTION:
#       Port of AK/StringConversions.cpp (lines 70-153) and the declarations of
#       AK/StringConversions.h (lines 1-51). The C++ templates are explicitly instantiated for
#       i8, i16, i32, long, long long, u8, u16, u32, unsigned long, unsigned long long, float and
#       double; here each instantiation is a function with the type as suffix (long and long long
#       are i64, the unsigned ones u64). Generated one-liners, in the .cpp's order.
#
#==============================================================================================

# mark: parse_first_number ====================================================================

## Ported from AK/StringConversions.cpp:70 AK::parse_first_number<i8>(StringView, TrimWhitespace, int):
## the i8 at the start of `string` and the characters it took.
pub func parse_first_number_string_view_i8(string: StringView, trim_whitespace: TrimWhitespace = TrimWhitespace.yes, base_: i32 = 10) -> ParseFirstNumberResult[i8]?:
    let trimmed = string_conversions_trim_string_view(string, trim_whitespace)
    let scanned = from_chars_integer(from_chars_input_bytes(string_view_bytes(&trimmed)), base_, true, 0x7f) else return none
    return ParseFirstNumberResult[i8](value = ((i8)(0 -% scanned.magnitude) if scanned.negative else (i8)scanned.magnitude), characters_parsed = scanned.characters_parsed)

