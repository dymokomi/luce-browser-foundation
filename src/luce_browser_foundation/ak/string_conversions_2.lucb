## Ported from AK/StringConversions.cpp:79 AK::parse_first_number<i8>(Utf16View const&, TrimWhitespace, int).
pub func parse_first_number_utf16_view_i8(string: Utf16View, trim_whitespace: TrimWhitespace = TrimWhitespace.yes, base_: i32 = 10) -> ParseFirstNumberResult[i8]?:
    if utf16_view_has_ascii_storage(&string):
        return parse_first_number_string_view_i8(string_view_from_bytes(utf16_view_bytes(&string)), trim_whitespace, base_)

    let trimmed_string = string_conversions_trim_utf16_view(string, trim_whitespace)
    let scanned = from_chars_integer(from_chars_input_code_units(utf16_view_utf16_span(&trimmed_string)), base_, true, 0x7f) else return none
    return ParseFirstNumberResult[i8](value = ((i8)(0 -% scanned.magnitude) if scanned.negative else (i8)scanned.magnitude), characters_parsed = scanned.characters_parsed)

