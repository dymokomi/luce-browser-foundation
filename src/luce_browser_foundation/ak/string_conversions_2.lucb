## Ported from AK/StringConversions.cpp:114 AK::parse_number<i8>(Utf16View const&, TrimWhitespace, int).
pub func parse_number_utf16_view_i8(string: Utf16View, trim_whitespace: TrimWhitespace = TrimWhitespace.yes, base_: i32 = 10) -> i8?:
    if utf16_view_has_ascii_storage(&string):
        return parse_number_string_view_i8(string_view_from_bytes(utf16_view_bytes(&string)), trim_whitespace, base_)

    let trimmed_string = string_conversions_trim_utf16_view(string, trim_whitespace)

    let result = parse_first_number_utf16_view_i8(trimmed_string, TrimWhitespace.no, base_) else return none

    if result.characters_parsed != utf16_view_length_in_code_units(&trimmed_string):
        return none

    return result.value

