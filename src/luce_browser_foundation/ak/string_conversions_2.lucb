# mark: parse_number ==========================================================================

## Ported from AK/StringConversions.cpp:98 AK::parse_number<i8>(StringView, TrimWhitespace, int):
## the i8 that is all of `string` (after trimming), or none.
pub func parse_number_string_view_i8(string: StringView, trim_whitespace: TrimWhitespace = TrimWhitespace.yes, base_: i32 = 10) -> i8?:
    let trimmed = string_conversions_trim_string_view(string, trim_whitespace)

    let result = parse_first_number_string_view_i8(trimmed, TrimWhitespace.no, base_) else return none

    if result.characters_parsed != string_view_length(&trimmed):
        return none

    return result.value

