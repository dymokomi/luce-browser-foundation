## Ported from AK/StringView.cpp:278 AK::StringView::to_byte_string.
pub func string_view_to_byte_string(this: const StringView*) -> ByteString:
    return byte_string_from_string_view(*this)

## Ported from AK/StringView.h:312 AK::StringView::is_whitespace.
