## Ported from AK/StringView.cpp:156 AK::StringView::matches(StringView, Vector<MaskSpan>&, CaseSensitivity).
pub func string_view_matches_vector(this: const StringView*, mask: StringView, mask_spans: Vector[MaskSpan]*, case_sensitivity: CaseSensitivity = CaseSensitivity.case_insensitive) -> bool:
