# mark: Substrings and splitting ================================================================

## Ported from AK/StringView.h:121 AK::StringView::substring_view(size_t, size_t).
pub func string_view_substring_view_usize(this: const StringView*, start: usize, length: usize) -> StringView:
    assert(start + length <= this.m_length)
    if let characters = this.m_characters:
        return StringView(m_characters = characters + start, m_length = length)
    return StringView(m_characters = none, m_length = length)

## Ported from AK/StringView.h:129 AK::StringView::substring_view(size_t).
pub func string_view_substring_view(this: const StringView*, start: usize) -> StringView:
    assert(start <= string_view_length(this))
    return string_view_substring_view_usize(this, start, string_view_length(this) - start)

## The lambda of StringView::split_view: appends each part to a vector.
struct StringViewSplitViewCollect: StringViewCallback:
    var parts: Vector[StringView]*

    mutating func call(part: StringView) -> IterationDecision!:
        vector_append_t(self.parts, part)
        return IterationDecision.continue_

## Ported from AK/StringView.cpp:47 AK::StringView::split_view(char, SplitBehavior).
pub func string_view_split_view_u8(this: const StringView*, separator: u8, split_behavior: SplitBehavior = SplitBehavior.nothing) -> Vector[StringView]:
    var separator_bytes: u8[1] = [separator]
    let separator_view = string_view_from_bytes(separator_bytes)
    return string_view_split_view_string_view(this, separator_view, split_behavior)

## Ported from AK/StringView.cpp:53 AK::StringView::split_view(StringView, SplitBehavior).
pub func string_view_split_view_string_view(this: const StringView*, separator: StringView, split_behavior: SplitBehavior = SplitBehavior.nothing) -> Vector[StringView]:
    var parts: Vector[StringView]
    var collect = StringViewSplitViewCollect(parts = &parts)
    string_view_for_each_split_view_string_view(this, separator, split_behavior, &collect) else trap("MUST: split_view")
    return parts

## Ported from AK/StringView.cpp:290 AK::StringView::split_view_if. The predicate is a
## CharPredicate (the C++ takes a Function<bool(char)>).
pub func string_view_split_view_if[P: CharPredicate](this: const StringView*, predicate: const P*, split_behavior: SplitBehavior = SplitBehavior.nothing) -> Vector[StringView]:
    var v: Vector[StringView]
    if string_view_is_empty(this):
        return v

    var substart: usize = 0
    let keep_empty = has_flag(split_behavior, SplitBehavior.keep_empty)
    let keep_separator = has_flag(split_behavior, SplitBehavior.keep_trailing_separator)
    let characters = string_view_bytes(this)
    for i in 0..<string_view_length(this):
        let ch = characters[i]
        if predicate.matches(ch):
            let sublen = i - substart
            if sublen != 0 or keep_empty:
                vector_append_t(&v, string_view_substring_view_usize(this, substart, sublen + 1 if keep_separator else sublen))
            substart = i + 1
    let taillen = string_view_length(this) - substart
    if taillen != 0 or keep_empty:
        vector_append_t(&v, string_view_substring_view_usize(this, substart, taillen))
    return v

## Ported from AK/StringView.h:142 AK::StringView::find_last_split_view.
pub func string_view_find_last_split_view(this: const StringView*, separator: u8) -> StringView:
    let begin = string_view_find_last_u8(this, separator) else return *this
    return string_view_substring_view(this, begin + 1)

## Ported from AK/StringView.h:150 AK::StringView::find_first_split_view.
pub func string_view_find_first_split_view(this: const StringView*, separator: u8) -> StringView:
    let needle_begin = string_view_find_u8(this, separator) else return *this
    return string_view_substring_view_usize(this, 0, needle_begin)

## Ported from AK/StringView.h:159 AK::StringView::for_each_split_view(char, SplitBehavior, Callback).
pub func string_view_for_each_split_view_u8[TCallback: StringViewCallback](this: const StringView*, separator: u8, split_behavior: SplitBehavior, callback: TCallback*) -> !:
    var separator_bytes: u8[1] = [separator]
    let separator_view = string_view_from_bytes(separator_bytes)
    try string_view_for_each_split_view_string_view(this, separator_view, split_behavior, callback)

## Ported from AK/StringView.h:166 AK::StringView::for_each_split_view(StringView, SplitBehavior,
## Callback). The callback answers IterationDecision and may fail; a failure propagates.
pub func string_view_for_each_split_view_string_view[TCallback: StringViewCallback](this: const StringView*, separator: StringView, split_behavior: SplitBehavior, callback: TCallback*) -> !:
    assert(not string_view_is_empty(&separator))
    if string_view_is_empty(this):
        return

    var view = *this
    var maybe_separator_index = string_view_find_string_view(&view, separator)
    let keep_empty = has_flag(split_behavior, SplitBehavior.keep_empty)
    let keep_separator = has_flag(split_behavior, SplitBehavior.keep_trailing_separator)
    while let separator_index = maybe_separator_index:
        let part_with_separator = string_view_substring_view_usize(&view, 0, separator_index + separator.m_length)
        if keep_empty or separator_index > 0:
            var part = part_with_separator
            if not keep_separator:
                part = string_view_substring_view_usize(&part_with_separator, 0, separator_index)
            if try callback.call(part) == IterationDecision.break_:
                return
        view = string_view_substring_view_starting_after_substring(&view, part_with_separator)
        maybe_separator_index = string_view_find_string_view(&view, separator)
    if keep_empty or not string_view_is_empty(&view):
        discard(try callback.call(view))

## The lambda of StringView::lines: appends each line to a vector.
struct StringViewLinesCollect: StringViewCallback:
    var lines: Vector[StringView]*

    mutating func call(part: StringView) -> IterationDecision!:
        vector_append_t(self.lines, part)
        return IterationDecision.continue_

## The lambda of StringView::count_lines: counts the lines.
struct StringViewCountLines: StringViewCallback:
    var lines: usize

    mutating func call(part: StringView) -> IterationDecision!:
        self.lines += 1
        return IterationDecision.continue_

## Ported from AK/StringView.cpp:104 AK::StringView::lines. Splits by line endings; as of
## CommonMark 0.29 a line ending is "a newline (U+000A), a carriage return (U+000D) not followed
## by a newline, or a carriage return and a following newline".
pub func string_view_lines(this: const StringView*, consider_carriage_return: StringViewConsiderCarriageReturn = StringViewConsiderCarriageReturn.yes) -> Vector[StringView]:
    var lines: Vector[StringView]
    if string_view_is_empty(this):
        return lines

    if consider_carriage_return == StringViewConsiderCarriageReturn.no:
        return string_view_split_view_u8(this, '\n', SplitBehavior.keep_empty)

    var collect = StringViewLinesCollect(lines = &lines)
    for_each_line(*this, &collect)

    return lines

## Ported from AK/StringView.cpp:118 AK::StringView::count_lines.
pub func string_view_count_lines(this: const StringView*, consider_carriage_return: StringViewConsiderCarriageReturn = StringViewConsiderCarriageReturn.yes) -> usize:
    if string_view_is_empty(this):
        return 1

    if consider_carriage_return == StringViewConsiderCarriageReturn.no:
        return string_view_count_u8(this, '\n') + 1

    var counter = StringViewCountLines(lines = 0)
    for_each_line(*this, &counter)

    return counter.lines

## Ported from AK/StringView.cpp:243 AK::StringView::substring_view_starting_from_substring:
## the rest of this view from the start of `substring`, which must be a view into this one.
pub func string_view_substring_view_starting_from_substring(this: const StringView*, substring: StringView) -> StringView:
    let remaining_characters = (usize)(substring.m_characters else trap("VERIFY: substring view"))
    let characters = (usize)(this.m_characters else trap("VERIFY: substring view"))
    assert(remaining_characters >= characters)
    assert(remaining_characters <= characters + this.m_length)
    let remaining_length = this.m_length - (remaining_characters - characters)
    return string_view_substring_view_usize(this, remaining_characters - characters, remaining_length)

## Ported from AK/StringView.cpp:252 AK::StringView::substring_view_starting_after_substring:
## the rest of this view after the end of `substring`, which must be a view into this one.
pub func string_view_substring_view_starting_after_substring(this: const StringView*, substring: StringView) -> StringView:
    let remaining_characters = (usize)(substring.m_characters else trap("VERIFY: substring view")) + substring.m_length
    let characters = (usize)(this.m_characters else trap("VERIFY: substring view"))
    assert(remaining_characters >= characters)
    assert(remaining_characters <= characters + this.m_length)
    let remaining_length = this.m_length - (remaining_characters - characters)
    return string_view_substring_view_usize(this, remaining_characters - characters, remaining_length)

## Ported from AK/StringView.cpp:261 AK::StringView::copy_characters_to_buffer: copies as much as
## fits and a NUL; answers whether everything fit.
pub func string_view_copy_characters_to_buffer(this: const StringView*, buffer: u8[]) -> bool:
    # We must fit at least the NUL-terminator.
    assert(buffer.length > 0)

    let characters_to_copy = this.m_length if this.m_length < buffer.length - 1 else buffer.length - 1
    copy_bytes(buffer, string_view_bytes(this)[..<characters_to_copy])
    buffer[characters_to_copy] = 0

    return characters_to_copy == this.m_length

# mark: Comparison ==============================================================================

## Ported from AK/StringView.h:256 AK::StringView::operator==(char const*): compares with a
## NUL-terminated string.
pub func string_view_eq_u8_const(this: const StringView*, cstring: const u8*?) -> bool:
    let cp = cstring else return false
    # NOTE: `m_characters` is not guaranteed to be null-terminated, but `cstring` is.
    let characters = string_view_bytes(this)
    for i in 0..<this.m_length:
        if cp[i] == 0:
            return false
        if characters[i] != cp[i]:
            return false
    return cp[this.m_length] == 0

## Ported from AK/StringView.h:271 AK::StringView::operator==(char).
pub func string_view_eq_u8_const_2(this: const StringView*, c_: u8) -> bool:
    return this.m_length == 1 and string_view_bytes(this)[0] == c_

## Ported from AK/StringView.cpp:273 AK::StringView::operator==(ByteString const&).
pub func string_view_eq_byte_string(this: const StringView*, string: ByteString) -> bool:
    return string_view_eq_string_view(this, byte_string_view(&string))

## Ported from AK/StringView.h:278 AK::StringView::compare.
pub func string_view_compare(this: const StringView*, other: StringView) -> i32:
    if this.m_length == 0 and other.m_length == 0:
        return 0

    let c_ = compare_bytes(string_view_bytes(this), string_view_bytes(&other))
    if c_ == 0:
        if string_view_length(this) < string_view_length(&other):
            return -1
        if string_view_length(this) == string_view_length(&other):
            return 0
        return 1
    return c_

## Ported from AK/StringView.h:295 AK::StringView::operator==(StringView).
pub func string_view_eq_string_view(this: const StringView*, other: StringView) -> bool:
    return string_view_length(this) == string_view_length(&other) and string_view_compare(this, other) == 0

## Ported from AK/StringView.h:300 AK::StringView::operator!=.
pub func string_view_ne(this: const StringView*, other: StringView) -> bool:
    return string_view_length(this) != string_view_length(&other) or string_view_compare(this, other) != 0

## Ported from AK/StringView.h:305 AK::StringView::operator<.
pub func string_view_lt(this: const StringView*, other: StringView) -> bool:
    return string_view_compare(this, other) < 0

## Ported from AK/StringView.h:306 AK::StringView::operator<=.
pub func string_view_le(this: const StringView*, other: StringView) -> bool:
    return string_view_compare(this, other) <= 0

## Ported from AK/StringView.h:307 AK::StringView::operator>.
pub func string_view_gt(this: const StringView*, other: StringView) -> bool:
    return string_view_compare(this, other) > 0

## Ported from AK/StringView.h:308 AK::StringView::operator>=.
pub func string_view_ge(this: const StringView*, other: StringView) -> bool:
    return string_view_compare(this, other) >= 0

## `view == "text"`: compares with a string literal (the C++'s `sv == "text"sv`).
pub func string_view_equals(this: const StringView*, text: str) -> bool:
    return string_view_eq_string_view(this, sv(text))

