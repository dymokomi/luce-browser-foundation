## The lambda of StringView::to_ascii_lowercase_string and to_ascii_uppercase_string: writes the
## view's bytes with ASCII case mapped.
struct StringViewToAsciiCaseCopy: BytesCallback:
    var source: const u8[]
    var to_uppercase: bool

    mutating func call(buffer: u8[]) -> !:
        for i in 0..<self.source.length:
            let character = (u32)self.source[i]
            buffer[i] = (u8)(to_ascii_uppercase(character) if self.to_uppercase else to_ascii_lowercase(character))

## Ported from AK/StringView.cpp:208 AK::StringView::to_ascii_lowercase_string.
pub func string_view_to_ascii_lowercase_string(this: const StringView*) -> String:
    let utf8 = Utf8View(m_string = *this)
    assert(utf8_view_validate_allow_lonely_surrogates(&utf8))

    var result = string_new()

    var copy = StringViewToAsciiCaseCopy(source = string_view_bytes(this), to_uppercase = false)
    string_base_replace_with_new_string_string_view(&result.string_base, string_view_length(this), &copy) else trap("MUST: to_ascii_lowercase_string")

    return result

## Ported from AK/StringView.cpp:223 AK::StringView::to_ascii_uppercase_string.
pub func string_view_to_ascii_uppercase_string(this: const StringView*) -> String:
    let utf8 = Utf8View(m_string = *this)
    assert(utf8_view_validate_allow_lonely_surrogates(&utf8))

    var result = string_new()

    var copy = StringViewToAsciiCaseCopy(source = string_view_bytes(this), to_uppercase = true)
    string_base_replace_with_new_string_string_view(&result.string_base, string_view_length(this), &copy) else trap("MUST: to_ascii_uppercase_string")

    return result

## Ported from AK/StringView.cpp:238 AK::StringView::to_ascii_titlecase_string.
pub func string_view_to_ascii_titlecase_string(this: const StringView*) -> String:
    return string_utils_to_titlecase(*this)

