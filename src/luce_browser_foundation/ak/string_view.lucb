## Ported from AK/StringView.h:357 AK::StringView::StringView(Badge<SentinelOptionalTraits>,
## nullptr_t): the view with no characters pointer.
pub func string_view_construct_string_view(this: StringView*):
    this.m_characters = none
    this.m_length = 0

# mark: Traits and literals =====================================================================

## Ported from AK/StringView.h:387 AK::CaseInsensitiveASCIIStringViewTraits::hash.
pub func case_insensitive_ascii_string_view_traits_hash(s: StringView) -> u32:
    if string_view_is_empty(&s):
        return 0
    return case_insensitive_string_hash(string_view_characters_without_null_termination(&s), string_view_length(&s))

## Ported from AK/StringView.h:393 AK::CaseInsensitiveASCIIStringViewTraits::equals.
pub func case_insensitive_ascii_string_view_traits_equals(a: StringView, b: StringView) -> bool:
    return string_view_equals_ignoring_ascii_case(&a, b)

## Ported from AK/StringView.h:398 operator""sv: a view of `length` characters.
pub func literalsv_u8(cstring: const u8*?, length: usize) -> StringView:
    var view = StringView()
    string_view_construct_u8_usize(&view, cstring, length)
    return view
