#==============================================================================================
#
#   string_view - StringView: a non-owning view of bytes (usually UTF-8)
#
#   DESCRIPTION:
#       Port of AK/StringView.h (lines 1-406) and AK/StringView.cpp (lines 1-314), in the
#       header's order with the .cpp bodies in place of their declarations.
#
#       StringView is `m_characters` + `m_length`. A zero-initialized view has no characters
#       pointer (the C++ default is ""); every accessor treats that as the empty view. The
#       `Optional<StringView>` sentinel (a null pointer) is not needed: `StringView?` is an
#       ordinary optional. Views of a String or FlyString take the owner by pointer, since a
#       short string's bytes live inside the owner.
#
#==============================================================================================

# mark: Construction ============================================================================

## Ported from AK/StringView.h:27 AK::StringView::StringView(char const*, size_t).
pub func string_view_construct_u8_usize(this: StringView*, characters: const u8*?, length: usize):
    this.m_characters = characters
    this.m_length = length
    assert(characters != none)

## Ported from AK/StringView.h:37 AK::StringView::StringView(unsigned char const*, size_t).
pub func string_view_construct_u8_usize_2(this: StringView*, characters: const u8*?, length: usize):
    this.m_characters = characters
    this.m_length = length
    assert(characters != none)

## Ported from AK/StringView.h:45 AK::StringView::StringView(ReadonlyBytes).
pub func string_view_construct_span_u8(this: StringView*, bytes: const u8[]):
    this.m_characters = "".bytes.data if bytes.length == 0 else bytes.data
    this.m_length = bytes.length

## Ported from AK/StringView.cpp:40 AK::StringView::StringView(ByteBuffer const&).
pub func string_view_construct_byte_buffer(this: StringView*, buffer: const ByteBuffer*):
    this.m_characters = byte_buffer_data_const(buffer)
    this.m_length = byte_buffer_size(buffer)
    assert(byte_buffer_data_const(buffer) != none)

## Ported from AK/StringView.cpp:22 AK::StringView::StringView(String const&).
pub func string_view_construct_string(this: StringView*, string: const String*):
    let bytes = string_base_bytes(&string.string_base)
    this.m_characters = bytes.data
    this.m_length = bytes.length

## Ported from AK/StringView.cpp:28 AK::StringView::StringView(FlyString const&).
pub func string_view_construct_fly_string(this: StringView*, string: const FlyString*):
    let bytes = fly_string_bytes(string)
    this.m_characters = bytes.data
    this.m_length = bytes.length

## Ported from AK/StringView.cpp:34 AK::StringView::StringView(ByteString const&).
pub func string_view_construct_byte_string(this: StringView*, string: ByteString):
    this.m_characters = byte_string_characters(&string)
    this.m_length = byte_string_length(&string)

## A view of `bytes` (the value form of StringView(ReadonlyBytes)).
pub func string_view_from_bytes(bytes: const u8[]) -> StringView:
    var view = StringView()
    string_view_construct_span_u8(&view, bytes)
    return view

## `"text"sv`: a view of a string literal or any other `str` (DESIGN.md §2.6).
pub func sv(text: str) -> StringView:
    return StringView(m_characters = text.bytes.data, m_length = text.length)

## Ported from AK/StringView.cpp:63 AK::for_each_line: calls back with each line of `string`
## split at "\n", "\r" and "\r\n".
func for_each_line[TCallback: StringViewCallback](string: StringView, callback: TCallback*):
    let characters = string_view_bytes(&string)

    var substart: usize = 0
    var last_ch_was_cr = false

    for i in 0..<characters.length:
        let ch = characters[i]
        var split_view = false

        match ch:
            '\n':
                if last_ch_was_cr:
                    substart = i + 1
                else:
                    split_view = true

                last_ch_was_cr = false
            '\r':
                split_view = true
                last_ch_was_cr = true
            _:
                last_ch_was_cr = false

        if split_view:
            discard(callback.call(string_view_substring_view_usize(&string, substart, i - substart)) else trap("MUST: for_each_line"))
            substart = i + 1

    let taillen = string.m_length - substart
    if taillen != 0:
        discard(callback.call(string_view_substring_view_usize(&string, substart, taillen)) else trap("MUST: for_each_line"))

# mark: Accessors ===============================================================================

## Ported from AK/StringView.h:64 AK::StringView::is_empty.
pub func string_view_is_empty(this: const StringView*) -> bool:
    return this.m_length == 0

## Ported from AK/StringView.h:66 AK::StringView::characters_without_null_termination.
pub func string_view_characters_without_null_termination(this: const StringView*) -> const u8*?:
    return this.m_characters

## Ported from AK/StringView.h:67 AK::StringView::length.
pub func string_view_length(this: const StringView*) -> usize:
    return this.m_length

## Ported from AK/StringView.h:69 AK::StringView::bytes.
pub func string_view_bytes(this: const StringView*) -> const u8[]:
    if let characters = this.m_characters:
        return u8[]((u8*)characters, this.m_length)
    return b""

## Ported from AK/StringView.h:71 AK::StringView::operator[].
pub func string_view_at(this: const StringView*, index: usize) -> u8:
    assert(index < this.m_length)
    return string_view_bytes(this)[index]

## Ported from AK/StringView.h:81 AK::StringView::begin.
pub func string_view_begin(this: const StringView*) -> SimpleIterator[StringView, u8]:
    return SimpleIterator[StringView, u8](m_container = (StringView*)this, m_index = 0)

## Ported from AK/StringView.h:82 AK::StringView::end.
pub func string_view_end(this: const StringView*) -> SimpleIterator[StringView, u8]:
    return SimpleIterator[StringView, u8](m_container = (StringView*)this, m_index = this.m_length)

## Ported from AK/StringView.h:84 AK::StringView::hash.
pub func string_view_hash(this: const StringView*) -> u32:
    if string_view_is_empty(this):
        return 0
    return string_hash(string_view_characters_without_null_termination(this), string_view_length(this))

