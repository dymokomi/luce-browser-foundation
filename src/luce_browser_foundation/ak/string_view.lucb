## Ported from AK/StringView.cpp:166 AK::StringView::contains(char).
pub func string_view_contains_u8(this: const StringView*, needle: u8) -> bool:
    for current in string_view_bytes(this):
        if current == needle:
            return true
    return false

## Ported from AK/StringView.cpp:175 AK::StringView::contains(u32).
pub func string_view_contains_u32(this: const StringView*, needle: u32) -> bool:
    # A code point should be at most four UTF-8 bytes, which easily fits into StringBuilder's
    # inline-buffer. Therefore, this will not allocate.
    var needle_builder = string_builder_new()
    string_builder_try_append_code_point(&needle_builder, needle) catch:
        # The needle is invalid, therefore the string does not contain it.
        return false

    return string_view_contains_string_view(this, string_builder_string_view(&needle_builder))

## Ported from AK/StringView.cpp:189 AK::StringView::contains(StringView, CaseSensitivity).
pub func string_view_contains_string_view(this: const StringView*, needle: StringView, case_sensitivity: CaseSensitivity = CaseSensitivity.case_sensitive) -> bool:
    if needle.m_length == 1:
        return string_view_contains_u8(this, string_view_bytes(&needle)[0])
    return string_utils_contains(*this, needle, case_sensitivity)

## Ported from AK/StringView.cpp:196 AK::StringView::equals_ignoring_ascii_case.
pub func string_view_equals_ignoring_ascii_case(this: const StringView*, other: StringView) -> bool:
    return string_utils_equals_ignoring_ascii_case(*this, other)

## Ported from AK/StringView.cpp:201 AK::StringView::is_ascii.
pub func string_view_is_ascii(this: const StringView*) -> bool:
    if string_view_is_empty(this):
        return true
    return simdutf_validate_ascii(string_view_bytes(this))

## Ported from AK/StringView.h:103 AK::StringView::trim.
pub func string_view_trim(this: const StringView*, characters: StringView, mode: TrimMode = TrimMode.both) -> StringView:
    return string_utils_trim(*this, characters, mode)

## Ported from AK/StringView.h:104 AK::StringView::trim_whitespace.
pub func string_view_trim_whitespace(this: const StringView*, mode: TrimMode = TrimMode.both) -> StringView:
