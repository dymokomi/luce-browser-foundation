## Ported from AK/StringView.cpp:132 AK::StringView::starts_with(char).
pub func string_view_starts_with_u8(this: const StringView*, ch: u8) -> bool:
    if string_view_is_empty(this):
        return false
    return ch == string_view_bytes(this)[0]

## Ported from AK/StringView.cpp:144 AK::StringView::ends_with(char).
pub func string_view_ends_with_u8(this: const StringView*, ch: u8) -> bool:
    if string_view_is_empty(this):
        return false
    return ch == string_view_bytes(this)[string_view_length(this) - 1]

## Ported from AK/StringView.cpp:161 AK::StringView::matches(StringView, CaseSensitivity).
pub func string_view_matches_case_sensitivity(this: const StringView*, mask: StringView, case_sensitivity: CaseSensitivity = CaseSensitivity.case_insensitive) -> bool:
