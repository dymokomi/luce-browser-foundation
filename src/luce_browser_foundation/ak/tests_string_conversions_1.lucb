#==============================================================================================
#
#   tests_string_conversions_1 - parse_number over doubles and floats (generated cases)
#
#   DESCRIPTION:
#       Port of the simple_cases test of Tests/AK/TestStringConversions.cpp. Each C++
#       DOES_PARSE_*_LIKE_CPP(value) became a check that parse_number of the text and of "-"
#       and the text, over a StringView and over UTF-16 storage, gives the bits the C++
#       compiler gives the literal (computed exactly when the cases were generated).
#
#       Each test's body is a noinline function the test block calls, so that the test
#       runner's `main` does not inline every body (# workaround:
#       compiler-issues/ranges_facts_cubic).
#
#==============================================================================================

## `u"text"sv`: a Utf16View with UTF-16 storage of ASCII text (the code units live in `storage`).
func test_conversions_utf16(text: str, storage: u16[]) -> Utf16View:
    for i in 0..<text.length:
        storage[i] = text.bytes[i]
    return utf16_view_from_utf16(storage[..<text.length])

## DOES_PARSE_DOUBLE_LIKE_CPP: `text` and "-" `text` parse to `bits` and its negation.
func test_parse_double(text: str, bits: u64):
    with memory.heap:
        var negative_text = new u8[text.length + 1] else trap("out of memory")
        negative_text[0] = '-'
        copy_bytes(negative_text[1..], text.bytes)
        let negative = (str)negative_text
        let negative_bits = bits ^ 0x8000000000000000

        assert((parse_number_string_view_f64(sv(text), TrimWhitespace.no) else trap("parse")).bits() == bits)
        assert((parse_number_string_view_f64(sv(negative), TrimWhitespace.no) else trap("parse")).bits() == negative_bits)

        let storage = new u16[text.length + 1] else trap("out of memory")
        assert((parse_number_utf16_view_f64(test_conversions_utf16(text, storage), TrimWhitespace.no) else trap("parse")).bits() == bits)
        assert((parse_number_utf16_view_f64(test_conversions_utf16(negative, storage), TrimWhitespace.no) else trap("parse")).bits() == negative_bits)

## DOES_PARSE_FLOAT_LIKE_CPP: the same for float.
func test_parse_float(text: str, bits: u32):
    with memory.heap:
        var negative_text = new u8[text.length + 1] else trap("out of memory")
        negative_text[0] = '-'
        copy_bytes(negative_text[1..], text.bytes)
        let negative = (str)negative_text
        let negative_bits = bits ^ 0x80000000

        assert((parse_number_string_view_f32(sv(text), TrimWhitespace.no) else trap("parse")).bits() == bits)
        assert((parse_number_string_view_f32(sv(negative), TrimWhitespace.no) else trap("parse")).bits() == negative_bits)

        let storage = new u16[text.length + 1] else trap("out of memory")
        assert((parse_number_utf16_view_f32(test_conversions_utf16(text, storage), TrimWhitespace.no) else trap("parse")).bits() == bits)

test "StringConversions: simple_cases (part 1)":
    test_stringconversions_simple_cases_part_1()

noinline func test_stringconversions_simple_cases_part_1():
    test_parse_double("2.22507385850720138309e-308", 0x10000000000000)
    test_parse_double("10090518465521146875.", 0x43e1811722a41d0b)
    test_parse_float("10090518465521146875.", 0x5f0c08b9)
    test_parse_double("10052108125844341766.", 0x43e1700862a098a1)
    test_parse_float("10052108125844341766.", 0x5f0b8043)
    test_parse_double("0.", 0x0)
    test_parse_float("0.", 0x0)
    test_parse_double("2.2222222222223e-322", 0x2d)
    test_parse_double("2.2250738585072013e-308", 0x10000000000000)
    test_parse_double("1.0", 0x3ff0000000000000)
    test_parse_float("1.0", 0x3f800000)
    test_parse_double("0.54e-85", 0x2e3adaff1563baa9)
    test_parse_double("123", 0x405ec00000000000)
    test_parse_double("1e10", 0x4202a05f20000000)
    test_parse_double("001234.0", 0x4093480000000000)
    test_parse_float("001234.0", 0x449a4000)
    test_parse_double("123.456", 0x405edd2f1a9fbe77)
    test_parse_float("123.456", 0x42f6e979)
    test_parse_double("0.456", 0x3fdd2f1a9fbe76c9)
    test_parse_float("0.456", 0x3ee978d5)
    test_parse_double("0.45689544977495495495197116546843576574949654", 0x3fdd3dc6699e6089)
    test_parse_float("0.45689544977495495495197116546843576574949654", 0x3ee9ee33)
    test_parse_double("0.45689544977495495495197116546843576574949654e81", 0x50aed3a6f8b79f2d)
    test_parse_double("0.45689544977495495495197116546843576574949654e-81", 0x2f0bbcc5ca4ebbe9)
    test_parse_double("7.2057594037927933e+8", 0x41c5798ee2308c3a)
    test_parse_float("7.2057594037927933e+8", 0x4e2bcc77)
    test_parse_double("234532.3426362", 0x410ca122bdb80c4b)
    test_parse_float("234532.3426362", 0x48650916)
    test_parse_double("860228122.6654514319E+90", 0x54792bb20990715f)
    test_parse_double("69294956446009195", 0x436ec5eca9f618ed)

