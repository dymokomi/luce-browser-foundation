#==============================================================================================
#
#   math_1 - AK's floating-point math: constants, rounding, division, roots, trigonometry
#
#   DESCRIPTION:
#       Port of AK/Math.h (lines 1-735). Every template over FloatingPoint is instantiated
#       for f32 and f64 with the type as a suffix (`sqrt_f64`), since luce-base generics
#       cannot compute on a type parameter; `long double` is f64. Where the donor has
#       per-architecture assembly, the port takes the branch the reference build (AArch64)
#       runs or its libm equivalent (luce-std `math`/`math32`); the functions the donor
#       computes itself at run time (round, cbrt, asin, acos, log2, pow, the hyperbolic
#       functions) keep their formulas, with float instantiations widening to f64 where
#       the C++ mixes in `long double` literals.
#
#==============================================================================================

extern func c_rint as "rint"(x: f64) -> f64
extern func c_rintf as "rintf"(x: f32) -> f32

# mark: Constants ===============================================================================

## AK::NaN<float>.
pub let nan_f32: f32 = f32.bits(0x7fc00000)
## AK::NaN<double>.
pub let nan_f64: f64 = f64.bits(0x7ff8000000000000)
## AK::Infinity<float>.
pub let infinity_f32: f32 = f32.bits(0x7f800000)
## AK::Infinity<double>.
pub let infinity_f64: f64 = f64.bits(0x7ff0000000000000)
## AK::Pi<float>.
pub let pi_f32: f32 = (f32)3.141592653589793238462643383279502884f64
## AK::Pi<double>.
pub let pi_f64: f64 = 3.141592653589793238462643383279502884
## AK::E<float>.
pub let e_f32: f32 = (f32)2.718281828459045235360287471352662498f64
## AK::E<double>.
pub let e_f64: f64 = 2.718281828459045235360287471352662498
## AK::Sqrt2<float>.
pub let sqrt2_f32: f32 = (f32)1.414213562373095048801688724209698079f64
## AK::Sqrt2<double>.
pub let sqrt2_f64: f64 = 1.414213562373095048801688724209698079
## AK::Sqrt1_2<float>.
pub let sqrt1_2_f32: f32 = (f32)0.707106781186547524400844362104849039f64
## AK::Sqrt1_2<double>.
pub let sqrt1_2_f64: f64 = 0.707106781186547524400844362104849039
## AK::L2_10<float>.
pub let l2_10_f32: f32 = (f32)3.321928094887362347870319429489390175864f64
## AK::L2_10<double>.
pub let l2_10_f64: f64 = 3.321928094887362347870319429489390175864
## AK::L2_E<float>.
pub let l2_e_f32: f32 = (f32)1.442695040888963407359924681001892137f64
## AK::L2_E<double>.
pub let l2_e_f64: f64 = 1.442695040888963407359924681001892137

# mark: Details =================================================================================

## Ported from AK/Math.h:42 AK::Details::product_even: `value * (value - 2) * ... * 2` for an
## even `value` (the template argument becomes a parameter).
pub func details_product_even_x(value: usize) -> usize:
    if value == 2:
        return 2
    return value * details_product_even_x(value - 2)

## Ported from AK/Math.h:49 AK::Details::product_odd: `value * (value - 2) * ... * 1` for an
## odd `value`.
pub func details_product_odd_x(value: usize) -> usize:
    if value == 1:
        return 1
    return value * details_product_odd_x(value - 2)

# mark: Degrees, fabs, rounding, division, roots, trigonometry ==================================

## Ported from AK/Math.h:56 AK::to_radians, for f32.
pub func to_radians_f32(degrees: f32) -> f32:
    return degrees * pi_f32 / 180.0

## Ported from AK/Math.h:56 AK::to_radians, for f64.
pub func to_radians_f64(degrees: f64) -> f64:
    return degrees * pi_f64 / 180.0

## Ported from AK/Math.h:62 AK::to_degrees, for f32.
pub func to_degrees_f32(radians: f32) -> f32:
    return radians * 180.0 / pi_f32

## Ported from AK/Math.h:62 AK::to_degrees, for f64.
pub func to_degrees_f64(radians: f64) -> f64:
    return radians * 180.0 / pi_f64

## Ported from AK/Math.h:96 AK::fabs, for f32.
# Both GCC and Clang inline fabs by default, so this is just a cmath like wrapper
pub func fabs_f32(x: f32) -> f32:
    return math32.abs(x)

## Ported from AK/Math.h:96 AK::fabs, for f64.
# Both GCC and Clang inline fabs by default, so this is just a cmath like wrapper
pub func fabs_f64(x: f64) -> f64:
    return math.abs(x)

