## Ported from AK/Math.h:476 AK::sqrt, for f32 (the fsqrt branch).
pub func sqrt_f32(x: f32) -> f32:
    return math32.sqrt(x)

## Ported from AK/Math.h:476 AK::sqrt, for f64 (the fsqrt branch).
pub func sqrt_f64(x: f64) -> f64:
    return math.sqrt(x)

## Ported from AK/Math.h:508 AK::cbrt, for f32.
pub func cbrt_f32(x: f32) -> f32:
    if math32.is_infinite(x) or x == 0.0:
        return x
    if x < 0.0:
        return -cbrt_f32(-x)

    var r = x
    var ex: f32 = 0.0

    while (f64)(r) < 0.125:
        r *= 8.0
        ex -= 1.0
    while (f64)(r) > 1.0:
        r = (f32)((f64)(r) * 0.125)
        ex += 1.0

    r = (f32)((-0.46946116 * (f64)(r) + 1.072302) * (f64)(r) + 0.3812513)

    while ex < 0.0:
        r = (f32)((f64)(r) * 0.5)
        ex += 1.0
    while ex > 0.0:
        r = (f32)((f64)(r) * 2.0)
        ex -= 1.0

    r = (f32)((2.0 / 3.0) * (f64)(r) + (1.0 / 3.0) * (f64)(x) / (f64)(r * r))
    r = (f32)((2.0 / 3.0) * (f64)(r) + (1.0 / 3.0) * (f64)(x) / (f64)(r * r))
    r = (f32)((2.0 / 3.0) * (f64)(r) + (1.0 / 3.0) * (f64)(x) / (f64)(r * r))
    r = (f32)((2.0 / 3.0) * (f64)(r) + (1.0 / 3.0) * (f64)(x) / (f64)(r * r))

    return r

## Ported from AK/Math.h:508 AK::cbrt, for f64.
pub func cbrt_f64(x: f64) -> f64:
    if math.is_infinite(x) or x == 0.0:
        return x
    if x < 0.0:
        return -cbrt_f64(-x)

    var r = x
    var ex: f64 = 0.0

    while r < 0.125:
        r *= 8.0
        ex -= 1.0
    while r > 1.0:
        r = r * 0.125
        ex += 1.0

    r = (-0.46946116 * r + 1.072302) * r + 0.3812513

    while ex < 0.0:
        r = r * 0.5
        ex += 1.0
    while ex > 0.0:
        r = r * 2.0
        ex -= 1.0

    r = (2.0 / 3.0) * r + (1.0 / 3.0) * x / (r * r)
    r = (2.0 / 3.0) * r + (1.0 / 3.0) * x / (r * r)
    r = (2.0 / 3.0) * r + (1.0 / 3.0) * x / (r * r)
    r = (2.0 / 3.0) * r + (1.0 / 3.0) * x / (r * r)

    return r

## Ported from AK/Math.h:550 AK::Trigonometry::hypot, for f32.
pub func trigonometry_hypot_f32(x: f32, y: f32) -> f32:
    return sqrt_f32(x * x + y * y)

## Ported from AK/Math.h:550 AK::Trigonometry::hypot, for f64.
pub func trigonometry_hypot_f64(x: f64, y: f64) -> f64:
    return sqrt_f64(x * x + y * y)

## Ported from AK/Math.h:556 AK::Trigonometry::sin, for f32.
pub func trigonometry_sin_f32(angle: f32) -> f32:
    return math32.sin(angle)

## Ported from AK/Math.h:556 AK::Trigonometry::sin, for f64.
pub func trigonometry_sin_f64(angle: f64) -> f64:
    return math.sin(angle)

## Ported from AK/Math.h:579 AK::Trigonometry::cos, for f32.
pub func trigonometry_cos_f32(angle: f32) -> f32:
    return math32.cos(angle)

## Ported from AK/Math.h:579 AK::Trigonometry::cos, for f64.
pub func trigonometry_cos_f64(angle: f64) -> f64:
    return math.cos(angle)

## Ported from AK/Math.h:602 AK::Trigonometry::sincos, for f32.
pub func trigonometry_sincos_f32(angle: f32, sin_val: f32*, cos_val: f32*):
    *sin_val = trigonometry_sin_f32(angle)
    *cos_val = trigonometry_cos_f32(angle)

## Ported from AK/Math.h:602 AK::Trigonometry::sincos, for f64.
pub func trigonometry_sincos_f64(angle: f64, sin_val: f64*, cos_val: f64*):
    *sin_val = trigonometry_sin_f64(angle)
    *cos_val = trigonometry_cos_f64(angle)

## Ported from AK/Math.h:621 AK::Trigonometry::tan, for f32.
pub func trigonometry_tan_f32(angle: f32) -> f32:
    return math32.tan(angle)

## Ported from AK/Math.h:621 AK::Trigonometry::tan, for f64.
pub func trigonometry_tan_f64(angle: f64) -> f64:
    return math.tan(angle)

## Ported from AK/Math.h:645 AK::Trigonometry::atan, for f32.
pub func trigonometry_atan_f32(value: f32) -> f32:
    return math32.atan(value)

## Ported from AK/Math.h:645 AK::Trigonometry::atan, for f64.
pub func trigonometry_atan_f64(value: f64) -> f64:
    return math.atan(value)

## Ported from AK/Math.h:667 AK::Trigonometry::asin, for f32.
pub func trigonometry_asin_f32(x: f32) -> f32:
    if x > 1.0 or x < -1.0:
        return nan_f32
    if x > (f32)0.5f64 or x < (f32)-0.5f64:
        return 2.0 * trigonometry_atan_f32(x / (1.0 + sqrt_f32(1.0 - x * x)))
    let squared = x * x
    var value = x
    var i = x * squared
    value += i * (f32)details_product_odd_x(1) / (f32)details_product_even_x(2) / 3.0
    i *= squared
    value += i * (f32)details_product_odd_x(3) / (f32)details_product_even_x(4) / 5.0
    i *= squared
    value += i * (f32)details_product_odd_x(5) / (f32)details_product_even_x(6) / 7.0
    i *= squared
    value += i * (f32)details_product_odd_x(7) / (f32)details_product_even_x(8) / 9.0
    i *= squared
    value += i * (f32)details_product_odd_x(9) / (f32)details_product_even_x(10) / 11.0
    i *= squared
    value += i * (f32)details_product_odd_x(11) / (f32)details_product_even_x(12) / 13.0
    i *= squared
    value += i * (f32)details_product_odd_x(13) / (f32)details_product_even_x(14) / 15.0
    i *= squared
    value += i * (f32)details_product_odd_x(15) / (f32)details_product_even_x(16) / 17.0
    return value

## Ported from AK/Math.h:667 AK::Trigonometry::asin, for f64.
pub func trigonometry_asin_f64(x: f64) -> f64:
    if x > 1.0 or x < -1.0:
        return nan_f64
    if x > 0.5 or x < -0.5:
        return 2.0 * trigonometry_atan_f64(x / (1.0 + sqrt_f64(1.0 - x * x)))
    let squared = x * x
    var value = x
    var i = x * squared
    value += i * (f64)details_product_odd_x(1) / (f64)details_product_even_x(2) / 3.0
    i *= squared
    value += i * (f64)details_product_odd_x(3) / (f64)details_product_even_x(4) / 5.0
    i *= squared
    value += i * (f64)details_product_odd_x(5) / (f64)details_product_even_x(6) / 7.0
    i *= squared
    value += i * (f64)details_product_odd_x(7) / (f64)details_product_even_x(8) / 9.0
    i *= squared
    value += i * (f64)details_product_odd_x(9) / (f64)details_product_even_x(10) / 11.0
    i *= squared
    value += i * (f64)details_product_odd_x(11) / (f64)details_product_even_x(12) / 13.0
    i *= squared
    value += i * (f64)details_product_odd_x(13) / (f64)details_product_even_x(14) / 15.0
    i *= squared
    value += i * (f64)details_product_odd_x(15) / (f64)details_product_even_x(16) / 17.0
    return value

## Ported from AK/Math.h:696 AK::Trigonometry::acos, for f32.
pub func trigonometry_acos_f32(value: f32) -> f32:
    # FIXME: I am naive
    return 0.5 * pi_f32 - trigonometry_asin_f32(value)

## Ported from AK/Math.h:696 AK::Trigonometry::acos, for f64.
pub func trigonometry_acos_f64(value: f64) -> f64:
    # FIXME: I am naive
    return 0.5 * pi_f64 - trigonometry_asin_f64(value)

## Ported from AK/Math.h:705 AK::Trigonometry::atan2, for f32.
pub func trigonometry_atan2_f32(y: f32, x: f32) -> f32:
    return math32.atan2(y, x)

## Ported from AK/Math.h:705 AK::Trigonometry::atan2, for f64.
pub func trigonometry_atan2_f64(y: f64, x: f64) -> f64:
    return math.atan2(y, x)
