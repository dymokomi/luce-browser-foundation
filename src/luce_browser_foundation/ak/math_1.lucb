## Ported from AK/Math.h:174 AK::Rounding::rint, for f32.
# Note: This does break tie to even (frintx/roundsd in the default rounding mode).
pub func rounding_rint_f32(x: f32) -> f32:
    return c_rintf(x)

## Ported from AK/Math.h:174 AK::Rounding::rint, for f64.
# Note: This does break tie to even (frintx/roundsd in the default rounding mode).
pub func rounding_rint_f64(x: f64) -> f64:
    return c_rint(x)

## Ported from AK/Math.h:216 AK::Rounding::round, for f32.
pub func rounding_round_f32(x: f32) -> f32:
    # Note: This is break-tie-away-from-zero, so not the hw's understanding of
    #       "nearest", which would be towards even.
    if x == 0.0:
        return x
    if x > 0.0:
        return rounding_floor_f32(x + 0.5)
    return rounding_ceil_f32(x - 0.5)

## Ported from AK/Math.h:216 AK::Rounding::round, for f64.
pub func rounding_round_f64(x: f64) -> f64:
    # Note: This is break-tie-away-from-zero, so not the hw's understanding of
    #       "nearest", which would be towards even.
    if x == 0.0:
        return x
    if x > 0.0:
        return rounding_floor_f64(x + 0.5)
    return rounding_ceil_f64(x - 0.5)

