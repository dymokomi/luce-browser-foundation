# mark: Traits and literals =====================================================================

## Ported from AK/String.h:273 AK::ASCIICaseInsensitiveStringTraits::hash.
pub func ascii_case_insensitive_string_traits_hash(s: const String*) -> u32:
    return string_ascii_case_insensitive_hash(s)

## Ported from AK/String.h:274 AK::ASCIICaseInsensitiveStringTraits::equals.
pub func ascii_case_insensitive_string_traits_equals(a: const String*, b: const String*) -> bool:
    let a_view = string_bytes_as_string_view(a)
    return string_view_equals_ignoring_ascii_case(&a_view, string_bytes_as_string_view(b))

## Ported from AK/String.h:279 operator""_string: short ASCII literals become short strings
## without validation; anything else must be valid UTF-8.
pub func literalstring(cstring: const u8*?, length: usize) -> String:
    let view = literalsv_u8(cstring, length)
    let bytes = string_view_bytes(&view)
    # OPTIMIZATION: Short ASCII strings become compile-time constants with no runtime validation
    # or heap allocation.
    if length <= max_short_string_byte_count and simdutf_validate_ascii(bytes):
        return string_from_ascii_short_string_without_validation(bytes)

    let utf8 = Utf8View(m_string = view)
    assert(utf8_view_validate_allow_lonely_surrogates(&utf8))
    return string_from_utf8_without_validation(bytes)
