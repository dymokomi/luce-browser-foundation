## AK::Traits<String>: AK's hash and equality for the key type.
pub struct StringTraits: Traits[String]:
    var empty_: u8

    func hash_of(key: const String*) -> u32: return string_hash_value(key)

    func equals(a: const String*, b: const String*) -> bool: return string_equals(a, b)

