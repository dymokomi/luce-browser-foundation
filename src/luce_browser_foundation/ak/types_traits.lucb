## AK::Traits<FlyString>: AK's hash and equality for the key type.
pub struct FlyStringTraits: Traits[FlyString]:
    var empty_: u8

    func hash_of(key: const FlyString*) -> u32: return fly_string_hash(key)

    func equals(a: const FlyString*, b: const FlyString*) -> bool: return fly_string_eq_fly_string(a, b)

