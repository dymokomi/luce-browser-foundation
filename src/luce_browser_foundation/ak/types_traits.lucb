## AK::Traits<Utf16String>: AK's hash and equality for the key type.
pub struct Utf16StringTraits: Traits[Utf16String]:
    var empty_: u8

    func hash_of(key: const Utf16String*) -> u32: return utf16_string_base_hash(&key.utf16_string_base)

    func equals(a: const Utf16String*, b: const Utf16String*) -> bool: return utf16_string_base_eq_utf16_string_base(&a.utf16_string_base, &b.utf16_string_base)
