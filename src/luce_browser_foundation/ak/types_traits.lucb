## AK::Traits<FlyString>: AK's hash and equality for the key type.
pub struct FlyStringTraits: Traits[FlyString]:
    var empty_: u8

    func hash_of(key: const FlyString*) -> u32: trap("unported: AK::Traits<FlyString>::hash")

    func equals(a: const FlyString*, b: const FlyString*) -> bool: trap("unported: AK::Traits<FlyString>::equals")

## AK::Traits<i32>: AK's hash and equality for the key type.
pub struct I32Traits: Traits[i32]:
    var empty_: u8

    func hash_of(key: const i32*) -> u32: return u32_hash((u32)*key)

    func equals(a: const i32*, b: const i32*) -> bool: return *a == *b

