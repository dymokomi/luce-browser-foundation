#==============================================================================================
#
#   types_variants - Variant<...> instantiations as payload enums
#
#   DESCRIPTION:
#       Generated by the skeleton generator (DESIGN.md §2.6): one declaration per distinct
#       instantiation the phase-1 declarations use, at donor commit 47c82b38d0. The ICU
#       Variant<Empty, String, icu::UnicodeString> was dropped at integration: web_unicode
#       replaces ICU (region r07) and nothing uses it.
#
#==============================================================================================

## AK::Variant<...> (no alias).
pub enum BoolOrF64OrStringOrEmpty:
    bool_(value: bool)
    f64_(value: f64)
    string(value: String)
    empty

## AK::Variant<...> (no alias).
pub enum ByteBufferOrCoreResource:
    byte_buffer(value: ByteBuffer)
    core_resource(value: const CoreResource*)

## AK::Variant<...> (URL::Host::VariantType).
pub enum HostVariantType:
    i_pv4_address(value: IPv4Address)
    i_pv6_address(value: IPv6Address)
    string(value: String)

## AK::Variant<...> (Web::Infra::JSONBaseValue).
pub enum JsonBaseValue:
    empty
    u16_(value: u16)
    u32_(value: u32)
    bool_(value: bool)
    string(value: String)

## AK::Variant<...> (Web::Infra::JSONValue).
pub enum JsonValue:
    json_base_value(value: JsonBaseValue)
    vector_json_base_value(value: Vector[JsonBaseValue])

## AK::Variant<...> (AK::JsonValue::Storage).
pub enum JsonValueStorage:
    empty
    bool_(value: bool)
    i64_(value: i64)
    u64_(value: u64)
    f64_(value: f64)
    string(value: String)
    json_array(value: JsonArray*)
    json_object(value: JsonObject*)

## AK::Variant<...> (Web::IndexedDB::KeyPath).
pub enum KeyPath:
    string(value: String)
    vector_string(value: Vector[String])

## AK::Variant<...> (no alias).
pub enum StringOrEmpty:
    string(value: String)
    empty

## AK::Variant<...> (no alias).
pub enum StringOrStringView:
    string(value: String)
    string_view(value: StringView)

## AK::Variant<...> (no alias).
pub enum U32OrUtf16String:
    u32_(value: u32)
    utf16_string(value: Utf16String)

## AK::Variant<...> (no alias).
pub enum U32OrVectorU32:
    u32_(value: u32)
    vector_u32(value: Vector[u32])

## AK::Variant<...> (no alias).
pub enum U64OrI64OrF64:
