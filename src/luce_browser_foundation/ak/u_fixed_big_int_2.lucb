## Ported from AK/UFixedBigInt.h:441 AK::Detail::UFixedBigInt::operator/=(IntegerWrapper).
pub func u_fixed_big_int_div_assign_integer_wrapper[TStorage](this: UFixedBigInt[TStorage]*, other: IntegerWrapper) -> UFixedBigInt[TStorage]*:
