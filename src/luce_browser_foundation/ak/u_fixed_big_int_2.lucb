# mark: Arithmetic ==============================================================================

## Ported from AK/UFixedBigInt.h:349 AK::Detail::UFixedBigInt::addc: this + other + carry, the
## carry out stored back.
pub func u_fixed_big_int_addc[TStorage, T](this: const UFixedBigInt[TStorage]*, other: T, carry: bool*) -> UFixedBigInt[TStorage]:
    assert(sizeof(T) <= sizeof(TStorage))
    var result: UFixedBigInt[TStorage] = ---
    var small: u64
    *carry = storage_add(false, fbi_words(this), storage_of(&other, &small), fbi_words(&result), *carry) != 0
    return result

## Ported from AK/UFixedBigInt.h:357 AK::Detail::UFixedBigInt::subc: this - other - borrow, the
## borrow out stored back.
pub func u_fixed_big_int_subc[TStorage, T](this: const UFixedBigInt[TStorage]*, other: T, borrow: bool*) -> UFixedBigInt[TStorage]:
    assert(sizeof(T) <= sizeof(TStorage))
    var result: UFixedBigInt[TStorage] = ---
    var small: u64
    *borrow = storage_add(true, fbi_words(this), storage_of(&other, &small), fbi_words(&result), *borrow) != 0
    return result

