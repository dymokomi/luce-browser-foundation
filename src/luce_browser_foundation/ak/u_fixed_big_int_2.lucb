# mark: Constant-time helpers ===================================================================

## Ported from AK/UFixedBigInt.h:454 AK::Detail::UFixedBigInt::is_zero_constant_time.
# These functions are intended to be used in LibCrypto for equality checks without branching.
pub func u_fixed_big_int_is_zero_constant_time[TStorage](this: const UFixedBigInt[TStorage]*) -> bool:
    var fold: u64 = 0
    for word in fbi_words(this):
        fold = fold | word
    return fold == 0

## Ported from AK/UFixedBigInt.h:462 AK::Detail::UFixedBigInt::is_equal_to_constant_time.
pub func u_fixed_big_int_is_equal_to_constant_time[TStorage](this: const UFixedBigInt[TStorage]*, other: UFixedBigInt[TStorage]) -> bool:
    let words = fbi_words(this)
    let other_words = fbi_words(&other)
    var fold: u64 = 0
    for i in 0..<words.length:
        fold = fold | (words[i] ^ other_words[i])
    return fold == 0

# mark: Operation helpers =======================================================================

# The storage functions the DEFINE_STANDARD_* macros pass as `function(a, b, c)`.
type StorageBinaryFunction = func(const u64[], const u64[], u64[]) -> unit

func storage_xor(a: const u64[], b: const u64[], c: u64[]):
    storage_compute_bitwise(StorageBitwise.xor_, a, b, c)

func storage_and(a: const u64[], b: const u64[], c: u64[]):
    storage_compute_bitwise(StorageBitwise.and_, a, b, c)

func storage_or(a: const u64[], b: const u64[], c: u64[]):
    storage_compute_bitwise(StorageBitwise.or_, a, b, c)

func storage_inplace_xor(a: const u64[], b: const u64[], c: u64[]):
    discard(a)
    storage_compute_inplace_bitwise(StorageBitwise.xor_, b, c)

func storage_inplace_and(a: const u64[], b: const u64[], c: u64[]):
    discard(a)
    storage_compute_inplace_bitwise(StorageBitwise.and_, b, c)

func storage_inplace_or(a: const u64[], b: const u64[], c: u64[]):
    discard(a)
    storage_compute_inplace_bitwise(StorageBitwise.or_, b, c)

func storage_plus(a: const u64[], b: const u64[], c: u64[]):
    discard(storage_add(false, a, b, c))

func storage_minus(a: const u64[], b: const u64[], c: u64[]):
    discard(storage_add(true, a, b, c))

## Ported from AK/UFixedBigInt.h:60 AK::Detail::mul_internal: result = operand1 * operand2,
## truncated to the result's words (StorageOperations::baseline_mul).
pub func mul_internal(operand1: const u64[], operand2: const u64[], result: u64[]):
    storage_baseline_mul(operand1, operand2, result)

## Ported from AK/UFixedBigInt.h:472 AK::Detail::UFixedBigInt::do_standard_binary_operation:
## `function(this, other, result)` into a new value (the operand must not be wider).
pub func u_fixed_big_int_do_standard_binary_operation[TStorage, T](this: const UFixedBigInt[TStorage]*, other: T, function: StorageBinaryFunction) -> UFixedBigInt[TStorage]:
    assert(sizeof(T) <= sizeof(TStorage), "Requested operation requires integer size to be expanded.")
    var result: UFixedBigInt[TStorage] = ---
    var small: u64
    function(fbi_words(this), storage_of(&other, &small), fbi_words(&result))
    return result

## Ported from AK/UFixedBigInt.h:480 AK::Detail::UFixedBigInt::do_standard_compound_assignment.
pub func u_fixed_big_int_do_standard_compound_assignment[TStorage, T](this: UFixedBigInt[TStorage]*, other: T, function: StorageBinaryFunction):
    assert(sizeof(T) <= sizeof(TStorage), "Requested operation requires integer size to be expanded.")
    var small: u64
    function(fbi_words(this), storage_of(&other, &small), fbi_words(this))

# mark: LittleEndian and BigEndian of a UFixedBigInt ============================================

# UFixedBigInt.h:525/565 byte_swap_if_not_{little,big}_endian: reverse the order of the words
# and byte-swap each one (on this little-endian host only the big-endian direction swaps).
func u_fixed_big_int_byte_swap_words[TStorage](value: UFixedBigInt[TStorage]) -> UFixedBigInt[TStorage]:
    var result = value
    let words = fbi_words(&result)
    let count = words.length
    for i in 0..<count // 2:
        let front = words[i]
        words[i] = convert_between_host_and_big_endian(words[count - i - 1])
        words[count - i - 1] = convert_between_host_and_big_endian(front)
    if count % 2 != 0:
        words[count // 2] = convert_between_host_and_big_endian(words[count // 2])
    return result

## Ported from AK/UFixedBigInt.h:540 AK::LittleEndian<UFixedBigInt<N>>::LittleEndian.
pub func little_endian_u_fixed_big_int_construct[TStorage](this: LittleEndian[UFixedBigInt[TStorage]]*, value: UFixedBigInt[TStorage]):
    this.m_value = value

## Ported from AK/UFixedBigInt.h:545 AK::LittleEndian<UFixedBigInt<N>>::operator UFixedBigInt.
pub func little_endian_u_fixed_big_int_to_t[TStorage](this: const LittleEndian[UFixedBigInt[TStorage]]*) -> UFixedBigInt[TStorage]:
    return this.m_value

## Ported from AK/UFixedBigInt.h:580 AK::BigEndian<UFixedBigInt<N>>::BigEndian.
pub func big_endian_u_fixed_big_int_construct[TStorage](this: BigEndian[UFixedBigInt[TStorage]]*, value: UFixedBigInt[TStorage]):
    this.m_value = u_fixed_big_int_byte_swap_words(value)

## Ported from AK/UFixedBigInt.h:585 AK::BigEndian<UFixedBigInt<N>>::operator UFixedBigInt.
pub func big_endian_u_fixed_big_int_to_t[TStorage](this: const BigEndian[UFixedBigInt[TStorage]]*) -> UFixedBigInt[TStorage]:
    return u_fixed_big_int_byte_swap_words(this.m_value)

