## Ported from AK/UFixedBigInt.h:369 AK::Detail::UFixedBigInt::operator++ (prefix).
pub func u_fixed_big_int_inc[TStorage](this: UFixedBigInt[TStorage]*) -> UFixedBigInt[TStorage]*:
