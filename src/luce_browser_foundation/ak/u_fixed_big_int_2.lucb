## Ported from AK/UFixedBigInt.h:401 AK::Detail::UFixedBigInt::wide_multiply: the full product,
## as the UFixedBigInt with storage `TResult` (bit_size + the operand's bit size).
pub func u_fixed_big_int_wide_multiply[TStorage, T, TResult](this: const UFixedBigInt[TStorage]*, other: T) -> UFixedBigInt[TResult]:
    var result: UFixedBigInt[TResult] = ---
    var small: u64
    mul_internal(fbi_words(this), storage_of(&other, &small), fbi_words(&result))
    return result

## Ported from AK/UFixedBigInt.h:409 AK::Detail::UFixedBigInt::div_mod: the quotient, the
## remainder stored in `remainder` (a UFixedBigInt).
pub func u_fixed_big_int_div_mod[TStorage, T](this: const UFixedBigInt[TStorage]*, divisor: T, remainder: T*) -> UFixedBigInt[TStorage]:
    var quotient: UFixedBigInt[TStorage] = ---
    var resulting_remainder: T = ---
    var small: u64
    div_mod_internal(true, fbi_words(this), storage_of(&divisor, &small), fbi_words(&quotient), u64[]((u64*)&resulting_remainder, sizeof(T) // 8))
    *remainder = resulting_remainder
    return quotient

## Ported from AK/UFixedBigInt.h:419 AK::Detail::UFixedBigInt::operator/(UFixedInt).
pub func u_fixed_big_int_div_t[TStorage, T](this: const UFixedBigInt[TStorage]*, other: T) -> UFixedBigInt[TStorage]:
    var quotient: UFixedBigInt[TStorage] = ---
    var small: u64
    let divisor = storage_of(&other, &small)
    var remainder_storage: u64[64]  # unused
    div_mod_internal(false, fbi_words(this), divisor, fbi_words(&quotient), remainder_storage[0..<divisor.length])
    return quotient

## Ported from AK/UFixedBigInt.h:428 AK::Detail::UFixedBigInt::operator%(UFixedInt): the remainder,
## of the divisor's type.
pub func u_fixed_big_int_rem_t[TStorage, T](this: const UFixedBigInt[TStorage]*, other: T) -> T:
    var quotient: UFixedBigInt[TStorage] = ---  # unused
    var small: u64
    let divisor = storage_of(&other, &small)
    var remainder_storage: u64[64]
    div_mod_internal(true, fbi_words(this), divisor, fbi_words(&quotient), remainder_storage[0..<divisor.length])
    var remainder: T = ---
    memory.copy(u8[]((u8*)&remainder, sizeof(T)), u8[]((u8*)&remainder_storage[0], sizeof(T)), sizeof(T))
    return remainder

## Ported from AK/UFixedBigInt.h:436 AK::Detail::UFixedBigInt::operator/(IntegerWrapper).
pub func u_fixed_big_int_div_integer_wrapper[TStorage](this: const UFixedBigInt[TStorage]*, other: IntegerWrapper) -> UFixedBigInt[TStorage]:
    return u_fixed_big_int_div_t(this, other.m_data)

