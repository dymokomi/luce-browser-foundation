    return this

## Ported from AK/UFixedBigInt.h:381 AK::Detail::UFixedBigInt::operator++ (postfix).
pub func u_fixed_big_int_inc_i32[TStorage](this: UFixedBigInt[TStorage]*, arg0: i32) -> UFixedBigInt[TStorage]:
    discard(arg0)
    let result = *this
    discard(storage_increment(false, fbi_words(this)))
    return result

## Ported from AK/UFixedBigInt.h:388 AK::Detail::UFixedBigInt::operator-- (postfix).
