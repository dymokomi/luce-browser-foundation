## Ported from AK/UFixedBigInt.h:314 AK::Detail::UFixedBigInt::operator~.
pub func u_fixed_big_int_bit_not[TStorage](this: const UFixedBigInt[TStorage]*) -> UFixedBigInt[TStorage]:
    var result: UFixedBigInt[TStorage] = ---
    let words = fbi_words(this)
    storage_compute_bitwise(StorageBitwise.invert, words, words, fbi_words(&result))
    return result

## Ported from AK/UFixedBigInt.h:321 AK::Detail::UFixedBigInt::operator<<.
pub func u_fixed_big_int_shl[TStorage](this: const UFixedBigInt[TStorage]*, shift: usize) -> UFixedBigInt[TStorage]:
    var result: UFixedBigInt[TStorage] = ---
    storage_shift_left(fbi_words(this), shift, fbi_words(&result))
    return result

