#==============================================================================================
#
#   u_fixed_big_int_2 - UFixedBigInt: fixed-size unsigned integers wider than 64 bits
#
#   DESCRIPTION:
#       Port of AK/UFixedBigInt.h (lines 1-662). luce-base has no value generics, so
#       UFixedBigInt<bit_size> is the generated `UFixedBigInt[TStorage]` whose storage is an
#       array of u64 words (`U128` = `UFixedBigInt[u64[2]]` ... `U4096`); every member works
#       for any storage by viewing it as a span of words. The bit size is the storage's
#       (the donor's u128 ... u4096 are all word-aligned).
#
#       A `UFixedInt auto` operand is a type parameter `T` that is a builtin unsigned integer
#       or another UFixedBigInt: its words are read from its bytes (get_storage_of). Where the
#       C++ result type is computed from the operands' bit sizes, the result is the receiver's
#       type (the operand must not be wider), except wide_multiply, low() and high(), which
#       take the result type as a type parameter. IntegerWrapper is the non-negative `int`
#       operand, made with `integer_wrapper(value)`.
#
#==============================================================================================

## AK's u128.
pub type U128 = UFixedBigInt[u64[2]]
## AK's u256.
pub type U256 = UFixedBigInt[u64[4]]
## AK's u384.
pub type U384 = UFixedBigInt[u64[6]]
## AK's u512.
pub type U512 = UFixedBigInt[u64[8]]
## AK's u768.
pub type U768 = UFixedBigInt[u64[12]]
## AK's u1024.
pub type U1024 = UFixedBigInt[u64[16]]
## AK's u1536.
pub type U1536 = UFixedBigInt[u64[24]]
## AK's u2048.
pub type U2048 = UFixedBigInt[u64[32]]
## AK's u4096.
pub type U4096 = UFixedBigInt[u64[64]]

# mark: Storage access ==========================================================================

# The words of a UFixedBigInt (get_storage_of).
func fbi_words[TStorage](this: const UFixedBigInt[TStorage]*) -> u64[]:
    assert(sizeof(TStorage) % 8 == 0)
    return u64[]((u64*)&this.m_data, sizeof(TStorage) // 8)

# BigIntBase.h:170 get_storage_of for a UFixedInt value: its words, least significant first. A
# builtin integer narrower than a word is widened into `small`.
func storage_of[T](value: const T*, small: u64*) -> u64[]:
    # workaround: compiler-issues/generic_sizeof_branch (bind sizeof(T) before testing it)
    let size = sizeof(T)
    if size % 8 == 0:
        return u64[]((u64*)value, size // 8)
    else:
        *small = 0
        memory.copy(u8[]((u8*)small, sizeof(T)), u8[]((u8*)value, sizeof(T)), sizeof(T))
        return u64[](small, 1)

# The words of an IntegerWrapper.
func integer_wrapper_words(value: const IntegerWrapper*) -> u64[]:
    return u64[]((u64*)&value.m_data[0], 1)

# mark: Construction and conversion =============================================================

## Ported from AK/UFixedBigInt.h:82 AK::Detail::UFixedBigInt::UFixedBigInt(IntegerWrapper).
pub func u_fixed_big_int_construct_integer_wrapper[TStorage](this: UFixedBigInt[TStorage]*, value: IntegerWrapper):
    storage_copy(integer_wrapper_words(&value), fbi_words(this))

## Ported from AK/UFixedBigInt.h:83 AK::Detail::UFixedBigInt::UFixedBigInt(int).
pub func u_fixed_big_int_construct_i32[TStorage](this: UFixedBigInt[TStorage]*, value: i32):
    let wrapper = integer_wrapper(value)
    storage_copy(integer_wrapper_words(&wrapper), fbi_words(this))

## Ported from AK/UFixedBigInt.h:89 AK::Detail::UFixedBigInt::UFixedBigInt(UFixedInt): from a
## builtin unsigned integer or another UFixedBigInt, truncated or zero-extended (both the
## explicit narrowing and the implicit widening constructor).
pub func u_fixed_big_int_u_fixed_big_int_bit_size_storage[TStorage, T](this: UFixedBigInt[TStorage]*, value: T):
    var small: u64
    storage_copy(storage_of(&value, &small), fbi_words(this))

## Ported from AK/UFixedBigInt.h:100 AK::Detail::UFixedBigInt::UFixedBigInt(low, high): from its
## two halves, each a u64 (for u128) or a UFixedBigInt of half the size.
pub func u_fixed_big_int_construct_opaque[TStorage, TPart](this: UFixedBigInt[TStorage]*, low: TPart, high: TPart):
    let words = fbi_words(this)
    assert(words.length % 2 == 0 and sizeof(TPart) * 2 == sizeof(TStorage))
    let part_size = words.length // 2
    var small_low: u64
    var small_high: u64
    let low_storage = storage_of(&low, &small_low)
    let high_storage = storage_of(&high, &small_high)
    for i in 0..<part_size:
        words[i] = low_storage[i]
    for i in 0..<part_size:
        words[i + part_size] = high_storage[i]

## Ported from AK/UFixedBigInt.h:137 AK::Detail::UFixedBigInt::operator T: to a builtin unsigned
## integer (the low bits) or another UFixedBigInt (truncated or zero-extended).
pub func u_fixed_big_int_to_t[TStorage, T](this: const UFixedBigInt[TStorage]*) -> T:
    var result: T = ---
    let bytes = u8[]((u8*)&result, sizeof(T))
    memory.set(bytes, 0)
    # workaround: compiler-issues/generic_sizeof_branch
    let size = sizeof(T)
    let storage_size = sizeof(TStorage)
    let count = size if size < storage_size else storage_size
    memory.copy(bytes[0..<count], u8[]((u8*)&this.m_data, count), count)
    return result

## Ported from AK/UFixedBigInt.h:156 AK::Detail::UFixedBigInt::low: the low half, as `TPart`
## (u64 for a u128, the UFixedBigInt of half the size otherwise).
pub func u_fixed_big_int_low[TStorage, TPart](this: const UFixedBigInt[TStorage]*) -> TPart:
    assert(sizeof(TPart) * 2 == sizeof(TStorage))
    return memory.read[TPart]((void*)&this.m_data)

## Ported from AK/UFixedBigInt.h:170 AK::Detail::UFixedBigInt::high: the high half, as `TPart`.
pub func u_fixed_big_int_high[TStorage, TPart](this: const UFixedBigInt[TStorage]*) -> TPart:
    assert(sizeof(TPart) * 2 == sizeof(TStorage))
    return memory.read[TPart]((void*)((u8*)&this.m_data + sizeof(TPart)))

## Ported from AK/UFixedBigInt.h:184 AK::Detail::UFixedBigInt::bytes.
pub func u_fixed_big_int_bytes[TStorage](this: UFixedBigInt[TStorage]*) -> u8[]:
    return u8[]((u8*)this, sizeof(TStorage))

## Ported from AK/UFixedBigInt.h:189 AK::Detail::UFixedBigInt::bytes.
pub func u_fixed_big_int_bytes_const[TStorage](this: const UFixedBigInt[TStorage]*) -> const u8[]:
    return u8[]((u8*)this, sizeof(TStorage))

## Ported from AK/UFixedBigInt.h:194 AK::Detail::UFixedBigInt::span: the words.
pub func u_fixed_big_int_span[TStorage](this: UFixedBigInt[TStorage]*) -> u64[]:
    return fbi_words(this)

## Ported from AK/UFixedBigInt.h:199 AK::Detail::UFixedBigInt::span: the words.
pub func u_fixed_big_int_span_const[TStorage](this: const UFixedBigInt[TStorage]*) -> const u64[]:
    return fbi_words(this)

# mark: Binary utils ============================================================================

## Ported from AK/UFixedBigInt.h:205 AK::Detail::UFixedBigInt::popcnt.
pub func u_fixed_big_int_popcnt[TStorage](this: const UFixedBigInt[TStorage]*) -> usize:
    var result: usize = 0
    for word in fbi_words(this):
        result += popcount_u64(word)
    return result

## Ported from AK/UFixedBigInt.h:213 AK::Detail::UFixedBigInt::ctz.
pub func u_fixed_big_int_ctz[TStorage](this: const UFixedBigInt[TStorage]*) -> usize:
    var result: usize = 0
    for word in fbi_words(this):
        if word != 0:
            result += count_trailing_zeroes_u64(word)
            break
        else:
            result += 64
    return result

## Ported from AK/UFixedBigInt.h:227 AK::Detail::UFixedBigInt::clz.
pub func u_fixed_big_int_clz[TStorage](this: const UFixedBigInt[TStorage]*) -> usize:
    let words = fbi_words(this)
    var result: usize = 0
    var i = words.length
    while i > 0:
        i -= 1
        if words[i] != 0:
            result += (usize)count_leading_zeroes_u64(words[i])
            break
        else:
            result += 64
    # + bit_size - native_word_size * static_size, which is zero for word-aligned sizes.
    return result

# mark: Comparisons =============================================================================

## Ported from AK/UFixedBigInt.h:242 AK::Detail::UFixedBigInt::operator!.
pub func u_fixed_big_int_not[TStorage](this: const UFixedBigInt[TStorage]*) -> bool:
    var result = true
    for word in fbi_words(this):
        result = result and word == 0
    return result

## Ported from AK/UFixedBigInt.h:250 AK::Detail::UFixedBigInt::operator bool.
pub func u_fixed_big_int_to_bool[TStorage](this: const UFixedBigInt[TStorage]*) -> bool:
    var result = false
    for word in fbi_words(this):
        result = result or word != 0
    return result

## Ported from AK/UFixedBigInt.h:258 AK::Detail::UFixedBigInt::operator==(UFixedInt).
pub func u_fixed_big_int_eq_opaque[TStorage, T](this: const UFixedBigInt[TStorage]*, other: T) -> bool:
    var small: u64
    return storage_compare(fbi_words(this), storage_of(&other, &small), true) == 0

## Ported from AK/UFixedBigInt.h:263 AK::Detail::UFixedBigInt::operator==(IntegerWrapper).
pub func u_fixed_big_int_eq_integer_wrapper[TStorage](this: const UFixedBigInt[TStorage]*, other: IntegerWrapper) -> bool:
    return storage_compare(fbi_words(this), integer_wrapper_words(&other), true) == 0

## Ported from AK/UFixedBigInt.h:268 AK::Detail::UFixedBigInt::operator<=>(UFixedInt).
pub func u_fixed_big_int_cmp_opaque[TStorage, T](this: const UFixedBigInt[TStorage]*, other: T) -> i32:
    var small: u64
    return storage_compare(fbi_words(this), storage_of(&other, &small), false)

## Ported from AK/UFixedBigInt.h:273 AK::Detail::UFixedBigInt::operator<=>(IntegerWrapper).
pub func u_fixed_big_int_cmp_integer_wrapper[TStorage](this: const UFixedBigInt[TStorage]*, other: IntegerWrapper) -> i32:
    return storage_compare(fbi_words(this), integer_wrapper_words(&other), false)

