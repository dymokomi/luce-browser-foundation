## JsonValue::get_integer<u32> (AK/JsonValue.h:196): the number as u32 when it has that exact value.
pub func json_value2_get_integer_u32(this: const JsonValue2*) -> u32?:
    match this.m_value:
        .i64_(value):
            if value < 0 or value > 4294967295:  # !is_within_range<u32>(value)
                return none
            return (u32)value
        .u64_(value):
            if value > 4294967295:  # !is_within_range<u32>(value)
                return none
            return (u32)value
        .f64_(value):
            # FIXME: Make is_within_range work with floating point numbers.
            if (f64)((u32)value) != value:
                return none
            return (u32)value
        _:
            return none

## JsonValue::is_integer<u32> (AK/JsonValue.h:184).
pub func json_value2_is_integer_u32(this: const JsonValue2*) -> bool:
    return json_value2_get_integer_u32(this) != none

## JsonValue::as_integer<u32> (AK/JsonValue.h:190).
pub func json_value2_as_integer_u32(this: const JsonValue2*) -> u32:
    return json_value2_get_integer_u32(this) else trap("VERIFY_NOT_REACHED: not an integer of this type")

