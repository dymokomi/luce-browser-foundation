## Ported from AK/JsonValue.h:108 AK::JsonValue::get_bool.
pub func json_value2_get_bool(this: const JsonValue2*) -> bool?:
    if not json_value2_is_bool(this):
        return none
    return json_value2_as_bool(this)

# mark: Accessors ===============================================================================

## Ported from AK/JsonValue.h:115 AK::JsonValue::as_bool.
pub func json_value2_as_bool(this: const JsonValue2*) -> bool:
    match this.m_value:
        .bool_(value): return value
        _: trap("VERIFY_NOT_REACHED: JsonValue is not a bool")

## Ported from AK/JsonValue.h:120 AK::JsonValue::as_string (C++ returns `String const&`; a String
## is an immutable value, so a copy reads the same).
pub func json_value2_as_string(this: const JsonValue2*) -> String:
    match this.m_value:
        .string(value): return value
        _: trap("VERIFY_NOT_REACHED: JsonValue is not a string")

