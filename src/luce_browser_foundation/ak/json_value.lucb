## Ported from AK/JsonValue.h:166 AK::JsonValue::is_number.
pub func json_value2_is_number(this: const JsonValue2*) -> bool:
    match this.m_value:
        .i64_(_), .u64_(_), .f64_(_): return true
        _: return false

## JsonValue::get_number_with_precision_loss<float> (AK/JsonValue.h:175).
pub func json_value2_get_number_with_precision_loss_f32(this: const JsonValue2*) -> f32?:
    match this.m_value:
        .i64_(value): return (f32)value
        .u64_(value): return (f32)value
        .f64_(value): return (f32)value
        _: return none

## JsonValue::get_number_with_precision_loss<double> (AK/JsonValue.h:175).
pub func json_value2_get_number_with_precision_loss_f64(this: const JsonValue2*) -> f64?:
    match this.m_value:
        .i64_(value): return (f64)value
        .u64_(value): return (f64)value
        .f64_(value): return value
        _: return none

# mark: get_integer<T>, is_integer<T>, as_integer<T> ============================================

## JsonValue::get_integer<i8> (AK/JsonValue.h:196): the number as i8 when it has that exact value.
pub func json_value2_get_integer_i8(this: const JsonValue2*) -> i8?:
    match this.m_value:
        .i64_(value):
            if value < -128 or value > 127:  # !is_within_range<i8>(value)
                return none
            return (i8)value
        .u64_(value):
            if value > 127:  # !is_within_range<i8>(value)
                return none
            return (i8)value
        .f64_(value):
            # FIXME: Make is_within_range work with floating point numbers.
            if (f64)((i8)value) != value:
                return none
            return (i8)value
        _:
            return none

## JsonValue::is_integer<i8> (AK/JsonValue.h:184).
pub func json_value2_is_integer_i8(this: const JsonValue2*) -> bool:
    return json_value2_get_integer_i8(this) != none

## JsonValue::as_integer<i8> (AK/JsonValue.h:190).
pub func json_value2_as_integer_i8(this: const JsonValue2*) -> i8:
    return json_value2_get_integer_i8(this) else trap("VERIFY_NOT_REACHED: not an integer of this type")

## JsonValue::get_integer<u8> (AK/JsonValue.h:196): the number as u8 when it has that exact value.
pub func json_value2_get_integer_u8(this: const JsonValue2*) -> u8?:
    match this.m_value:
        .i64_(value):
            if value < 0 or value > 255:  # !is_within_range<u8>(value)
                return none
            return (u8)value
        .u64_(value):
            if value > 255:  # !is_within_range<u8>(value)
                return none
            return (u8)value
        .f64_(value):
            # FIXME: Make is_within_range work with floating point numbers.
            if (f64)((u8)value) != value:
                return none
            return (u8)value
        _:
            return none

## JsonValue::is_integer<u8> (AK/JsonValue.h:184).
pub func json_value2_is_integer_u8(this: const JsonValue2*) -> bool:
    return json_value2_get_integer_u8(this) != none

## JsonValue::as_integer<u8> (AK/JsonValue.h:190).
pub func json_value2_as_integer_u8(this: const JsonValue2*) -> u8:
    return json_value2_get_integer_u8(this) else trap("VERIFY_NOT_REACHED: not an integer of this type")

