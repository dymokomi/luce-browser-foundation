            return (i16)value
        .u64_(value):
            if value > 32767:  # !is_within_range<i16>(value)
                return none
            return (i16)value
        .f64_(value):
            # FIXME: Make is_within_range work with floating point numbers.
            if (f64)((i16)value) != value:
