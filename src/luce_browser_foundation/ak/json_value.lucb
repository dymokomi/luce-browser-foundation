## Ported from AK/JsonValue.h:145 AK::JsonValue::as_number.
pub func json_value2_as_number(this: const JsonValue2*) -> U64OrI64OrF64:
    match this.m_value:
        .u64_(value): return U64OrI64OrF64.u64_(value = value)
        .i64_(value): return U64OrI64OrF64.i64_(value = value)
        .f64_(value): return U64OrI64OrF64.f64_(value = value)
        _: trap("VERIFY_NOT_REACHED: JsonValue is not a number")

## Ported from AK/JsonValue.h:150 AK::JsonValue::type.
pub func json_value2_type(this: const JsonValue2*) -> JsonValueType:
    match this.m_value:
        .empty: return JsonValueType.null
        .bool_(_): return JsonValueType.bool_
        .i64_(_), .u64_(_), .f64_(_): return JsonValueType.number
        .string(_): return JsonValueType.string
        .json_array(_): return JsonValueType.array
        .json_object(_): return JsonValueType.object

## Ported from AK/JsonValue.h:161 AK::JsonValue::is_null.
pub func json_value2_is_null(this: const JsonValue2*) -> bool:
    match this.m_value:
        .empty: return true
        _: return false

## Ported from AK/JsonValue.h:162 AK::JsonValue::is_bool.
pub func json_value2_is_bool(this: const JsonValue2*) -> bool:
