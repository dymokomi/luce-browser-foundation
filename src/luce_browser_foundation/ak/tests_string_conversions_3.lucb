#==============================================================================================
#
#   tests_string_conversions_3 - integer parsing and decimal exponential forms
#
#   DESCRIPTION:
#       Port of Tests/AK/TestStringConversions.cpp: signed_integer, unsigned_integer,
#       unicode_emojis_with_low_byte_in_UTF_16_matching_the_value_of_an_ascii_digit, octal,
#       double_conversion and float_conversion.
#
#==============================================================================================

test "StringConversions: signed_integer":
    assert(parse_number_string_view_i32(StringView()) == none)
    assert(parse_number_string_view_i32(sv("")) == none)
    assert(parse_number_string_view_i32(sv("a")) == none)
    assert(parse_number_string_view_i32(sv("+")) == none)
    assert(parse_number_string_view_i32(sv("-")) == none)

    assert(parse_number_string_view_i32(sv("0")) == 0)
    assert(parse_number_string_view_i32(sv("1")) == 1)
    assert(parse_number_string_view_i32(sv("+1")) == 1)
    assert(parse_number_string_view_i32(sv("-1")) == -1)
    assert(parse_number_string_view_i32(sv("01")) == 1)
    assert(parse_number_string_view_i32(sv("12345")) == 12345)
    assert(parse_number_string_view_i32(sv("-12345")) == -12345)
    assert(parse_number_string_view_i32(sv(" \t-12345 \n\n")) == -12345)

    assert(parse_number_string_view_i8(sv("-1")) == -1)
    assert(parse_number_string_view_i8(sv("128")) == none)
    assert(parse_number_string_view_i16(sv("-1")) == -1)
    assert(parse_number_string_view_i16(sv("32768")) == none)
    assert(parse_number_string_view_i32(sv("-1")) == -1)
    assert(parse_number_string_view_i32(sv("2147483648")) == none)
    assert(parse_number_string_view_i64(sv("-1")) == -1)
    assert(parse_number_string_view_i64(sv("9223372036854775808")) == none)

test "StringConversions: unsigned_integer":
    assert(parse_number_string_view_u32(StringView()) == none)
    assert(parse_number_string_view_u32(sv("")) == none)
    assert(parse_number_string_view_u32(sv("a")) == none)
    assert(parse_number_string_view_u32(sv("+")) == none)
    assert(parse_number_string_view_u32(sv("-")) == none)
    assert(parse_number_string_view_u32(sv("+1")) == none)
    assert(parse_number_string_view_u32(sv("-1")) == none)

    assert(parse_number_string_view_u32(sv("0")) == 0)
    assert(parse_number_string_view_u32(sv("1")) == 1)
    assert(parse_number_string_view_u32(sv("01")) == 1)
    assert(parse_number_string_view_u32(sv("12345")) == 12345)
    assert(parse_number_string_view_u32(sv(" \t12345 \n\n")) == 12345)

    assert(parse_number_string_view_u8(sv("255")) == 255)
    assert(parse_number_string_view_u8(sv("256")) == none)
    assert(parse_number_string_view_u16(sv("65535")) == 65535)
    assert(parse_number_string_view_u16(sv("65536")) == none)
    assert(parse_number_string_view_u32(sv("4294967295")) == 4294967295)
    assert(parse_number_string_view_u32(sv("4294967296")) == none)
    assert(parse_number_string_view_u64(sv("18446744073709551615")) == 18446744073709551615)
    assert(parse_number_string_view_u64(sv("18446744073709551616")) == none)

test "StringConversions: unicode_emojis_with_low_byte_in_UTF_16_matching_the_value_of_an_ascii_digit":
    let emojis: str[16] = ["ℹ", "ℹ️", "☸", "☸️", "☹", "☹️", "✳", "✳️", "✴", "✴️", "⤴", "⤴️", "⤵", "⤵️", "〰", "〰️"]
    for emoji in emojis:
        assert(parse_number_string_view_u32(sv(emoji)) == none)
        let utf16 = utf16_string_from_utf8_without_validation(sv(emoji))
        let view = utf16_string_base_utf16_view(&utf16.utf16_string_base)
        assert(not utf16_view_has_ascii_storage(&view))
        assert(parse_number_utf16_view_u32(view) == none)

test "StringConversions: octal":
    assert(parse_number_string_view_u16(StringView(), TrimWhitespace.no, 8) == none)
    assert(parse_number_string_view_u16(sv(""), TrimWhitespace.no, 8) == none)
    assert(parse_number_string_view_u16(sv("a"), TrimWhitespace.no, 8) == none)
    assert(parse_number_string_view_u16(sv("+"), TrimWhitespace.no, 8) == none)
    assert(parse_number_string_view_u16(sv("-"), TrimWhitespace.no, 8) == none)
    assert(parse_number_string_view_u16(sv("+1"), TrimWhitespace.no, 8) == none)
    assert(parse_number_string_view_u16(sv("-1"), TrimWhitespace.no, 8) == none)
    assert(parse_number_string_view_u16(sv("8"), TrimWhitespace.no, 8) == none)
    assert(parse_number_string_view_u16(sv("77777777"), TrimWhitespace.no, 8) == none)

    assert(parse_number_string_view_u16(sv("0"), TrimWhitespace.no, 8) == 0)
    assert(parse_number_string_view_u16(sv("1"), TrimWhitespace.no, 8) == 1)
    assert(parse_number_string_view_u16(sv("0755"), TrimWhitespace.no, 8) == 0o755)
    assert(parse_number_string_view_u16(sv("755"), TrimWhitespace.no, 8) == 0o755)
    assert(parse_number_string_view_u16(sv(" \t644 \n\n"), TrimWhitespace.yes, 8) == 0o644)
    assert(parse_number_string_view_u16(sv("177777"), TrimWhitespace.no, 8) == 0o177777)

## DOES_CONVERT_TO for double.
func test_converts_f64(value: f64, sign: bool, fraction: u64, exponent: i32):
    let form = convert_to_decimal_exponential_form_f64(value)
    assert(form.sign == sign)
    assert(form.fraction == fraction)
    assert(form.exponent == exponent)

## DOES_CONVERT_TO for float.
func test_converts_f32(value: f32, sign: bool, fraction: u64, exponent: i32):
    let form = convert_to_decimal_exponential_form_f32(value)
    assert(form.sign == sign)
    assert(form.fraction == fraction)
    assert(form.exponent == exponent)

test "StringConversions: double_conversion":
    test_converts_f64(0.0, false, 0, 0)
    test_converts_f64(-0.0, true, 0, 0)
    test_converts_f64(1.0, false, 1, 0)
    test_converts_f64(-1.0, true, 1, 0)
    test_converts_f64(0.1, false, 1, -1)
    test_converts_f64(0.2, false, 2, -1)
    test_converts_f64(0.3, false, 3, -1)
    test_converts_f64(0.12345, false, 12345, -5)
    test_converts_f64(0.0012345, false, 12345, -7)
    test_converts_f64(0.1 + 0.2, false, 30000000000000004, -17)
    test_converts_f64(17976931348623157e292, false, 17976931348623157, 292)
    test_converts_f64(-17976931348623157e292, true, 17976931348623157, 292)
    test_converts_f64(22250738585072014e-324, false, 22250738585072014, -324)
    test_converts_f64(-22250738585072014e-324, true, 22250738585072014, -324)
    test_converts_f64(f64.bits(0xc3c04222300db8ac), true, 23430728857074627, 2)

test "StringConversions: float_conversion":
    test_converts_f32(0.0f32, false, 0, 0)
    test_converts_f32(-0.0f32, true, 0, 0)
    test_converts_f32(1.0f32, false, 1, 0)
    test_converts_f32(-1.0f32, true, 1, 0)
    test_converts_f32(0.1f32, false, 1, -1)
    test_converts_f32(0.2f32, false, 2, -1)
    test_converts_f32(0.3f32, false, 3, -1)
    test_converts_f32(0.025f32, false, 25, -3)
    test_converts_f32(34028235e31f32, false, 34028235, 31)
    test_converts_f32(-34028235e31f32, true, 34028235, 31)
    test_converts_f32(11754944e-45f32, false, 11754944, -45)
    test_converts_f32(-11754944e-45f32, true, 11754944, -45)

