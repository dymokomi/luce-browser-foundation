#==============================================================================================
#
#   math_3 - clamp_to
#
#   DESCRIPTION:
#       Port of AK/Math.h clamp_to (lines 1021-1041) for every pair of destination
#       (i32, i64, u32, u64) and source (i32, i64, u32, u64, f32, f64) type:
#       `clamp_to_<destination>_<source>`. A float source is rounded with round_to.
#
#==============================================================================================

# mark: clamp_to ================================================================================

## Ported from AK/Math.h:1022 AK::clamp_to<i32>(i32).
pub func clamp_to_i32_i32(value: i32) -> i32:
    let max_ = (i32)i32_max
    if max_ > (i32)0:
        if value >= max_:
            return i32_max

    let min_ = (i32)i32_min
    if min_ <= (i32)0:
        if value <= min_:
            return i32_min

    return (i32)value

