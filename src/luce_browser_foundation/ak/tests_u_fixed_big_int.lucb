#==============================================================================================
#
#   tests_u_fixed_big_int - UFixedBigInt
#
#   DESCRIPTION:
#       Port of Tests/AK/TestUFixedBigInt.cpp. get_random<u256>() is replaced by the test
#       runner's deterministic generator; div_anti_knuth runs 2048 of the donor's 16384
#       rounds.
#
#==============================================================================================

import testing

func u256_of(w0: u64, w1: u64, w2: u64, w3: u64) -> U256:
    return U256(m_data = [w0, w1, w2, w3])

func random_u256() -> U256:
    return u256_of(testing.random(), testing.random(), testing.random(), testing.random())

func u256_eq(a: U256, b: U256) -> bool:
    return u_fixed_big_int_eq_opaque(&a, b)

func check_mod(a: U256, b: U256, expected: U256):
    assert(u256_eq(u_fixed_big_int_rem_t(&a, b), expected))

test "u_fixed_big_int: one_plus_one":
    let a = u256_of(1, 0, 0, 0)
    let b = u256_of(1, 0, 0, 0)
    assert(u256_eq(u_fixed_big_int_add_opaque(&a, b), u256_of(2, 0, 0, 0)))
    assert(u_fixed_big_int_eq_integer_wrapper(&a, integer_wrapper(1)))

test "u_fixed_big_int: identities":
    var i = 0
    while i < 32:
        let x = random_u256()
        if (x.m_data[3] >> 63) != 0:
            # ignore numbers that could overflow
            continue
        assert(u256_eq(u_fixed_big_int_shl(&x, 0), x))
        assert(u256_eq(u_fixed_big_int_shr(&x, 0), x))
        assert(u256_eq(u_fixed_big_int_div_t(&x, 1u32), x))
        let x_plus_one = u_fixed_big_int_add_integer_wrapper(&x, integer_wrapper(1))
        assert(u256_eq(u_fixed_big_int_rem_t(&x, x_plus_one), x))
        let shifted = u_fixed_big_int_shl(&x, 1)
        assert(u256_eq(u_fixed_big_int_shr(&shifted, 1), x))
        let doubled = u_fixed_big_int_mul_integer_wrapper(&x, integer_wrapper(2))
        assert(u256_eq(u_fixed_big_int_div_integer_wrapper(&doubled, integer_wrapper(2)), x))
        let plus_two = u_fixed_big_int_add_integer_wrapper(&x, integer_wrapper(2))
        assert(u256_eq(u_fixed_big_int_sub_integer_wrapper(&plus_two, integer_wrapper(2)), x))
        i += 1

test "u_fixed_big_int: add_overflow_propagation":
    let a = u256_of(u64_max, u64_max, 0, 0)
    let b = u_fixed_big_int_add_opaque(&a, a)
    let c = u_fixed_big_int_mul_integer_wrapper(&a, integer_wrapper(2))
    let low = u_fixed_big_int_low[u64[4], U128](&b)
    let high = u_fixed_big_int_high[u64[4], U128](&b)
    assert(u_fixed_big_int_eq_opaque(&low, U128(m_data = [u64_max - 1, u64_max])))
    assert(u_fixed_big_int_eq_integer_wrapper(&high, integer_wrapper(1)))
    assert(u256_eq(b, u_fixed_big_int_shl(&a, 1)))
    assert(u256_eq(b, c))

test "u_fixed_big_int: simple_multiplication":
    for _i in 0..<32:
        let a = random_u256()
        let zero = u_fixed_big_int_mul_integer_wrapper(&a, integer_wrapper(0))
        assert(u_fixed_big_int_eq_integer_wrapper(&zero, integer_wrapper(0)))
        assert(u256_eq(u_fixed_big_int_mul_integer_wrapper(&a, integer_wrapper(1)), a))
        assert(u256_eq(u_fixed_big_int_shr(&a, 1), u_fixed_big_int_div_integer_wrapper(&a, integer_wrapper(2))))
        if (a.m_data[3] >> 63) == 0:
            assert(u256_eq(u_fixed_big_int_shl(&a, 1), u_fixed_big_int_mul_integer_wrapper(&a, integer_wrapper(2))))

test "u_fixed_big_int: div_mod":
    for _i in 0..<32:
        let a = random_u256()
        let b = random_u256()
        var mod_: U256
        let quotient = u_fixed_big_int_div_mod(&a, b, &mod_)
        let product = u_fixed_big_int_mul_opaque(&quotient, b)
        assert(u256_eq(a, u_fixed_big_int_add_opaque(&product, mod_)))

let interesting_words: u64[14] = [0, 0, 1, 2, 3, 0x3ffffffffffffffe, 0x3fffffffffffffff, 0x7ffffffffffffffe, 0x7fffffffffffffff, 0x8000000000000000, 0x8000000000000001, 0xfffffffffffffffc, 0xfffffffffffffffd, 0xfffffffffffffffe]

func generate_u512() -> U512:
    var number: U512
    for i in 0..<8:
        let kind = testing.random() % 15
        number.m_data[i] = testing.random() if kind == 14 else interesting_words[kind]
    return number

test "u_fixed_big_int: div_anti_knuth":
    let a = u256_of(0, 0xffffffffffffffff, 1, 0)
    let one = u_fixed_big_int_div_t(&a, U128(m_data = [0x8000000000000001, 0xffffffffffffffff]))
    assert(u_fixed_big_int_eq_integer_wrapper(&one, integer_wrapper(1)))
    let b = U128(m_data = [0xffffffff00000000, 1])
    let also_one = u_fixed_big_int_div_t(&b, U128(m_data = [0xffffffff80000001, 0]))
    assert(u_fixed_big_int_eq_integer_wrapper(&also_one, integer_wrapper(1)))

    for _i in 0..<2048:
        let x = generate_u512()
        let y = generate_u512()
        if u_fixed_big_int_eq_integer_wrapper(&y, integer_wrapper(0)):
            continue
        var mod_: U512
        let quotient = u_fixed_big_int_div_mod(&x, y, &mod_)
        let product = u_fixed_big_int_mul_opaque(&quotient, y)
        let sum = u_fixed_big_int_add_opaque(&product, mod_)
        assert(u_fixed_big_int_eq_opaque(&sum, x))
        let wide = u_fixed_big_int_wide_multiply[u64[8], U512, u64[16]](&quotient, y)
        let wide_sum = u_fixed_big_int_add_opaque(&wide, mod_)
        assert(u_fixed_big_int_eq_opaque(&wide_sum, x))
        assert(u_fixed_big_int_cmp_opaque(&mod_, y) < 0)

test "u_fixed_big_int: shifts":
    let value = U128(m_data = [0x1234, 0])
    let a = u_fixed_big_int_shl(&value, 1)
    assert(u_fixed_big_int_eq_opaque(&a, 0x2468u64))
    let b = u_fixed_big_int_shl(&value, 4)
    assert(u_fixed_big_int_eq_opaque(&b, 0x12340u64))
    let c = u_fixed_big_int_shl(&value, 64)
    assert(u_fixed_big_int_eq_opaque(&c, U128(m_data = [0, 0x1234])))

test "u_fixed_big_int: constexpr_truncate":
    var wide: U256
    u_fixed_big_int_construct_opaque(&wide, U128(m_data = [0x8a4b08d32f8b8e48, 0x8459322f67b8e26d]), U128(m_data = [0xeea82af4312d1931, 0x654fb5cfe82dbd58]))
    assert(u_fixed_big_int_to_t[u64[4], u64](&wide) == 0x8a4b08d32f8b8e48)
    assert(u_fixed_big_int_to_t[u64[4], u32](&wide) == 0x2f8b8e48)

test "u_fixed_big_int: bit utilities, comparisons and increments":
    var x = U128(m_data = [0xf0, 0x1])
    assert(u_fixed_big_int_popcnt(&x) == 5)
    assert(u_fixed_big_int_ctz(&x) == 4)
    assert(u_fixed_big_int_clz(&x) == 63)
    assert(u_fixed_big_int_to_bool(&x) and not u_fixed_big_int_not(&x))
    let y = u_fixed_big_int_bit_not(&x)
    assert(y.m_data[0] == 0xffffffffffffff0f and y.m_data[1] == 0xfffffffffffffffe)
    var max_ = U128(m_data = [u64_max, u64_max])
    discard(u_fixed_big_int_inc(&max_))
    assert(u_fixed_big_int_is_zero_constant_time(&max_))
    discard(u_fixed_big_int_dec(&max_))
    assert(max_.m_data[0] == u64_max and max_.m_data[1] == u64_max)
    let old = u_fixed_big_int_inc_i32(&x, 0)
    assert(old.m_data[0] == 0xf0 and x.m_data[0] == 0xf1)
    var carry = true
    let sum = u_fixed_big_int_addc(&max_, 1u64, &carry)
    assert(carry and u_fixed_big_int_eq_integer_wrapper(&sum, integer_wrapper(1)))
    assert(cmp_opaque(5u64, x) < 0 and cmp_integer_wrapper(integer_wrapper(7), x) < 0)
    assert(u_fixed_big_int_is_equal_to_constant_time(&x, x))
    discard(u_fixed_big_int_or_assign_integer_wrapper(&x, integer_wrapper(0x100)))
    assert(x.m_data[0] == 0x1f1)
    discard(u_fixed_big_int_rem_assign_u(&x, 10u64))
    # (2^64 + 0x1f1) % 10 == (6 + 497) % 10
    assert(x.m_data[0] == 3 and x.m_data[1] == 0)

test "u_fixed_big_int: endian_swap":
    let a = U128(m_data = [0x1234567890abcdef, 0xfedcba0987654321])
    var big: BigEndian[U128]
    big_endian_u_fixed_big_int_construct(&big, a)
    assert(big.m_value.m_data[0] == 0x2143658709badcfe and big.m_value.m_data[1] == 0xefcdab9078563412)
    let back = big_endian_u_fixed_big_int_to_t(&big)
    var little: LittleEndian[U128]
    little_endian_u_fixed_big_int_construct(&little, a)
    assert(u_fixed_big_int_eq_opaque(&little.m_value, a))
    assert(u_fixed_big_int_eq_opaque(&back, a))

