#==============================================================================================
#
#   tests_time - Duration, UnixDateTime, MonotonicTime and the calendar helpers
#
#   DESCRIPTION:
#       Port of Tests/AK/TestTime.cpp. Not ported: time_to_string and formatter_unix_date_time
#       (StringBuilder and Formatter are regions r02/r03, still stubs), the EXPECT_DEATH
#       cases (a trap cannot be caught), the static_asserts of user_defined_literals (run
#       as asserts) and the benchmark.
#
#==============================================================================================

# mark: Helpers =================================================================================

# EXPECT_DURATION(t, s, ns).
func expect_duration(t: Duration, s: i64, ns: i64):
    let ts = duration_to_timespec(&t)
    assert(ts.tv_sec == s)
    assert(ts.tv_nsec == ns)

# DURATION(s, ns).
func duration_of(s: i64, ns: i64) -> Duration:
    return duration_from_timespec(Timespec(tv_sec = s, tv_nsec = ns))

# The offset of a UnixDateTime from the epoch.
func offset_of(t: UnixDateTime) -> Duration:
    return unix_date_time_offset_to_epoch(&t)

# EXPECT_ADDITION(s1, ns1, s2, ns2, sr, nsr).
func expect_addition(s1: i64, ns1: i64, s2: i64, ns2: i64, sr: i64, nsr: i64):
    let a = duration_of(s1, ns1)
    let b = duration_of(s2, ns2)
    expect_duration(duration_add(&a, b), sr, nsr)
    expect_duration(duration_add(&b, a), sr, nsr)
    var t = duration_of(s1, ns1)
    discard(duration_add_assign(&t, b))
    expect_duration(t, sr, nsr)

# EXPECT_SUBTRACTION(s1, ns1, s2, ns2, sr, nsr).
func expect_subtraction(s1: i64, ns1: i64, s2: i64, ns2: i64, sr: i64, nsr: i64):
    let a = duration_of(s1, ns1)
    let b = duration_of(s2, ns2)
    expect_duration(duration_sub(&a, b), sr, nsr)
    var t = duration_of(s1, ns1)
    discard(duration_sub_assign(&t, b))
    expect_duration(t, sr, nsr)

# UnixDateTime::parse with string literals.
func parse_of(format_: str, text: str, from_gmt: bool = false) -> UnixDateTime?:
    return unix_date_time_parse(time_view_of(format_), time_view_of(text), from_gmt)

# The gmtime_r fields of a parsed time.
func expect_parsed(format_: str, text: str, year: i32, month: i32, day: i32, hour: i32, minute: i32, second: i32):
    let result = parse_of(format_, text) else trap("parse failed")
    let result_time = unaware_time_to_timespec(&result.unaware_time)
    var tm = zeroed_tm()
    discard(gmtime_r(&result_time.tv_sec, &tm) else trap("gmtime_r failed"))
    assert(year == tm.tm_year + 1900)
    assert(month == tm.tm_mon + 1)
    assert(day == tm.tm_mday)
    assert(hour == tm.tm_hour)
    assert(minute == tm.tm_min)
    assert(second == tm.tm_sec)

# Duration members called on a value (C++ calls them on temporaries).

func dv_add(d: Duration, other: Duration) -> Duration:
    return duration_add(&d, other)

func dv_cmp(d: Duration, other: Duration) -> i32:
    return duration_cmp(&d, other)

func dv_sub(d: Duration, other: Duration) -> Duration:
    return duration_sub(&d, other)

func dv_to_microseconds(d: Duration) -> i64:
    return duration_to_microseconds(&d)

func dv_to_milliseconds(d: Duration) -> i64:
    return duration_to_milliseconds(&d)

func dv_to_nanoseconds(d: Duration) -> i64:
    return duration_to_nanoseconds(&d)

func dv_to_seconds(d: Duration) -> i64:
    return duration_to_seconds(&d)

func dv_to_time_units(d: Duration, numerator: u32, denominator: u32) -> i64:
    return duration_to_time_units(&d, numerator, denominator)

func dv_to_truncated_microseconds(d: Duration) -> i64:
    return duration_to_truncated_microseconds(&d)

func dv_to_truncated_milliseconds(d: Duration) -> i64:
    return duration_to_truncated_milliseconds(&d)

func dv_to_truncated_seconds(d: Duration) -> i64:
    return duration_to_truncated_seconds(&d)

# mark: Duration ================================================================================

test "time: is_sane":
    let t0 = duration_from_seconds(0)
    let t2 = duration_from_seconds(2)
    let t5 = duration_from_seconds(5)
    let tn3 = duration_from_seconds(-3)
    assert(t0 == t0)
    assert(t2 == t2)
    assert(t0 != t2)
    assert(t2 != tn3)
    assert(t2 != t5)
    expect_duration(t0, 0, 0)
    expect_duration(t2, 2, 0)
    expect_duration(duration_add(&t2, t5), 7, 0)
    expect_duration(duration_add(&tn3, t2), -1, 0)
    expect_duration(duration_add(&tn3, t5), 2, 0)

test "time: limits":
    expect_duration(duration_min(), -0x8000000000000000, 0)
    expect_duration(duration_max(), 0x7fffffffffffffff, 999999999)

# mark: Donor tables ============================================================================

test "time: timespec_parsing":
    expect_duration(duration_from_timespec(Timespec(tv_sec = 2, tv_nsec = 4)), 2, 4)
    expect_duration(duration_from_timespec(Timespec(tv_sec = 1234, tv_nsec = 5678)), 1234, 5678)
    expect_duration(duration_from_timespec(Timespec(tv_sec = 0, tv_nsec = 1000000000)), 1, 0)
    expect_duration(duration_from_timespec(Timespec(tv_sec = 8, tv_nsec = 2000000000)), 10, 0)
    expect_duration(duration_from_timespec(Timespec(tv_sec = 0, tv_nsec = 2147483647)), 2, 147483647)
    expect_duration(duration_from_timespec(Timespec(tv_sec = 1, tv_nsec = -1)), 0, 999999999)
    expect_duration(duration_from_timespec(Timespec(tv_sec = 0, tv_nsec = -1)), -1, 999999999)
    expect_duration(duration_from_timespec(Timespec(tv_sec = -1, tv_nsec = 0)), -1, 0)
    expect_duration(duration_from_timespec(Timespec(tv_sec = -1, tv_nsec = 1000000001)), 0, 1)
    expect_duration(duration_from_timespec(Timespec(tv_sec = -2, tv_nsec = 2000000003)), 0, 3)
    expect_duration(duration_from_timespec(Timespec(tv_sec = -2, tv_nsec = 1999999999)), -1, 999999999)
    expect_duration(duration_from_timespec(Timespec(tv_sec = 0x7ffffffffffffffe, tv_nsec = 999999998)), 0x7ffffffffffffffe, 999999998)
    expect_duration(duration_from_timespec(Timespec(tv_sec = 0x7ffffffffffffffe, tv_nsec = 1999999998)), 0x7fffffffffffffff, 999999998)
    expect_duration(duration_from_timespec(Timespec(tv_sec = 0x7ffffffffffffffe, tv_nsec = 1999999999)), 0x7fffffffffffffff, 999999999)
    expect_duration(duration_from_timespec(Timespec(tv_sec = 0x7ffffffffffffffe, tv_nsec = 2000000000)), 0x7fffffffffffffff, 999999999)
    expect_duration(duration_from_timespec(Timespec(tv_sec = -0x7ffffffffffffffe, tv_nsec = -1)), -0x7fffffffffffffff, 999999999)
    expect_duration(duration_from_timespec(Timespec(tv_sec = -0x7ffffffffffffffe, tv_nsec = -999999999)), -0x7fffffffffffffff, 1)
    expect_duration(duration_from_timespec(Timespec(tv_sec = -0x7ffffffffffffffe, tv_nsec = -1999999999)), -0x8000000000000000, 1)
    expect_duration(duration_from_timespec(Timespec(tv_sec = -0x7ffffffffffffffe, tv_nsec = -2000000000)), -0x8000000000000000, 0)
    expect_duration(duration_from_timespec(Timespec(tv_sec = -0x7ffffffffffffffe, tv_nsec = -2000000001)), -0x8000000000000000, 0)

test "time: timeval_parsing":
    expect_duration(duration_from_timeval(Timeval(tv_sec = 2, tv_usec = 4)), 2, 4000)
    expect_duration(duration_from_timeval(Timeval(tv_sec = 1234, tv_usec = 5678)), 1234, 5678000)
    expect_duration(duration_from_timeval(Timeval(tv_sec = -123, tv_usec = -45678)), -124, 954322000)
    expect_duration(duration_from_timeval(Timeval(tv_sec = 0, tv_usec = 1000000)), 1, 0)
    expect_duration(duration_from_timeval(Timeval(tv_sec = 0, tv_usec = 1000000000)), 1000, 0)
    expect_duration(duration_from_timeval(Timeval(tv_sec = 8, tv_usec = 2000000)), 10, 0)
    expect_duration(duration_from_timeval(Timeval(tv_sec = 0, tv_usec = 2147483647)), 2147, 483647000)
    expect_duration(duration_from_timeval(Timeval(tv_sec = 1, tv_usec = -1)), 0, 999999000)
    expect_duration(duration_from_timeval(Timeval(tv_sec = 0, tv_usec = -1)), -1, 999999000)
    expect_duration(duration_from_timeval(Timeval(tv_sec = -1, tv_usec = 0)), -1, 0)
    expect_duration(duration_from_timeval(Timeval(tv_sec = -1, tv_usec = 1000001)), 0, 1000)
    expect_duration(duration_from_timeval(Timeval(tv_sec = -2, tv_usec = 2000003)), 0, 3000)
    expect_duration(duration_from_timeval(Timeval(tv_sec = -2, tv_usec = 1999999)), -1, 999999000)
    expect_duration(duration_from_timeval(Timeval(tv_sec = 0x7ffffffffffffffe, tv_usec = 999998)), 0x7ffffffffffffffe, 999998000)
    expect_duration(duration_from_timeval(Timeval(tv_sec = 0x7ffffffffffffffe, tv_usec = 1999998)), 0x7fffffffffffffff, 999998000)
    expect_duration(duration_from_timeval(Timeval(tv_sec = 0x7ffffffffffffffe, tv_usec = 1999999)), 0x7fffffffffffffff, 999999000)
    expect_duration(duration_from_timeval(Timeval(tv_sec = 0x7ffffffffffffffe, tv_usec = 2000000)), 0x7fffffffffffffff, 999999999)
    expect_duration(duration_from_timeval(Timeval(tv_sec = -0x7ffffffffffffffe, tv_usec = -1)), -0x7fffffffffffffff, 999999000)
    expect_duration(duration_from_timeval(Timeval(tv_sec = -0x7ffffffffffffffe, tv_usec = -999999)), -0x7fffffffffffffff, 1000)
    expect_duration(duration_from_timeval(Timeval(tv_sec = -0x7ffffffffffffffe, tv_usec = -1999999)), -0x8000000000000000, 1000)
    expect_duration(duration_from_timeval(Timeval(tv_sec = -0x7ffffffffffffffe, tv_usec = -2000000)), -0x8000000000000000, 0)
    expect_duration(duration_from_timeval(Timeval(tv_sec = -0x7ffffffffffffffe, tv_usec = -2000001)), -0x8000000000000000, 0)

test "time: addition":
    expect_addition(11, 123456789, 22, 900000000, 34, 23456789)
    expect_addition(0, 0, 9223372036854775807, 999999998, 0x7fffffffffffffff, 999999998)
    expect_addition(0, 1, 9223372036854775807, 999999998, 0x7fffffffffffffff, 999999999)
    expect_addition(0, 2, 9223372036854775807, 999999998, 0x7fffffffffffffff, 999999999)
    expect_addition(0x80, 40, 0x7fffffffffffff7f, 999999958, 0x7fffffffffffffff, 999999998)
    expect_addition(0x80, 41, 0x7fffffffffffff7f, 999999958, 0x7fffffffffffffff, 999999999)
    expect_addition(0x80, 42, 0x7fffffffffffff7f, 999999958, 0x7fffffffffffffff, 999999999)
    expect_addition(-2, 5, -3, 7, -5, 12)
    expect_addition(-2, 999999995, -3, 999999997, -4, 999999992)
    expect_addition(-0x7fffffffffffffff, 999999995, -1, 6, -0x7fffffffffffffff, 1)
    expect_addition(-0x7fffffffffffffff, 999999995, -2, 6, -0x8000000000000000, 1)
    expect_addition(-0x7fffffffffffffff, 999999995, -2, 5, -0x8000000000000000, 0)
    expect_addition(-0x7fffffffffffffff, 999999995, -2, 4, -0x8000000000000000, 0)
    expect_addition(-0x8000000000000000, 999999995, 0x7fffffffffffffff, 4, -1, 999999999)
    expect_addition(-0x8000000000000000, 999999995, 0x7fffffffffffffff, 5, 0, 0)
    expect_addition(-0x8000000000000000, 999999995, 0x7fffffffffffffff, 6, 0, 1)

test "time: subtraction":
    expect_subtraction(5, 0, 3, 0, 2, 0)
    expect_subtraction(0, 0, 0, 0, 0, 0)
    expect_subtraction(0, 5, 0, 3, 0, 2)
    expect_subtraction(0x7fffffffffffffff, 999999999, 8, 123, 0x7ffffffffffffff7, 999999876)
    expect_subtraction(1, 0, 0, 999999999, 0, 1)
    expect_subtraction(0x7fffffffffffffff, 0, 1, 999999999, 0x7ffffffffffffffd, 1)
    expect_subtraction(3, 0, 5, 0, -2, 0)
    expect_subtraction(0, 3, 0, 5, -1, 999999998)
    expect_subtraction(0, 0, 0x7fffffffffffffff, 999999999, -0x8000000000000000, 1)
    expect_subtraction(0, 0, -0x8000000000000000, 0, 0x7fffffffffffffff, 999999999)
    expect_subtraction(-1, 999999999, -0x8000000000000000, 0, 0x7fffffffffffffff, 999999999)
    expect_subtraction(-1, 999999998, -0x8000000000000000, 0, 0x7fffffffffffffff, 999999998)
    expect_subtraction(123, 456, 123, 455, 0, 1)
    expect_subtraction(123, 456, 123, 456, 0, 0)
    expect_subtraction(123, 456, 123, 457, -1, 999999999)
    expect_subtraction(124, 456, 123, 455, 1, 1)
    expect_subtraction(124, 456, 123, 456, 1, 0)
    expect_subtraction(124, 456, 123, 457, 0, 999999999)
    expect_subtraction(-0x7fffffffffffffff, 999999995, 1, 999999994, -0x8000000000000000, 1)
    expect_subtraction(-0x7fffffffffffffff, 999999995, 1, 999999995, -0x8000000000000000, 0)
    expect_subtraction(-0x7fffffffffffffff, 999999995, 1, 999999996, -0x8000000000000000, 0)

test "time: rounding":
    assert(dv_to_seconds(duration_of(2, 800800800)) == 3)
    assert(dv_to_milliseconds(duration_of(2, 800800800)) == 2801)
    assert(dv_to_microseconds(duration_of(2, 800800800)) == 2800801)
    assert(dv_to_nanoseconds(duration_of(2, 800800800)) == 2800800800)
    assert(dv_to_seconds(duration_of(-2, 800800800)) == -2)
    assert(dv_to_milliseconds(duration_of(-2, 800800800)) == -1200)
    assert(dv_to_microseconds(duration_of(-2, 800800800)) == -1199200)
    assert(dv_to_nanoseconds(duration_of(-2, 800800800)) == -1199199200)
    assert(dv_to_seconds(duration_of(0, 0)) == 0)
    assert(dv_to_milliseconds(duration_of(0, 0)) == 0)
    assert(dv_to_microseconds(duration_of(0, 0)) == 0)
    assert(dv_to_nanoseconds(duration_of(0, 0)) == 0)
    assert(dv_to_seconds(duration_of(0, 1)) == 1)
    assert(dv_to_milliseconds(duration_of(0, 1)) == 1)
    assert(dv_to_microseconds(duration_of(0, 1)) == 1)
    assert(dv_to_nanoseconds(duration_of(0, 1)) == 1)
    assert(dv_to_seconds(duration_of(0, -1)) == -1)
    assert(dv_to_milliseconds(duration_of(0, -1)) == -1)
    assert(dv_to_microseconds(duration_of(0, -1)) == -1)
    assert(dv_to_nanoseconds(duration_of(0, -1)) == -1)
    assert(dv_to_nanoseconds(duration_of(-9223372037, 145224191)) == -0x8000000000000000)
    assert(dv_to_nanoseconds(duration_of(-9223372037, 145224192)) == -0x8000000000000000)
    assert(dv_to_nanoseconds(duration_of(-9223372037, 145224193)) == -0x7fffffffffffffff)
    assert(dv_to_nanoseconds(duration_of(9223372036, 854775806)) == 0x7ffffffffffffffe)
    assert(dv_to_nanoseconds(duration_of(9223372036, 854775807)) == 0x7fffffffffffffff)
    assert(dv_to_nanoseconds(duration_of(9223372036, 854775808)) == 0x7fffffffffffffff)

test "time: truncation":
    assert(dv_to_truncated_seconds(duration_of(2, 0)) == 2)
    assert(dv_to_truncated_seconds(duration_of(-2, 0)) == -2)
    assert(dv_to_truncated_seconds(duration_of(2, 800800800)) == 2)
    assert(dv_to_truncated_milliseconds(duration_of(2, 800800800)) == 2800)
    assert(dv_to_truncated_microseconds(duration_of(2, 800800800)) == 2800800)
    assert(dv_to_truncated_seconds(duration_of(-2, -800800800)) == -2)
    assert(dv_to_truncated_milliseconds(duration_of(-2, -800800800)) == -2800)
    assert(dv_to_truncated_microseconds(duration_of(-2, -800800800)) == -2800800)
    assert(dv_to_truncated_seconds(duration_min()) == i64_min)
    assert(dv_to_truncated_seconds(duration_max()) == i64_max)
    assert(dv_to_truncated_milliseconds(duration_of(-9223372036854776, 191000000)) == -0x8000000000000000)
    assert(dv_to_truncated_milliseconds(duration_of(-9223372036854776, 192000000)) == -0x8000000000000000)
    assert(dv_to_truncated_milliseconds(duration_of(-9223372036854776, 192000001)) == -0x7fffffffffffffff)
    assert(dv_to_truncated_milliseconds(duration_of(-9223372036854776, 193000000)) == -0x7fffffffffffffff)
    assert(dv_to_truncated_milliseconds(duration_of(9223372036854775, 806000000)) == 0x7ffffffffffffffe)
    assert(dv_to_truncated_milliseconds(duration_of(9223372036854775, 806999999)) == 0x7ffffffffffffffe)
    assert(dv_to_truncated_milliseconds(duration_of(9223372036854775, 807000000)) == 0x7fffffffffffffff)
    assert(dv_to_truncated_milliseconds(duration_of(9223372036854775, 808000000)) == 0x7fffffffffffffff)
    assert(dv_to_truncated_microseconds(duration_of(-9223372036855, 224191000)) == -0x8000000000000000)
    assert(dv_to_truncated_microseconds(duration_of(-9223372036855, 224192000)) == -0x8000000000000000)
    assert(dv_to_truncated_microseconds(duration_of(-9223372036855, 224192001)) == -0x7fffffffffffffff)
    assert(dv_to_truncated_microseconds(duration_of(-9223372036855, 224193000)) == -0x7fffffffffffffff)
    assert(dv_to_truncated_microseconds(duration_of(9223372036854, 775806000)) == 0x7ffffffffffffffe)
    assert(dv_to_truncated_microseconds(duration_of(9223372036854, 775806999)) == 0x7ffffffffffffffe)
    assert(dv_to_truncated_microseconds(duration_of(9223372036854, 775807000)) == 0x7fffffffffffffff)
    assert(dv_to_truncated_microseconds(duration_of(9223372036854, 775808000)) == 0x7fffffffffffffff)

test "time: from_iso8601_week":
    expect_duration(offset_of(unix_date_time_from_iso8601_week(1970, 1)), -259200, 0)
    expect_duration(offset_of(unix_date_time_from_iso8601_week(2000, 2)), 947462400, 0)
    expect_duration(offset_of(unix_date_time_from_iso8601_week(2000, 51)), 977097600, 0)
