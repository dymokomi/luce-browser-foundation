test "time: calendar helpers":
    assert(is_leap_year(2000) and is_leap_year(2024) and not is_leap_year(1900) and not is_leap_year(2023))
    assert(day_of_week(2023, 1, 23) == 1)
    assert(day_of_year(2024, 3, 1) == 60)
    assert(days_in_month(2024, 2) == 29)
    assert(days_in_month(2023, 4) == 30)
    assert(days_in_year(2023) == 365)
    assert(iso8061_weeks_in_year(2004) == 53)
    assert(iso8061_weeks_in_year(2005) == 52)
    assert(seconds_since_epoch_to_year(0) == 1970)
    # The donor truncates toward zero for values in (-1, 0): -1s is still 1970.
    assert(seconds_since_epoch_to_year(-1) == 1970)
    assert(seconds_since_epoch_to_year(-40000000) == 1968)
    assert(seconds_since_epoch_to_year(1684953880) == 2023)

test "time: user_defined_literals":
    assert(duration_from_nanoseconds(123) == time_literals_literalns(123))
    assert(dv_cmp(time_literals_literalms(100), time_literals_literalms(10)) > 0)
    assert(time_literals_literalns(1000) == time_literals_literalus(1))
    assert(dv_cmp(time_literals_literalsec(1), time_literals_literalms(1)) > 0)
    assert(dv_cmp(time_literals_literalms(100), time_literals_literalus(100000)) >= 0)
    assert(dv_cmp(time_literals_literalms(100), time_literals_literalus(99999)) >= 0)
    assert(dv_cmp(time_literals_literalms(100), time_literals_literalus(100000)) <= 0)
    assert(dv_cmp(time_literals_literalms(100), time_literals_literalus(100001)) <= 0)
    assert(time_literals_literalsec(1) != time_literals_literalsec(2))

# mark: Parsing =================================================================================

test "time: parse_time":
    expect_parsed("%d-%m-%Y %H:%M", "05-01-2023 00:00", 2023, 1, 5, 0, 0, 0)
    expect_parsed("%d-%m-%Y %H:%M GMT", "05-01-2023 00:00 GMT", 2023, 1, 5, 0, 0, 0)
    expect_parsed("%Y/%m/%d %R", "2023/01/23 10:50", 2023, 1, 23, 10, 50, 0)
    expect_parsed("%Y-%m-%d %H:%M", "1999-12-31 23:59", 1999, 12, 31, 23, 59, 0)
    expect_parsed("%Y/%m/%d %R", "1970/01/01 00:00", 1970, 1, 1, 0, 0, 0)
    expect_parsed("%Y/%m/%d %R", "2000/02/29 12:34", 2000, 2, 29, 12, 34, 0)
    expect_parsed("%Y-%m-%d %T", "2023-01-23 10:50:15", 2023, 1, 23, 10, 50, 15)
    expect_parsed("%Y-%m-%d %H:%M:%S", "2023-01-23 10:50:42", 2023, 1, 23, 10, 50, 42)
    expect_parsed("%Y-%m-%d %I:%M %p", "2023-01-23 03:21 PM", 2023, 1, 23, 15, 21, 0)
    expect_parsed("%Y-%m-%d %I:%M %p", "2023-01-23 12:01 AM", 2023, 1, 23, 0, 1, 0)
    expect_parsed("%D %H:%M:%S", "01/23/23 10:50:59", 2023, 1, 23, 10, 50, 59)
    expect_parsed("%y %C %m %d %H:%M:%S", "23 20 01 23 10:50:11", 2023, 1, 23, 10, 50, 11)
    expect_parsed("%Y-%m-%d %a", "2023-01-23 Mon", 2023, 1, 23, 0, 0, 0)
    expect_parsed("%Y-%m-%d %A", "2023-01-23 Monday", 2023, 1, 23, 0, 0, 0)
    expect_parsed("%d %b %Y", "05 Jan 2023", 2023, 1, 5, 0, 0, 0)
    expect_parsed("%d %B %Y", "05 January 2023", 2023, 1, 5, 0, 0, 0)
    expect_parsed("%Y %j %H:%M:%S", "2023 023 10:50:12", 2023, 1, 23, 10, 50, 12)
    expect_parsed("%Y-%m-%d %w %H:%M:%S", "2023-01-23 1 10:50:13", 2023, 1, 23, 10, 50, 13)
    expect_parsed("%Y-%m-%d%n%H:%M:%S", "2023-01-23\n10:50:14", 2023, 1, 23, 10, 50, 14)
    expect_parsed("%Y-%m-%d%t%H:%M:%S", "2023-01-23\t10:50:15", 2023, 1, 23, 10, 50, 15)
    expect_parsed("%Y-%m-%d %% %H:%M:%S", "2023-01-23 % 10:50:16", 2023, 1, 23, 10, 50, 16)

test "time: parse_wildcard_characters":
    assert(parse_of("%+", "") == none)
    assert(parse_of("foo%+", "foo") == none)
    assert(parse_of("[%*]", "[foo") == none)
    assert(parse_of("[%*]", "foo]") == none)
    assert(parse_of("%+%b", "fooJan") == none)
    expect_parsed("%Y %+ %m %d", "2023 whf 01 23", 2023, 1, 23, 0, 0, 0)
    expect_parsed("%Y %m %d %+", "2023 01 23 whf", 2023, 1, 23, 0, 0, 0)
    expect_parsed("%Y [%+] %m %d", "2023 [well hello friends!] 01 23", 2023, 1, 23, 0, 0, 0)
    expect_parsed("%Y %m %d [%+]", "2023 01 23 [well hello friends!]", 2023, 1, 23, 0, 0, 0)

test "time: parse_time_from_gmt":
    assert(parse_of("%Y-%m-%d %H:%M:%S", "2023-01-15 12:00:00", true) != none)
    let test_gmt = parse_of("%Y-%m-%d %H:%M:%S", "1970-01-01 00:00:00", true) else trap("none")
    assert(unix_date_time_seconds_since_epoch(&test_gmt) == 0)
    let test_gmt2 = parse_of("%Y-%m-%d %H:%M:%S", "1970-01-01 01:00:00", true) else trap("none")
    assert(unix_date_time_seconds_since_epoch(&test_gmt2) == 3600)
    let test_gmt3 = parse_of("%Y-%m-%d %H:%M:%S", "2023-06-15 18:30:45", true) else trap("none")
    let result_time = unaware_time_to_timespec(&test_gmt3.unaware_time)
    var tm = zeroed_tm()
    discard(gmtime_r(&result_time.tv_sec, &tm) else trap("gmtime_r failed"))
    assert(tm.tm_year + 1900 == 2023)
    assert(tm.tm_mon + 1 == 6)
    assert(tm.tm_mday == 15)
    assert(tm.tm_hour == 18)
    assert(tm.tm_min == 30)
    assert(tm.tm_sec == 45)

# mark: Conversions =============================================================================

test "time: from_f64_seconds":
    let max_seconds = duration_from_seconds(i64_max)
    assert(duration_from_seconds_f64((f64)f32_max) == max_seconds)
    let smaller_float = f32.bits(f32_max.bits() - 1)
    assert(duration_from_seconds_f64((f64)smaller_float) == max_seconds)
    # nextafterf(static_cast<float>(i64 max), 0.0f)
    let max_representable_float = f32.bits(((f32)i64_max).bits() - 1)
    let max_representable_float_as_integer: i64 = 9223371487098961920
    assert(duration_from_seconds_f64((f64)max_representable_float) == duration_from_seconds(max_representable_float_as_integer))
    let min_seconds = duration_from_seconds(i64_min)
    assert(duration_from_seconds_f64((f64)f32_lowest) == min_seconds)
    assert(duration_from_seconds_f64(-(f64)smaller_float) == min_seconds)
    assert(duration_from_seconds_f64(-(f64)max_representable_float) == duration_from_seconds(-max_representable_float_as_integer))
    assert(duration_from_seconds_f64(1.5) == duration_from_milliseconds(1500))
    assert(duration_from_seconds_f64(205321.25) == duration_from_milliseconds(205321250))
    assert(duration_from_seconds_f64(-0.25) == duration_from_milliseconds(-250))
    assert(duration_from_seconds_f64(-1.75) == duration_from_milliseconds(-1750))

test "time: time_units":
    assert(duration_from_time_units(1, 1, 1) == duration_from_seconds(1))
    assert(duration_from_time_units(-312, 1, 48000) == duration_from_microseconds(-6500))
    assert(duration_from_time_units(960, 1, 48000) == duration_from_microseconds(20000))
    assert(duration_from_time_units(8, 4, 1) == duration_from_seconds(32))
    assert(duration_from_time_units(3, 3, 2000000000) == duration_from_nanoseconds(5))
    assert(duration_from_time_units(4, 3, 2000000000) == duration_from_nanoseconds(6))
    assert(duration_from_time_units(999999998, 1, 2000000000) == duration_from_nanoseconds(499999999))
    assert(duration_from_time_units(999999999, 1, 2000000000) == duration_from_nanoseconds(500000000))
    assert(duration_from_time_units(1000000000, 1, 2000000000) == duration_from_nanoseconds(500000000))
    assert(duration_from_time_units(i64_max, 1, 2) == dv_add(duration_from_seconds(i64_max // 2), duration_from_milliseconds(500)))
    assert(duration_from_time_units(i64_max // 2, 2, 1) == duration_from_seconds(i64_max - 1))
    assert(duration_from_time_units(i64_max // 2 + 1, 2, 1) == duration_from_seconds(i64_max))
    assert(duration_from_time_units(i64_min // 2, 2, 1) == duration_from_seconds(i64_min))
    assert(duration_from_time_units(i64_min // 2 - 1, 2, 1) == duration_from_seconds(i64_min))
    assert(duration_from_time_units(-43776, 1, 14592) == duration_from_seconds(-3))
    assert(duration_from_time_units(i64_min, 1, 2) == duration_from_seconds(i64_min // 2))
    assert(duration_from_time_units(i64_min + 1, 1, 2) == dv_add(duration_from_seconds(i64_min // 2), duration_from_milliseconds(500)))
    assert(duration_from_time_units(i64_min, 1, 3) == dv_sub(duration_from_seconds(i64_min // 3), duration_from_nanoseconds(666666667)))
    assert(duration_from_time_units(-1, 1, 2000000000) == duration_zero())
    assert(duration_from_time_units(-2, 1, 2000000000) == duration_from_nanoseconds(-1))
    assert(dv_to_time_units(duration_from_milliseconds(999), 1, 48000) == 47952)
    assert(dv_to_time_units(duration_from_milliseconds(-12500), 1, 1000) == -12500)
    assert(dv_to_time_units(duration_from_nanoseconds(154489696), 1, 48000) == 7416)
    assert(dv_to_time_units(duration_from_nanoseconds(154489375), 1, 48000) == 7415)
    assert(dv_to_time_units(duration_from_nanoseconds(-154489696), 1, 48000) == -7416)
    assert(dv_to_time_units(duration_from_nanoseconds(-154489375), 1, 48000) == -7415)
    assert(dv_to_time_units(duration_from_nanoseconds(1900000000), 3, 2) == 1)
    assert(dv_to_time_units(duration_from_nanoseconds(1800000000), 3, 1) == 1)
    assert(dv_to_time_units(duration_from_seconds(3), 4, 1) == 1)
    assert(dv_to_time_units(duration_from_seconds(4), 4, 1) == 1)
    assert(dv_to_time_units(duration_from_seconds(5), 4, 1) == 1)
    assert(dv_to_time_units(duration_from_seconds(6), 4, 1) == 2)
    assert(dv_to_time_units(duration_from_seconds(2147483649), 1, u32_max) == i64_max)
    assert(dv_to_time_units(duration_from_seconds(2147483648), 1, u32_max) == i64_max - (i64)(u32_max // 2))
    assert(dv_to_time_units(dv_add(duration_from_seconds(1), duration_from_nanoseconds(999999999)), u32_max, u32_max - 1) == 2)

test "time: clocks and timeval helpers":
    let a = monotonic_time_now()
    let b = monotonic_time_now_coarse()
    assert(monotonic_time_nanoseconds_within_second(&a) < 1000000000)
    discard(monotonic_time_sub_monotonic_time(&b, a))
    let now = unix_date_time_now()
    assert(unix_date_time_seconds_since_epoch(&now) > 1600000000)
    var tv: Timeval
    timeval_sub(Timeval(tv_sec = 5, tv_usec = 100), Timeval(tv_sec = 2, tv_usec = 200), &tv)
    assert(tv.tv_sec == 2 and tv.tv_usec == 999900)
    var ts: Timespec
    timespec_add_timeval(Timespec(tv_sec = 1, tv_nsec = 999999999), Timeval(tv_sec = 0, tv_usec = 1), &ts)
    assert(ts.tv_sec == 2 and ts.tv_nsec == 999)
    timeval_to_timespec(Timeval(tv_sec = 3, tv_usec = 7), &ts)
    assert(ts.tv_nsec == 7000)
