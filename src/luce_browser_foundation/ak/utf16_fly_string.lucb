# mark: Literals ================================================================================

## Ported from AK/Utf16FlyString.h:223 operator""_utf16_fly_string(char const*, size_t).
pub func literalutf16_fly_string_u8(string: const u8*?, length: usize) -> Utf16FlyString:
    let view = literalsv_u8(string, length)
    # OPTIMIZATION: Short ASCII strings become compile-time constants with no runtime validation
    # or table lookup.
    if length <= max_short_string_byte_count and string_view_is_ascii(&view):
        return utf16_fly_string_from_ascii_short_string_without_validation_u8(string_view_bytes(&view))

    let utf8 = Utf8View(m_string = view)
    assert(utf8_view_validate_allow_lonely_surrogates(&utf8))
    return utf16_fly_string_from_utf8_without_validation(view)

## Ported from AK/Utf16FlyString.h:237 operator""_utf16_fly_string(char16_t const*, size_t).
pub func literalutf16_fly_string_u16(string: const u16*?, length: usize) -> Utf16FlyString:
    let view = literalsv_u16(string, length)
    # OPTIMIZATION: Short ASCII strings become compile-time constants with no runtime work.
    if length <= max_short_string_byte_count and utf16_view_is_ascii(&view):
        return utf16_fly_string_from_ascii_short_string_without_validation_u16(utf16_view_utf16_span(&view))

    return utf16_fly_string_from_utf16(view)
