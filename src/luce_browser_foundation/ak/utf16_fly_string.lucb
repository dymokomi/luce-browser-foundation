#==============================================================================================
#
#   utf16_fly_string - Utf16FlyString: interned UTF-16 strings that compare by identity
#
#   DESCRIPTION:
#       Port of AK/Utf16FlyString.h (lines 1-245) and AK/Utf16FlyString.cpp (lines 1-104).
#
#       A Utf16FlyString is a Utf16StringBase whose long data is registered in the
#       all_utf16_fly_strings table, so equal strings share one Utf16StringData and `==` is a
#       comparison of the eight bytes. The table's HashTable calls are gathered in the
#       utf16_fly_string_table_* helpers.
#
#==============================================================================================

# mark: The table ===============================================================================

## Ported from AK/Utf16FlyString.cpp:14 AK::Utf16FlyStringTableHashTraits::hash.
pub func utf16_fly_string_table_hash_traits_hash(string: const Utf16StringData*?) -> u32:
    return utf16_string_data_hash(string else trap("VERIFY: null Utf16StringData in the Utf16FlyString table"))

## Ported from AK/Utf16FlyString.cpp:15 AK::Utf16FlyStringTableHashTraits::equals.
pub func utf16_fly_string_table_hash_traits_equals(a: const Utf16StringData*?, b: const Utf16StringData*?) -> bool:
    return utf16_string_data_eq_utf16_string_data(a else trap("VERIFY: null Utf16StringData"), b else trap("VERIFY: null Utf16StringData"))

## Ported from AK/Utf16FlyString.cpp:16 AK::Utf16FlyStringTableHashTraits::may_have_slow_equality_check.
pub func utf16_fly_string_table_hash_traits_may_have_slow_equality_check() -> bool:
    return true

## `static Singleton<HashTable<Utf16StringData const*, Utf16FlyStringTableHashTraits>> table`.
var s_all_utf16_fly_strings: HashTable[const Utf16StringData*?, Utf16FlyStringTableHashTraits]

## Ported from AK/Utf16FlyString.cpp:19 AK::all_utf16_fly_strings.
func all_utf16_fly_strings() -> HashTable[const Utf16StringData*?, Utf16FlyStringTableHashTraits]*:
    return &s_all_utf16_fly_strings

## Ported from AK/Utf16FlyString.cpp:27 AK::Detail::did_destroy_utf16_fly_string_data: drops a
## Utf16StringData from the table when it dies (the destructor's call; the collector's finalizer
## will make it).
pub func did_destroy_utf16_fly_string_data(data: const Utf16StringData*):
    discard(hash_table_remove_t(all_utf16_fly_strings(), data))

## The captures of the `[&](auto const& entry) { return *entry == string; }` predicate of
## create_fly_string_from_cache for a UTF-8 view.
struct Utf16FlyStringTableStringViewPredicate:
    var string: StringView

# The UTF-8 predicate's body.
func utf16_fly_string_table_string_view_predicate_call(context: void*?, entry: const (const Utf16StringData*?)*) -> bool:
    let captures = (const Utf16FlyStringTableStringViewPredicate*)(context else trap("Utf16FlyString: no captures"))
    return utf16_string_data_eq_string_view(*entry else trap("VERIFY: null Utf16StringData"), captures.string)

## The same predicate's captures for a Utf16View.
struct Utf16FlyStringTableUtf16ViewPredicate:
    var string: Utf16View

# The Utf16View predicate's body.
func utf16_fly_string_table_utf16_view_predicate_call(context: void*?, entry: const (const Utf16StringData*?)*) -> bool:
    let captures = (const Utf16FlyStringTableUtf16ViewPredicate*)(context else trap("Utf16FlyString: no captures"))
    return utf16_string_data_eq_utf16_view(*entry else trap("VERIFY: null Utf16StringData"), &captures.string)

# `all_utf16_fly_strings().find(hash, predicate)`: the interned data the predicate accepts, if any.
func utf16_fly_string_table_find(hash_: u32, predicate: Function1[const (const Utf16StringData*?)*, bool]) -> const Utf16StringData*?:
    var it = hash_table_find_u32_tt_unary_predicate(all_utf16_fly_strings(), hash_, predicate)
    if hash_table_iterator_eq(&it, hash_table_end(all_utf16_fly_strings())):
        return none
    return *hash_table_iterator_deref(&it)

## Ported from AK/Utf16FlyString.cpp:35 AK::Utf16FlyString::create_fly_string_from_cache for a
## StringView: a short string, or the interned string equal to `string`, or none.
func utf16_fly_string_create_fly_string_from_cache_string_view(string: StringView) -> Utf16FlyString?:
    if string_view_is_empty(&string):
        return none

    if string_view_length(&string) <= max_short_string_byte_count and string_view_is_ascii(&string):
        return utf16_fly_string_from_utf16_string(utf16_string_from_utf8_without_validation(string))

    var captures = Utf16FlyStringTableStringViewPredicate(string = string)
    let predicate = Function1[const (const Utf16StringData*?)*, bool](call = utf16_fly_string_table_string_view_predicate_call, context = &captures)
    let data = utf16_fly_string_table_find(string_view_hash(&string), predicate) else return none
    return utf16_fly_string_from_data(data)

## Ported from AK/Utf16FlyString.cpp:35 AK::Utf16FlyString::create_fly_string_from_cache for a
## Utf16View.
func utf16_fly_string_create_fly_string_from_cache_utf16_view(string: Utf16View) -> Utf16FlyString?:
    if utf16_view_is_empty(&string):
        return none

    if utf16_view_length_in_code_units(&string) <= max_short_string_byte_count and utf16_view_is_ascii(&string):
        return utf16_fly_string_from_utf16_string(utf16_string_from_utf16(string))

    var captures = Utf16FlyStringTableUtf16ViewPredicate(string = string)
    let predicate = Function1[const (const Utf16StringData*?)*, bool](call = utf16_fly_string_table_utf16_view_predicate_call, context = &captures)
    let data = utf16_fly_string_table_find(utf16_view_hash(&string), predicate) else return none
    return utf16_fly_string_from_data(data)

## `Utf16FlyString { Utf16StringBase(data) }`.
func utf16_fly_string_from_data(data: const Utf16StringData*) -> Utf16FlyString:
    var result = Utf16FlyString(m_data = Utf16StringBase())
    utf16_string_base_construct_utf16_string_data(&result.m_data, data)
    return result

# mark: Creation ================================================================================

## Ported from AK/Utf16FlyString.cpp:56 AK::Utf16FlyString::from_utf8(StringView).
pub func utf16_fly_string_from_utf8_string_view(string: StringView) -> Utf16FlyString:
    if let result = utf16_fly_string_create_fly_string_from_cache_string_view(string):
        return result
    return utf16_fly_string_from_utf16_string(utf16_string_from_utf8_string_view(string))

## Ported from AK/Utf16FlyString.h:25 AK::Utf16FlyString::from_utf8(String const&).
pub func utf16_fly_string_from_utf8_string(string: const String*) -> Utf16FlyString:
    return utf16_fly_string_from_utf8_without_validation(string_bytes_as_string_view(string))

## Ported from AK/Utf16FlyString.h:26 AK::Utf16FlyString::from_utf8(FlyString const&).
pub func utf16_fly_string_from_utf8_fly_string(string: const FlyString*) -> Utf16FlyString:
    return utf16_fly_string_from_utf8_without_validation(fly_string_bytes_as_string_view(string))

## Ported from AK/Utf16FlyString.cpp:63 AK::Utf16FlyString::from_utf8_without_validation.
pub func utf16_fly_string_from_utf8_without_validation(string: StringView) -> Utf16FlyString:
    if let result = utf16_fly_string_create_fly_string_from_cache_string_view(string):
        return result
    return utf16_fly_string_from_utf16_string(utf16_string_from_utf8_without_validation(string))

## Ported from AK/Utf16FlyString.h:28 AK::Utf16FlyString::from_utf8_but_should_be_ported_to_utf16.
pub func utf16_fly_string_from_utf8_but_should_be_ported_to_utf16(string: StringView) -> Utf16FlyString:
    return utf16_fly_string_from_utf8_without_validation(string)

## Ported from AK/Utf16FlyString.cpp:70 AK::Utf16FlyString::from_utf16.
pub func utf16_fly_string_from_utf16(string: Utf16View) -> Utf16FlyString:
    if let result = utf16_fly_string_create_fly_string_from_cache_utf16_view(string):
        return result
    return utf16_fly_string_from_utf16_string(utf16_string_from_utf16(string))

## Ported from AK/Utf16FlyString.cpp:77 AK::Utf16FlyString::Utf16FlyString(Utf16String const&):
## interns `string`.
pub func utf16_fly_string_construct_utf16_string(this: Utf16FlyString*, string: const Utf16String*):
    if utf16_string_base_has_short_ascii_storage(&string.utf16_string_base):
        this.m_data = string.utf16_string_base
        return

    let data = utf16_string_base_data(&string.utf16_string_base) else trap("VERIFY: Utf16String data")

    if utf16_string_data_is_fly_string(data):
        this.m_data = string.utf16_string_base
        return

    var it = hash_table_find_t(all_utf16_fly_strings(), (const Utf16StringData*?)data)
    if hash_table_iterator_eq(&it, hash_table_end(all_utf16_fly_strings())):
        this.m_data = string.utf16_string_base

        discard(hash_table_set(all_utf16_fly_strings(), (const Utf16StringData*?)data))
        utf16_string_data_mark_as_fly_string(data)
    else:
        utf16_string_base_set_data(&this.m_data, *hash_table_iterator_deref(&it) else trap("VERIFY: null Utf16StringData"))

## `Utf16FlyString { string }`: the value form of the Utf16String constructor.
pub func utf16_fly_string_from_utf16_string(string: Utf16String) -> Utf16FlyString:
    var result = utf16_fly_string_new()
    utf16_fly_string_construct_utf16_string(&result, &string)
    return result

## `Utf16FlyString {}`: the empty string.
pub func utf16_fly_string_new() -> Utf16FlyString:
    return Utf16FlyString(m_data = utf16_string_base_new())

## `u"text"_utf16_fly_string` from a `str`.
pub func utf16_fly_string_from_str(text: str) -> Utf16FlyString:
    return literalutf16_fly_string_u8(text.bytes.data, text.length)

