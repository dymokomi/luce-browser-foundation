## Ported from AK/Utf16FlyString.h:50 AK::Utf16FlyString::to_ascii_lowercase.
pub func utf16_fly_string_to_ascii_lowercase(this: const Utf16FlyString*) -> Utf16FlyString:
    let view = utf16_string_base_utf16_view(&this.m_data)

    var has_upper = false
    if utf16_view_has_ascii_storage(&view):
        for byte in utf16_view_ascii_span(&view):
            if is_ascii_upper_alpha(byte):
                has_upper = true
                break
    else:
        for code_unit in utf16_view_utf16_span(&view):
            if is_ascii_upper_alpha(code_unit):
                has_upper = true
                break
    if not has_upper:
        return *this

    return utf16_fly_string_from_utf16_string(utf16_view_to_ascii_lowercase(&view))

## Ported from AK/Utf16FlyString.h:65 AK::Utf16FlyString::to_ascii_uppercase.
pub func utf16_fly_string_to_ascii_uppercase(this: const Utf16FlyString*) -> Utf16FlyString:
    let view = utf16_string_base_utf16_view(&this.m_data)

    var has_lower = false
    if utf16_view_has_ascii_storage(&view):
        for byte in utf16_view_ascii_span(&view):
            if is_ascii_lower_alpha(byte):
                has_lower = true
                break
    else:
        for code_unit in utf16_view_utf16_span(&view):
            if is_ascii_lower_alpha(code_unit):
                has_lower = true
                break
    if not has_lower:
        return *this

    return utf16_fly_string_from_utf16_string(utf16_view_to_ascii_uppercase(&view))

## Ported from AK/Utf16FlyString.h:80 AK::Utf16FlyString::to_ascii_titlecase.
pub func utf16_fly_string_to_ascii_titlecase(this: const Utf16FlyString*) -> Utf16FlyString:
    let view = utf16_fly_string_view(this)
    return utf16_fly_string_from_utf16_string(utf16_view_to_ascii_titlecase(&view))

