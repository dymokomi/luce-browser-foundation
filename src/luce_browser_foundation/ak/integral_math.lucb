#==============================================================================================
#
#   integral_math - exp2, log2, ceil_log2, reinterpret_as_octal, gcd and lcm on integers
#
#   DESCRIPTION:
#       Port of AK/IntegralMath.h (lines 1-145), each template instantiated per integer type
#       with the type as a suffix (`ceil_log2_usize`), and of the count_leading_zeroes of
#       AK/BuiltinWrappers.h that log2 uses.
#
#==============================================================================================

# mark: count_leading_zeroes ====================================================================

# BuiltinWrappers.h count_leading_zeroes for u8 (__builtin_clz*: undefined for zero).
func count_leading_zeroes_u8(value: u8) -> i32:
    assert(value != 0)
    var count: i32 = 0
    var bit: u8 = (u8)1 << (8 - 1)
    while (value & bit) == 0:
        count += 1
        bit = bit >> 1
    return count

# BuiltinWrappers.h count_leading_zeroes for u16 (__builtin_clz*: undefined for zero).
func count_leading_zeroes_u16(value: u16) -> i32:
    assert(value != 0)
    var count: i32 = 0
    var bit: u16 = (u16)1 << (16 - 1)
    while (value & bit) == 0:
        count += 1
        bit = bit >> 1
    return count

# BuiltinWrappers.h count_leading_zeroes for u32 (__builtin_clz*: undefined for zero).
func count_leading_zeroes_u32(value: u32) -> i32:
    assert(value != 0)
    var count: i32 = 0
    var bit: u32 = (u32)1 << (32 - 1)
    while (value & bit) == 0:
        count += 1
        bit = bit >> 1
    return count

# BuiltinWrappers.h count_leading_zeroes for u64 (__builtin_clz*: undefined for zero).
func count_leading_zeroes_u64(value: u64) -> i32:
    assert(value != 0)
    var count: i32 = 0
    var bit: u64 = (u64)1 << (64 - 1)
    while (value & bit) == 0:
        count += 1
        bit = bit >> 1
    return count

# BuiltinWrappers.h count_leading_zeroes for usize (__builtin_clz*: undefined for zero).
func count_leading_zeroes_usize(value: usize) -> i32:
    assert(value != 0)
    var count: i32 = 0
    var bit: usize = (usize)1 << (64 - 1)
    while (value & bit) == 0:
        count += 1
        bit = bit >> 1
    return count

# mark: exp2, log2, ceil_log2 ===================================================================

## Ported from AK/IntegralMath.h:16 AK::exp2, for i8.
pub func exp2_i8(exponent: i8) -> i8:
    return (i8)1 << exponent

## Ported from AK/IntegralMath.h:16 AK::exp2, for i16.
pub func exp2_i16(exponent: i16) -> i16:
    return (i16)1 << exponent

## Ported from AK/IntegralMath.h:16 AK::exp2, for i32.
pub func exp2_i32(exponent: i32) -> i32:
    return (i32)1 << exponent

## Ported from AK/IntegralMath.h:16 AK::exp2, for i64.
pub func exp2_i64(exponent: i64) -> i64:
    return (i64)1 << exponent

## Ported from AK/IntegralMath.h:16 AK::exp2, for u8.
pub func exp2_u8(exponent: u8) -> u8:
    return (u8)1 << exponent

## Ported from AK/IntegralMath.h:16 AK::exp2, for u16.
pub func exp2_u16(exponent: u16) -> u16:
    return (u16)1 << exponent

## Ported from AK/IntegralMath.h:16 AK::exp2, for u32.
pub func exp2_u32(exponent: u32) -> u32:
    return (u32)1 << exponent

## Ported from AK/IntegralMath.h:16 AK::exp2, for u64.
pub func exp2_u64(exponent: u64) -> u64:
    return (u64)1 << exponent

## Ported from AK/IntegralMath.h:16 AK::exp2, for usize.
pub func exp2_usize(exponent: usize) -> usize:
    return (usize)1 << exponent

## Ported from AK/IntegralMath.h:22 AK::log2, for i8.
pub func log2_i8(x: i8) -> i8:
    if x == 0:
        return 0
    return (i8)((8 - 1) - count_leading_zeroes_u8((u8)x))

## Ported from AK/IntegralMath.h:22 AK::log2, for i16.
pub func log2_i16(x: i16) -> i16:
    if x == 0:
        return 0
    return (i16)((16 - 1) - count_leading_zeroes_u16((u16)x))

## Ported from AK/IntegralMath.h:22 AK::log2, for i32.
pub func log2_i32(x: i32) -> i32:
    if x == 0:
        return 0
    return (i32)((32 - 1) - count_leading_zeroes_u32((u32)x))

## Ported from AK/IntegralMath.h:22 AK::log2, for i64.
pub func log2_i64(x: i64) -> i64:
    if x == 0:
        return 0
    return (i64)((64 - 1) - count_leading_zeroes_u64((u64)x))

## Ported from AK/IntegralMath.h:22 AK::log2, for u8.
pub func log2_u8(x: u8) -> u8:
    if x == 0:
        return 0
    return (u8)((8 - 1) - count_leading_zeroes_u8((u8)x))

