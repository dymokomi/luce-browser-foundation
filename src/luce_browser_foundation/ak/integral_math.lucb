# mark: reinterpret_as_octal, gcd, lcm ==========================================================

## Ported from AK/IntegralMath.h:77 AK::reinterpret_as_octal, for u32.
pub func reinterpret_as_octal_u32(decimal: u32) -> u32:
    var value = decimal
    var result: u32 = 0
    var n: u32 = 0
    while value > 0:
        result += pow_integral_u32(8, n) * (value % 10)
        n += 1
        value = value // 10
    return result

## Ported from AK/IntegralMath.h:77 AK::reinterpret_as_octal, for u64.
pub func reinterpret_as_octal_u64(decimal: u64) -> u64:
    var value = decimal
    var result: u64 = 0
    var n: u64 = 0
    while value > 0:
        result += pow_integral_u64(8, n) * (value % 10)
        n += 1
        value = value // 10
    return result

## Ported from AK/IntegralMath.h:77 AK::reinterpret_as_octal, for usize.
pub func reinterpret_as_octal_usize(decimal: usize) -> usize:
    var value = decimal
    var result: usize = 0
    var n: usize = 0
    while value > 0:
        result += pow_integral_usize(8, n) * (value % 10)
        n += 1
        value = value // 10
    return result

## Ported from AK/IntegralMath.h:89 AK::gcd (unsigned), for u32.
pub func gcd_u32(x: u32, y: u32) -> u32:
    var a = x
    var b = y
    if a == 0:
        return b
    if b == 0:
        return a
    var shift: u32 = 0
    while ((a | b) & 1) == 0:
        a = a >> 1
        b = b >> 1
        shift += 1
    while a != b:
        if (a & 1) != 0:
            if (b & 1) != 0:
                if a > b:
                    a -= b
                else:
                    b -= a
            else:
                b = b >> 1
        else:
            a = a >> 1
            if (b & 1) != 0:
                if a < b:
                    swap_5(&a, &b)
    return a << shift

## Ported from AK/IntegralMath.h:89 AK::gcd (unsigned), for u64.
pub func gcd_u64(x: u64, y: u64) -> u64:
    var a = x
    var b = y
    if a == 0:
        return b
    if b == 0:
        return a
    var shift: u64 = 0
    while ((a | b) & 1) == 0:
        a = a >> 1
        b = b >> 1
        shift += 1
    while a != b:
        if (a & 1) != 0:
            if (b & 1) != 0:
                if a > b:
                    a -= b
                else:
                    b -= a
            else:
                b = b >> 1
        else:
            a = a >> 1
            if (b & 1) != 0:
                if a < b:
                    swap_5(&a, &b)
    return a << shift

## Ported from AK/IntegralMath.h:89 AK::gcd (unsigned), for usize.
pub func gcd_usize(x: usize, y: usize) -> usize:
    var a = x
    var b = y
    if a == 0:
        return b
    if b == 0:
        return a
    var shift: usize = 0
    while ((a | b) & 1) == 0:
        a = a >> 1
        b = b >> 1
        shift += 1
    while a != b:
        if (a & 1) != 0:
            if (b & 1) != 0:
                if a > b:
                    a -= b
                else:
                    b -= a
            else:
                b = b >> 1
        else:
            a = a >> 1
            if (b & 1) != 0:
                if a < b:
                    swap_5(&a, &b)
    return a << shift

## Ported from AK/IntegralMath.h:132 AK::lcm (unsigned), for u32.
pub func lcm_u32(x: u32, y: u32) -> u32:
    if x == 0 or y == 0:
        return 0
    return x // gcd_u32(x, y) * y

## Ported from AK/IntegralMath.h:132 AK::lcm (unsigned), for u64.
pub func lcm_u64(x: u64, y: u64) -> u64:
    if x == 0 or y == 0:
        return 0
    return x // gcd_u64(x, y) * y

## Ported from AK/IntegralMath.h:132 AK::lcm (unsigned), for usize.
pub func lcm_usize(x: usize, y: usize) -> usize:
    if x == 0 or y == 0:
        return 0
    return x // gcd_usize(x, y) * y

# IntegralMath.h:38 AK::pow<I> (integral exponentiation by squaring), for u32.
func pow_integral_u32(base: u32, exponent: u32) -> u32:
    # https://en.wikipedia.org/wiki/Exponentiation_by_squaring
    if exponent == 0:
        return 1
    var b = base
    var e = exponent
    var res: u32 = 1
    while e > 0:
        if (e & 1) != 0:
            res = res *% b
        b = b *% b
        e = e // 2
    return res

# IntegralMath.h:38 AK::pow<I> (integral exponentiation by squaring), for u64.
func pow_integral_u64(base: u64, exponent: u64) -> u64:
    # https://en.wikipedia.org/wiki/Exponentiation_by_squaring
    if exponent == 0:
        return 1
    var b = base
    var e = exponent
    var res: u64 = 1
    while e > 0:
        if (e & 1) != 0:
            res = res *% b
        b = b *% b
        e = e // 2
    return res

# IntegralMath.h:38 AK::pow<I> (integral exponentiation by squaring), for usize.
func pow_integral_usize(base: usize, exponent: usize) -> usize:
    # https://en.wikipedia.org/wiki/Exponentiation_by_squaring
    if exponent == 0:
        return 1
    var b = base
    var e = exponent
    var res: usize = 1
    while e > 0:
        if (e & 1) != 0:
            res = res *% b
        b = b *% b
        e = e // 2
    return res

## Ported from AK/IntegralMath.h:125 AK::gcd (signed), for i32.
pub func gcd_i32(x: i32, y: i32) -> i32:
    return (i32)gcd_u32((u32)abs_i32(x), (u32)abs_i32(y))

## Ported from AK/IntegralMath.h:125 AK::gcd (signed), for i64.
pub func gcd_i64(x: i64, y: i64) -> i64:
    return (i64)gcd_u64((u64)abs_i64(x), (u64)abs_i64(y))

## Ported from AK/IntegralMath.h:140 AK::lcm (signed), for i32.
pub func lcm_i32(x: i32, y: i32) -> i32:
    return (i32)lcm_u32((u32)abs_i32(x), (u32)abs_i32(y))

## Ported from AK/IntegralMath.h:140 AK::lcm (signed), for i64.
pub func lcm_i64(x: i64, y: i64) -> i64:
    return (i64)lcm_u64((u64)abs_i64(x), (u64)abs_i64(y))
