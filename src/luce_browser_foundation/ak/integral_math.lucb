## Ported from AK/IntegralMath.h:28 AK::ceil_log2, for i8.
pub func ceil_log2_i8(x: i8) -> i8:
    if x <= 1:
        return 0
    return log2_i8(x - 1) + 1

## Ported from AK/IntegralMath.h:28 AK::ceil_log2, for i16.
pub func ceil_log2_i16(x: i16) -> i16:
    if x <= 1:
        return 0
    return log2_i16(x - 1) + 1

