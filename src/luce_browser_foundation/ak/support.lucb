pub struct Function3[A1, A2, A3, R]:
    pub var call: (func(void*?, A1, A2, A3) -> R)?
    pub var context: void*?

## AK::Function<R(A1, A2, A3, A4)>: a function pointer beside its capture context (DESIGN.md §2.7).
pub struct Function4[A1, A2, A3, A4, R]:
    pub var call: (func(void*?, A1, A2, A3, A4) -> R)?
    pub var context: void*?

## AK::Function<R(A1, A2, A3, A4, A5)>: a function pointer beside its capture context (DESIGN.md §2.7).
pub struct Function5[A1, A2, A3, A4, A5, R]:
    pub var call: (func(void*?, A1, A2, A3, A4, A5) -> R)?
    pub var context: void*?

## AK::Function<R(A1, A2, A3, A4, A5, A6)>: a function pointer beside its capture context (DESIGN.md §2.7).
pub struct Function6[A1, A2, A3, A4, A5, A6, R]:
