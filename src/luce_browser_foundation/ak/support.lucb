pub struct Function7[A1, A2, A3, A4, A5, A6, A7, R]:
    pub var call: (func(void*?, A1, A2, A3, A4, A5, A6, A7) -> R)?
    pub var context: void*?

## AK::Function<R(A1, A2, A3, A4, A5, A6, A7, A8)>: a function pointer beside its capture context (DESIGN.md §2.7).
pub struct Function8[A1, A2, A3, A4, A5, A6, A7, A8, R]:
