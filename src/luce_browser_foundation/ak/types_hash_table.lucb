## AK::HashSetResult (AK/HashTable.h:22).
pub enum HashSetResult as i32:
    inserted_new_entry = 0
    replaced_existing_entry = 1
    kept_existing_entry = 2

## AK::HashSetExistingEntryBehavior (AK/HashTable.h:28).
pub enum HashSetExistingEntryBehavior as i32:
    keep = 0
    replace = 1

## AK::BucketState (AK/HashTable.h:37). BucketState doubles as both an enum and a probe length
## value: Free is an empty bucket, 1..254 a used bucket whose probe length is the value minus 1,
## CalculateLength a used bucket whose probe length is over 253 and must be computed. Buckets
## store it as a u8 (HashTableBucket.state).
pub enum BucketState as u8:
    free_ = 0
    calculate_length = 255

# mark: HashTableIterator =======================================================================

## AK::HashTableIterator and AK::OrderedHashTableIterator (AK/HashTable.h:43, 78): the bucket an
## iteration is at (none at the end). An unordered table's iterator steps through the bucket
## array to `m_end_bucket`; an ordered one follows the buckets' `next` links. Also a luce-base
## iterator yielding a pointer to each value, so `for value in hash_table_begin(&table):` walks
## the table in the donor's order.
pub struct HashTableIterator[T]: luce.Iterable[T*, HashTableIterator[T]], luce.Iterator[T*]:
    pub var m_bucket: HashTableBucket[T]*?  # C++ default: { nullptr }
    pub var m_end_bucket: HashTableBucket[T]*?  # C++ default: { nullptr }
    pub var m_ordered: bool

    func iterator() -> HashTableIterator[T]: return self

    mutating func next() -> T*?: return hash_table_iterator_next(&self)

# mark: OrderedHashTableIterator ================================================================

## AK::OrderedHashTableIterator (AK/HashTable.h:78): a bucket of an ordered table, stepping along
## its `next` links.
pub struct OrderedHashTableIterator[T]:
    pub var m_bucket: HashTableBucket[T]*?  # C++ default: { nullptr }

# mark: ReverseOrderedHashTableIterator =========================================================

## AK::ReverseOrderedHashTableIterator (AK/HashTable.h:99): a bucket of an ordered table, stepping
## along its `previous` links; also a luce-base iterator (`for value in ordered_hash_table_rbegin(&t):`).
pub struct ReverseOrderedHashTableIterator[T]: luce.Iterable[T*, ReverseOrderedHashTableIterator[T]], luce.Iterator[T*]:
    pub var m_bucket: HashTableBucket[T]*?  # C++ default: { nullptr }

    func iterator() -> ReverseOrderedHashTableIterator[T]: return self

    mutating func next() -> T*?: return reverse_ordered_hash_table_iterator_next(&self)

## AK::HashTable::LookupForWritingResult (AK/HashTable.h:700).
pub struct LookupForWritingResult[T]:
    pub var result: HashSetResult
    pub var bucket: HashTableBucket[T]*
    # Only meaningful for InsertedNewEntry: the probe length to stamp when the caller commits.
    pub var probe_length: usize
