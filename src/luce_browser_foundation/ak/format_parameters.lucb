#==============================================================================================
#
#   format_parameters - type-erased format arguments and the formatter entry of each kind
#
#   DESCRIPTION:
#       Port of the inline half of AK/Format.h (lines 1-367): __format_value, the
#       TypeErasedParameter kinds, FormatBuilder's inline members and TypeErasedFormatParams.
#
#       C++ builds the arguments of `format("{} {}", a, b)` with a variadic template
#       (VariadicFormatParams) that erases each argument to a TypeErasedParameter and, for any
#       other type, remembers `__format_value<T>` as its formatter. luce-base has neither
#       variadic functions nor templates that pick a formatter by type, so a caller writes the
#       erased arguments itself, one `arg_*` call per argument, and hands the span to
#       `vformat_arguments` (or builds a TypeErasedFormatParams with
#       `type_erased_format_params_create` for `vformat`, String::vformatted and friends):
#
#           try ak.vformat_arguments(&builder, sv, [ak.arg_u64(x), ak.arg_custom(&v, ak.format_value_json_value)])
#
#       A custom type's formatter is any function with the CustomType formatter signature;
#       `format_value_<type>` are the ported ones. The generic `__format_value<T>` becomes one
#       such function per type, and TypeErasedParameter::visit becomes a `match` at its two
#       users (vformat_impl and to_size).
#
#==============================================================================================

# mark: Helpers =================================================================================

## Ported from AK/Format.h:41 AK::is_debug_only_formatter. Only Formatter<ErrorOr<T>> is
## debug-only in AK; ErrorOr<T> is `T!` in luce-base and never a value to format, so no
## formatter of the port is.
pub func is_debug_only_formatter[TFormatter]() -> bool:
    return false

# mark: __format_value ==========================================================================

## The default Formatter<T> state: StandardFormatter's default member initializers.
pub func standard_formatter_construct(this: StandardFormatter*):
    standard_formatter_init_fields(this)

## A default-constructed StandardFormatter (`Formatter<T> formatter;`).
pub func standard_formatter_create() -> StandardFormatter:
    var formatter: StandardFormatter
    standard_formatter_construct(&formatter)
    return formatter

## The value behind a CustomType or parameter pointer; C++ dereferences it unchecked.
func format_value_target(value: const void*?) -> const void*:
    return value else trap("VERIFY_NOT_REACHED: null format value")

## Ported from AK/Format.h:55 AK::__format_value<u64> (TypeErasedParameter::Type::UnsignedInteger).
pub func format_value_u64(params: TypeErasedFormatParams*, builder: FormatBuilder*, parser: FormatParser*, value: const void*?) -> !:
    var formatter = standard_formatter_create()
    standard_formatter_parse(&formatter, params, parser)
    try formatter_u64_format(&formatter, builder, *(const u64*)format_value_target(value))

## Ported from AK/Format.h:55 AK::__format_value<i64> (TypeErasedParameter::Type::SignedInteger).
pub func format_value_i64(params: TypeErasedFormatParams*, builder: FormatBuilder*, parser: FormatParser*, value: const void*?) -> !:
    var formatter = standard_formatter_create()
    standard_formatter_parse(&formatter, params, parser)
    try formatter_i64_format(&formatter, builder, *(const i64*)format_value_target(value))

## Ported from AK/Format.h:55 AK::__format_value<bool> (TypeErasedParameter::Type::Boolean).
pub func format_value_bool(params: TypeErasedFormatParams*, builder: FormatBuilder*, parser: FormatParser*, value: const void*?) -> !:
    var formatter = standard_formatter_create()
    standard_formatter_parse(&formatter, params, parser)
    try formatter_bool_format(&formatter, builder, *(const bool*)format_value_target(value))

