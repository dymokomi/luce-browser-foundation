# mark: DoublyLinkedListIterator ================================================================

## AK::DoublyLinkedListIterator (AK/DoublyLinkedList.h:16): the node an iteration is at (none at
## the end); also a luce-base iterator yielding a pointer to each value.
pub struct DoublyLinkedListIterator[T]: luce.Iterable[T*, DoublyLinkedListIterator[T]], luce.Iterator[T*]:
    pub var m_node: DoublyLinkedListNode[T]*?

    pub func iterator() -> DoublyLinkedListIterator[T]: return self

    pub mutating func next() -> T*?: return doubly_linked_list_iterator_next(&self)

# mark: DoublyLinkedList ========================================================================

## AK::DoublyLinkedList (AK/DoublyLinkedList.h:39): a zero DoublyLinkedList is empty.
pub struct DoublyLinkedList[T]:
    pub var m_head: DoublyLinkedListNode[T]*?  # C++ default: { nullptr }
    pub var m_tail: DoublyLinkedListNode[T]*?  # C++ default: { nullptr }
    pub var m_size: usize  # C++ default: { 0 }

## AK::DoublyLinkedList::Node (AK/DoublyLinkedList.h:43).
pub struct DoublyLinkedListNode[T]:
    pub var next: DoublyLinkedListNode[T]*?  # C++ default: { nullptr }
    pub var prev: DoublyLinkedListNode[T]*?  # C++ default: { nullptr }
    pub var m_value: T
