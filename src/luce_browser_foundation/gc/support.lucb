## GC::Weak<T> (LibGC/Weak.h): a weak reference through a WeakImpl.
pub struct Weak[T]:
    pub var m_impl: void*?

## GC::Function<R()>: a cell holding an escaping callback and its captures (scanned conservatively, as LibGC does).
pub struct Function0[R]: IsCell:
    pub var cell_base: Cell
    pub var function: ak.Function0[R]

    pub func cell() -> Cell*: return (Cell*)&self

