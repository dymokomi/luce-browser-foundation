#==============================================================================================
#
#   heap_1 - Heap: construction, cell allocation, registration of roots, possible pointers
#
#   DESCRIPTION:
#       Port of Libraries/LibGC/Heap.cpp (lines 1-127: the heap, will_allocate,
#       add_possible_value, find_min_and_max_block_addresses, for_each_cell_among_possible_pointers)
#       and of Heap.h's inline functions (lines 1-254). `Heap::allocate<T>(args...)` is
#       heap_allocate_cell followed by the caller's construction under DeferGC (DESIGN.md §2.3);
#       Base cannot ask T for its allocator, so the caller passes its type-isolating allocator,
#       or none for a size-based one. Cells come back zeroed with a live Cell header.
#
#==============================================================================================

assert(heap_block_min_possible_cell_size <= 32, "Heap Cell tracking uses too much data!")

# mark: The heap ================================================================================

## Ported from Libraries/LibGC/Heap.cpp:43 GC::Heap::the.
pub func heap_the() -> Heap*:
    return s_the else trap("GC::Heap::the: no heap")

## Ported from Libraries/LibGC/Heap.cpp:48 GC::Heap::Heap. The heap belongs to the thread that
## constructs it: its stack is the one gather_conservative_roots scans.
pub func heap_construct(this: Heap*, gather_embedder_roots: ak.Function1[GcHashMap[HeapRoot]*, unit]):
    heap_init_fields(this)
    ak.stack_info_construct(&this.m_stack_info)
    this.m_gather_embedder_roots = gather_embedder_roots
    s_the = this
    for cell_size in cell_size_classes:
        let allocator = (new CellAllocator in memory.heap) else trap("out of memory")
        cell_allocator_construct(allocator, cell_size)
        gc_vector_append(&this.m_size_based_cell_allocators, allocator)
    heap_construct_blob_allocators(this)
    # Addition (DESIGN.md §3.3 rule 5, §4.1.1): AK's atomic storage on this thread comes from
    # this heap's atomic blobs from now on.
    ak.atomic_allocator = heap_atomic_allocator(this)

## The size classes of the size-based cell allocators (and of the blobs).
let cell_size_classes: usize[7] = [64, 96, 128, 256, 512, 1024, 3072]

## Ported from Libraries/LibGC/Heap.cpp:62 GC::Heap::~Heap: collect everything, then what the
## members' destructors do: the size-based allocators give their cached blocks back to the OS.
## Type-isolating allocators outlive the heap, as in C++ (they are static there); they are
## unlinked so that they register with the next heap. Weak blocks are leaked, as in C++.
pub func heap_destroy(this: Heap*):
    heap_collect_garbage(this, HeapCollectionType.collect_everything)
    # Addition: AK's atomic storage goes back to the current allocator.
    ak.atomic_allocator = none

    while let node = list_first(&this.m_all_cell_allocators):
        list_node_remove(node)
    for allocator in gc_vector_span(&this.m_size_based_cell_allocators):
        block_allocator_destroy(&allocator.m_block_allocator)
        free(allocator) in memory.heap
    gc_vector_clear(&this.m_size_based_cell_allocators)
    heap_destroy_blob_allocators(this)
    gc_vector_clear(&this.m_uprooted_cells)
    gc_vector_clear(&this.m_post_gc_tasks)
    gc_vector_clear(&this.m_sweep_callbacks)
    gc_hash_map_clear(&this.m_weak_impls)
    if s_the == this:
        s_the = none

