## Ported from Libraries/LibGC/Heap.h:65 GC::Heap::set_should_collect_on_every_allocation.
pub func heap_set_should_collect_on_every_allocation(this: Heap*, b: bool):
    this.m_should_collect_on_every_allocation = b

## Ported from Libraries/LibGC/Heap.h:189 GC::Heap::did_create_root.
pub func heap_did_create_root(this: Heap*, impl: RootImpl*):
    assert(not list_contains(&this.m_roots, &impl.m_list_node))
    list_append(&this.m_roots, &impl.m_list_node)

## Ported from Libraries/LibGC/Heap.h:195 GC::Heap::did_destroy_root.
pub func heap_did_destroy_root(this: Heap*, impl: RootImpl*):
    assert(list_contains(&this.m_roots, &impl.m_list_node))
    list_remove(&this.m_roots, &impl.m_list_node)

