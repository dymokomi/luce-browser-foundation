#==============================================================================================
#
#   function - GC::Function: an escaping callback held by a cell
#
#   DESCRIPTION:
#       Port of Libraries/LibGC/Function.h (lines 1-54). A GC::Function<T> is a cell around an
#       AK::Function (a call pointer and its capture context, DESIGN.md §2.7); visit_edges scans
#       the function's words conservatively, which marks the capture blob, which is scanned in
#       turn: exactly LibGC's visit_possible_values(m_function.raw_capture_range()). Every
#       arity has the same layout, so one vtable and one type-isolating allocator serve all of
#       them (C++ instantiates GC_DEFINE_ALLOCATOR per T). create_function<Callable> is one
#       function per arity, create_function0 to create_function8.
#
#==============================================================================================

## The allocator of GC::Function cells (GC_DECLARE_ALLOCATOR(Function)), constructed on first use.
var function_cell_allocator: TypeIsolatingCellAllocator[Function0[unit]]

## The vtable of GC::Function (GC_CELL(Function, Cell)).
pub let function_vtable: CellVTable = CellVTable(class_info = &function_class, class_name = function_class_name_impl, visit_edges = function_visit_edges_impl)

## Class information of GC::Function.
pub let function_class: ak.ClassInfo = ak.ClassInfo(name = "Function", first_id = 0, last_id = 0, size = sizeof(Function0[unit]), vtable = (const void*)&function_vtable)

assert(sizeof(Function8[u8, u8, u8, u8, u8, u8, u8, u8, u8]) == sizeof(Function0[unit]))

## GC_CELL(Function, Cell): the class name.
func function_class_name_impl(this: Cell*) -> ak.StringView:
    return ak.sv("Function")

## Ported from Libraries/LibGC/Function.h:36 GC::Function::visit_edges (override).
func function_visit_edges_impl(this: Cell*, visitor: CellVisitor*):
    cell_visit_edges_impl(this, visitor)
    let function = (u8*)this + offsetof(Function0[unit], function)
    cell_visitor_visit_possible_values(visitor, u8[](function, sizeof(ak.Function0[unit])))

## Ported from Libraries/LibGC/Function.h:22 GC::Function::create, up to the construction:
## heap.allocate<Function>(...) allocates the cell and holds DeferGC while the caller stores the
## function; the caller undefers.
func function_allocate(heap: Heap*) -> Cell*:
    if function_cell_allocator.allocator.m_cell_size == 0:
        type_isolating_cell_allocator_construct(&function_cell_allocator, ak.sv("Function"), false, false)
    let cell = heap_allocate_cell[Function0[unit]](heap, &function_cell_allocator.allocator)
    heap_defer_gc(heap)
    cell.vtable = &function_vtable
    return cell

## Ported from Libraries/LibGC/Function.h:46 GC::create_function (GC::Function<R()>).
pub func create_function0[R](heap: Heap*, function: ak.Function0[R]) -> Function0[R]*:
    let this = (Function0[R]*)function_allocate(heap)
    this.function = function
    heap_undefer_gc(heap)
    return this

## Ported from Libraries/LibGC/Function.h:46 GC::create_function (GC::Function<R(A1)>).
pub func create_function1[A1, R](heap: Heap*, function: ak.Function1[A1, R]) -> Function1[A1, R]*:
    let this = (Function1[A1, R]*)function_allocate(heap)
    this.function = function
    heap_undefer_gc(heap)
    return this

