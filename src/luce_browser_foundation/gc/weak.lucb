#==============================================================================================
#
#   weak - WeakImpl and Weak<T>: references that do not keep a cell alive
#
#   DESCRIPTION:
#       Port of Libraries/LibGC/Weak.h (lines 1-186) and WeakInlines.h (lines 1-113). A Weak<T>
#       holds a WeakImpl from the heap's weak blocks; when the cell dies, WeakBlock::sweep clears
#       the impl's pointer. A null Weak<T> points at the_null_weak_impl in C++; in the port its
#       impl is none, which reads the same. Copying a Weak copies the impl pointer: the port has no
#       destructors to count references with, so the collector traces them instead
#       (heap_blobs.lucb), and a WeakImpl is freed when no scanned word refers to it.
#
#==============================================================================================

# mark: WeakImpl ================================================================================

## Ported from Libraries/LibGC/Weak.h:24 GC::WeakImpl::WeakImpl.
pub func weak_impl_construct(this: WeakImpl*, ptr: void*?):
    this.m_ref_count = 0
    this.m_state = WeakImplState.allocated
    this.m_ptr = ptr

## Ported from Libraries/LibGC/Weak.h:29 GC::WeakImpl::ptr.
pub func weak_impl_ptr(this: const WeakImpl*) -> void*?:
    return this.m_ptr

## Ported from Libraries/LibGC/Weak.h:30 GC::WeakImpl::set_ptr.
pub func weak_impl_set_ptr(this: WeakImpl*, ptr: void*?):
    this.m_ptr = ptr

## Ported from Libraries/LibGC/Weak.h:32 GC::WeakImpl::operator==.
pub func weak_impl_eq(this: const WeakImpl*, other: WeakImpl) -> bool:
    return this.m_ptr == other.m_ptr

## Ported from Libraries/LibGC/Weak.h:33 GC::WeakImpl::operator!=.
pub func weak_impl_ne(this: const WeakImpl*, other: WeakImpl) -> bool:
    return this.m_ptr != other.m_ptr

## Ported from Libraries/LibGC/Weak.h:35 GC::WeakImpl::ref.
pub func weak_impl_ref(this: const WeakImpl*):
    let mutable_this = (WeakImpl*)this  # mutable size_t m_ref_count
    mutable_this.m_ref_count += 1

## Ported from Libraries/LibGC/Weak.h:36 GC::WeakImpl::unref.
pub func weak_impl_unref(this: const WeakImpl*):
    let mutable_this = (WeakImpl*)this
    assert(mutable_this.m_ref_count != 0)
    mutable_this.m_ref_count -= 1

## Ported from Libraries/LibGC/Weak.h:42 GC::WeakImpl::ref_count.
pub func weak_impl_ref_count(this: const WeakImpl*) -> usize:
    return this.m_ref_count

## Ported from Libraries/LibGC/Weak.h:49 GC::WeakImpl::set_state.
pub func weak_impl_set_state(this: WeakImpl*, state: WeakImplState):
    this.m_state = state

## Ported from Libraries/LibGC/Weak.h:50 GC::WeakImpl::state.
pub func weak_impl_state(this: const WeakImpl*) -> WeakImplState:
    return this.m_state

# mark: Weak ====================================================================================

## Ported from Libraries/LibGC/WeakInlines.h:15 GC::Weak::Weak (T const*): a weak reference to
## `ptr`, or a null one.
pub func weak_construct[T: IsCell](this: Weak[T]*, ptr: T*?):
    if let cell = ptr:
        let impl = heap_create_weak_impl(cell_heap(cell.cell()), cell.cell())
        weak_impl_ref(impl)  # NonnullRefPtr<WeakImpl>
        this.m_impl = impl
    else:
        this.m_impl = none

## Ported from Libraries/LibGC/WeakInlines.h:15 GC::Weak::Weak (T const*), as a value.
pub func make_weak[T: IsCell](ptr: T*?) -> Weak[T]:
    var weak: Weak[T]
    weak_construct(&weak, ptr)
    return weak

## Ported from Libraries/LibGC/WeakInlines.h:96 GC::Weak::operator= (T const*).
pub func weak_assign[T: IsCell](this: Weak[T]*, other: T*?):
    if (void*?)weak_ptr(this) != (void*?)other:
        weak_construct(this, other)

## Ported from Libraries/LibGC/Weak.h:118 GC::Weak::ptr: the cell, or none once it died.
pub func weak_ptr[T](this: const Weak[T]*) -> T*?:
    let impl = weak_impl(this) else return none
    return (T*?)weak_impl_ptr(impl)

## Ported from Libraries/LibGC/Weak.h:131 GC::Weak::impl (none for a null Weak).
pub func weak_impl[T](this: const Weak[T]*) -> WeakImpl*?:
    return (WeakImpl*?)this.m_impl

## Ported from Libraries/LibGC/Weak.h:154 GC::weak_callback: a callback that runs `callback` on
## `obj` while `obj` lives. (C++ forwards any further arguments; the port's has none.)
# NOTE: Unlike GC::Function, captures in this callback are not visited by the garbage collector.
#       Do not capture GC-managed objects without ensuring they are kept alive through other means.
pub func weak_callback[T: IsCell](obj: T*, callback: ak.Function1[T*, unit]) -> WeakCallback[T]:
    return WeakCallback[T](weak = make_weak[T](obj), cb = callback)

## The call of the lambda weak_callback returns: `if (weak) cb(*weak)`.
pub func weak_callback_call[T](this: const WeakCallback[T]*):
    if let object = weak_ptr(&this.weak):
        ak.function1_call(&this.cb, object)

## Ported from Libraries/LibGC/Weak.h:163 GC::operator== (Weak<T>, Ptr<U>).
pub func eq_weak_u[T, U](a: Weak[T], b: U*?) -> bool:
    return (void*?)weak_ptr(&a) == (void*?)b

## Ported from Libraries/LibGC/Weak.h:169 GC::operator== (Weak<T>, Ref<U>).
pub func eq_weak_u_2[T, U](a: Weak[T], b: U*) -> bool:
    return (void*?)weak_ptr(&a) == (void*?)b
