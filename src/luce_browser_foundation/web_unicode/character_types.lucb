#==============================================================================================
#
#   character_types - Unicode::CharacterTypes: general categories, properties, scripts
#
#   DESCRIPTION:
#       Port of LibUnicode/CharacterTypes.cpp (lines 1-760) and CharacterTypes.h (lines
#       1-121). The C++ asks ICU (uchar.h, uscript.h, uniset.h); the port asks web_unicode's
#       tables (ucd.lucb, casing.lucb), which keep ICU's numbering of categories, properties
#       and scripts. The names ICU gives them are the generated ucd_*_names tables. The
#       extern "C" functions at the end serve LibRegex in Ladybird; they are ported for
#       completeness.
#
#==============================================================================================

# mark: Property names ==========================================================================

## AK::Traits<Unicode::PropertyName<PropertyType>>::equals: whether `property` is one of the
## names of `candidate` (an absent name matches nothing).
func property_name_equals(candidate: const UcdNames*, property: ak.StringView) -> bool:
    if candidate.long_name.length > 0 and view_equals(property, candidate.long_name):
        return true
    if candidate.short_name.length > 0 and view_equals(property, candidate.short_name):
        return true
    return candidate.additional_name.length > 0 and view_equals(property, candidate.additional_name)

# mark: General categories ======================================================================

## Ported from Libraries/LibUnicode/CharacterTypes.cpp:59 Unicode::general_category_from_string.
## The names are ICU's (u_getPropertyValueName of UCHAR_GENERAL_CATEGORY, and of
## UCHAR_GENERAL_CATEGORY_MASK for the groups): ucd_general_category_names.
pub func general_category_from_string(general_category: ak.StringView) -> u32?:
    for index in 0..<ucd_general_category_names.length:
        if property_name_equals(&ucd_general_category_names[index], general_category):
            return (u32)index
    return none

## Ported from Libraries/LibUnicode/CharacterTypes.cpp:93 Unicode::get_icu_mask.
func get_icu_mask(general_category: u32) -> u32:
    if general_category == general_category_cased_letter:
        return u_gc_lc_mask
    if general_category == general_category_letter:
        return u_gc_l_mask
    if general_category == general_category_mark:
        return u_gc_m_mask
    if general_category == general_category_number:
        return u_gc_n_mask
    if general_category == general_category_punctuation:
        return u_gc_p_mask
    if general_category == general_category_symbol:
        return u_gc_s_mask
    if general_category == general_category_separator:
        return u_gc_z_mask
    if general_category == general_category_other:
        return u_gc_c_mask

    return u_mask(general_category)

func has_general_category_mask(context: const void*, code_point: u32) -> bool:
    let category_mask = *(const u32*)context
    return (ucd_general_category_mask(code_point) & category_mask) != 0

## Ported from Libraries/LibUnicode/CharacterTypes.cpp:115 Unicode::code_point_has_general_category.
pub func code_point_has_general_category(code_point: u32, general_category: u32, case_sensitivity: ak.CaseSensitivity = ak.CaseSensitivity.case_sensitive) -> bool:
    let icu_code_point = code_point
    let category_mask = get_icu_mask(general_category)

    if (ucd_general_category_mask(icu_code_point) & category_mask) != 0:
        return true

    if case_sensitivity == ak.CaseSensitivity.case_sensitive:
        return false

    # The C++ caches the category's set closed over case (s_category_sets_with_case_closure);
    # a code point is in that set when a member of its case closure has the category.
    return case_closure_any(icu_code_point, &category_mask, has_general_category_mask)

