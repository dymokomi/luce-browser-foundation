## Ported from Libraries/LibUnicode/CharacterTypes.cpp:287 Unicode::is_ecma262_property.
# https://tc39.es/ecma262/#table-binary-unicode-properties
pub func is_ecma262_property(property: u32) -> bool:
    if property == property_any or property == property_ascii or property == property_assigned:
        return true

    # 1 UCHAR_ASCII_HEX_DIGIT, 0 UCHAR_ALPHABETIC, 2 UCHAR_BIDI_CONTROL, 3 UCHAR_BIDI_MIRRORED,
    # 50 UCHAR_CASE_IGNORABLE, 49 UCHAR_CASED, 54 UCHAR_CHANGES_WHEN_CASEFOLDED,
    # 55 UCHAR_CHANGES_WHEN_CASEMAPPED, 51 UCHAR_CHANGES_WHEN_LOWERCASED,
    # 56 UCHAR_CHANGES_WHEN_NFKC_CASEFOLDED, 53 UCHAR_CHANGES_WHEN_TITLECASED,
    # 52 UCHAR_CHANGES_WHEN_UPPERCASED, 4 UCHAR_DASH, 5 UCHAR_DEFAULT_IGNORABLE_CODE_POINT,
    # 6 UCHAR_DEPRECATED, 7 UCHAR_DIACRITIC, 57 UCHAR_EMOJI, 61 UCHAR_EMOJI_COMPONENT,
    # 59 UCHAR_EMOJI_MODIFIER, 60 UCHAR_EMOJI_MODIFIER_BASE, 58 UCHAR_EMOJI_PRESENTATION,
    # 64 UCHAR_EXTENDED_PICTOGRAPHIC, 8 UCHAR_EXTENDER, 10 UCHAR_GRAPHEME_BASE,
    # 11 UCHAR_GRAPHEME_EXTEND, 13 UCHAR_HEX_DIGIT, 18 UCHAR_IDS_BINARY_OPERATOR,
    # 19 UCHAR_IDS_TRINARY_OPERATOR, 15 UCHAR_ID_CONTINUE, 16 UCHAR_ID_START,
    # 17 UCHAR_IDEOGRAPHIC, 20 UCHAR_JOIN_CONTROL, 21 UCHAR_LOGICAL_ORDER_EXCEPTION,
    # 22 UCHAR_LOWERCASE, 23 UCHAR_MATH, 24 UCHAR_NONCHARACTER_CODE_POINT,
    # 42 UCHAR_PATTERN_SYNTAX, 43 UCHAR_PATTERN_WHITE_SPACE, 25 UCHAR_QUOTATION_MARK,
    # 26 UCHAR_RADICAL, 62 UCHAR_REGIONAL_INDICATOR, 35 UCHAR_S_TERM, 27 UCHAR_SOFT_DOTTED,
    # 28 UCHAR_TERMINAL_PUNCTUATION, 29 UCHAR_UNIFIED_IDEOGRAPH, 30 UCHAR_UPPERCASE,
    # 36 UCHAR_VARIATION_SELECTOR, 31 UCHAR_WHITE_SPACE, 32 UCHAR_XID_CONTINUE,
    # 33 UCHAR_XID_START
    match property:
        1, 0, 2, 3, 50, 49, 54, 55, 51, 56, 53, 52, 4, 5, 6, 7, 57, 61, 59, 60, 58, 64, 8, 10, 11, 13, 18, 19, 15, 16, 17, 20, 21, 22, 23, 24, 42, 43, 25, 26, 62, 35, 27, 28, 29, 30, 36, 31, 32, 33:
            return true
        _:
            return false

## Ported from Libraries/LibUnicode/CharacterTypes.cpp:350 Unicode::is_ecma262_string_property.
# https://tc39.es/ecma262/#table-binary-unicode-properties-of-strings
pub func is_ecma262_string_property(property: u32) -> bool:
    # 65 UCHAR_BASIC_EMOJI, 66 UCHAR_EMOJI_KEYCAP_SEQUENCE, 71 UCHAR_RGI_EMOJI,
    # 68 UCHAR_RGI_EMOJI_FLAG_SEQUENCE, 69 UCHAR_RGI_EMOJI_TAG_SEQUENCE,
    # 67 UCHAR_RGI_EMOJI_MODIFIER_SEQUENCE, 70 UCHAR_RGI_EMOJI_ZWJ_SEQUENCE
    match property:
        65, 66, 71, 68, 69, 67, 70:
            return true
        _:
            return false

## Ported from Libraries/LibUnicode/CharacterTypes.cpp:366 Unicode::get_property_strings.
pub func get_property_strings(property: u32) -> ak.Vector[ak.String]:
    var result: ak.Vector[ak.String]

    if not is_ecma262_string_property(property):
        return result

    # u_getBinaryPropertySet: the code points of the property, as ranges, then its strings.
    for code_point: u32 in 0..=0x10ffff:
        if ucd_has_binary_property(code_point, property):
            ak.vector_append_t(&result, ak.string_from_code_point(code_point))

    var offset: usize = 0
    while offset < ucd_emoji_sequences.length:
        let sequence_property = ucd_hex(ucd_emoji_sequences, offset, 2)
        let length = (usize)ucd_hex(ucd_emoji_sequences, offset + 2, 2)
        if sequence_property == property:
            var code_points = CodePointBuffer.create(length)
            for index in 0..<length:
                code_points.append(ucd_hex(ucd_emoji_sequences, offset + 4 + index * 6, 6))
            let bytes = encode_utf8_all(code_points.view())
            # icu_string_to_string
            ak.vector_append_t(&result, ak.string_from_utf8_without_validation(bytes.view()))
        offset += 4 + length * 6

    return result

