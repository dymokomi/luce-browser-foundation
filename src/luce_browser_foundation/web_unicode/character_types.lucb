# mark: Properties ==============================================================================

## Ported from Libraries/LibUnicode/CharacterTypes.cpp:188 Unicode::property_from_string.
## The names are ICU's (u_getPropertyName): ucd_binary_property_names, then Any, ASCII and
## Assigned.
pub func property_from_string(property: ak.StringView) -> u32?:
    for index in 0..<ucd_binary_property_names.length:
        if property_name_equals(&ucd_binary_property_names[index], property):
            return (u32)index

    if view_equals(property, "Any"):
        return property_any
    if view_equals(property, "ASCII"):
        return property_ascii
    if view_equals(property, "Assigned"):
        return property_assigned
    return none

func has_binary_property(context: const void*, code_point: u32) -> bool:
    return ucd_has_binary_property(code_point, *(const u32*)context)

## Ported from Libraries/LibUnicode/CharacterTypes.cpp:216 Unicode::code_point_has_property.
pub func code_point_has_property(code_point: u32, property: u32, case_sensitivity: ak.CaseSensitivity = ak.CaseSensitivity.case_sensitive) -> bool:
    let icu_code_point = code_point

    if property == property_any:
        return code_point <= 0x10ffff
    if property == property_ascii:
        return code_point < 0x80
    if property == property_assigned:
        return ucd_is_defined(icu_code_point)

    let icu_property = property
    if ucd_has_binary_property(icu_code_point, icu_property):
        return true

    if case_sensitivity == ak.CaseSensitivity.case_sensitive:
        return false

    # s_property_sets_with_case_closure: see code_point_has_general_category.
    return case_closure_any(icu_code_point, &icu_property, has_binary_property)

