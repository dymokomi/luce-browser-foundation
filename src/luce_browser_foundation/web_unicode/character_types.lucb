# mark: Bidi and line break classes =============================================================

## Ported from Libraries/LibUnicode/CharacterTypes.cpp:443 Unicode::char_direction_to_bidi_class.
## `direction` is ICU's UCharDirection.
func char_direction_to_bidi_class(direction: u32) -> BidiClass:
    match direction:
        5: return BidiClass.arabic_number  # U_ARABIC_NUMBER
        7: return BidiClass.block_separator  # U_BLOCK_SEPARATOR
        18: return BidiClass.boundary_neutral  # U_BOUNDARY_NEUTRAL
        6: return BidiClass.common_number_separator  # U_COMMON_NUMBER_SEPARATOR
        17: return BidiClass.dir_non_spacing_mark  # U_DIR_NON_SPACING_MARK
        2: return BidiClass.european_number  # U_EUROPEAN_NUMBER
        3: return BidiClass.european_number_separator  # U_EUROPEAN_NUMBER_SEPARATOR
        4: return BidiClass.european_number_terminator  # U_EUROPEAN_NUMBER_TERMINATOR
        19: return BidiClass.first_strong_isolate  # U_FIRST_STRONG_ISOLATE
        0: return BidiClass.left_to_right  # U_LEFT_TO_RIGHT
        11: return BidiClass.left_to_right_embedding  # U_LEFT_TO_RIGHT_EMBEDDING
        20: return BidiClass.left_to_right_isolate  # U_LEFT_TO_RIGHT_ISOLATE
        12: return BidiClass.left_to_right_override  # U_LEFT_TO_RIGHT_OVERRIDE
        10: return BidiClass.other_neutral  # U_OTHER_NEUTRAL
        16: return BidiClass.pop_directional_format  # U_POP_DIRECTIONAL_FORMAT
        22: return BidiClass.pop_directional_isolate  # U_POP_DIRECTIONAL_ISOLATE
        1: return BidiClass.right_to_left  # U_RIGHT_TO_LEFT
        13: return BidiClass.right_to_left_arabic  # U_RIGHT_TO_LEFT_ARABIC
        14: return BidiClass.right_to_left_embedding  # U_RIGHT_TO_LEFT_EMBEDDING
        21: return BidiClass.right_to_left_isolate  # U_RIGHT_TO_LEFT_ISOLATE
        15: return BidiClass.right_to_left_override  # U_RIGHT_TO_LEFT_OVERRIDE
        8: return BidiClass.segment_separator  # U_SEGMENT_SEPARATOR
        9: return BidiClass.white_space_neutral  # U_WHITE_SPACE_NEUTRAL
        _: trap("VERIFY_NOT_REACHED")

## Ported from Libraries/LibUnicode/CharacterTypes.cpp:498 Unicode::bidirectional_class.
pub func bidirectional_class(code_point: u32) -> BidiClass:
    let icu_code_point = code_point

    let direction = ucd_bidi_class(icu_code_point)
    return char_direction_to_bidi_class(direction)

## Ported from Libraries/LibUnicode/CharacterTypes.cpp:506 Unicode::line_break_class.
pub func line_break_class(code_point: u32) -> LineBreakClass:
    let icu_code_point = code_point
    let icu_line_break = ucd_line_break(icu_code_point)

    if icu_line_break == lb_al or icu_line_break == lb_hl:
        return LineBreakClass.alphabetic
    if icu_line_break == lb_nu:
        return LineBreakClass.numeric
    if icu_line_break == lb_id or icu_line_break == lb_h2 or icu_line_break == lb_h3:
        return LineBreakClass.ideographic
    if icu_line_break == lb_ai:
        return LineBreakClass.ambiguous
    if icu_line_break == lb_sa:
        return LineBreakClass.complex_context
    if icu_line_break == lb_cm:
        return LineBreakClass.combining_mark
    return LineBreakClass.other

# mark: Case-insensitive matching ===============================================================

## Ported from Libraries/LibUnicode/CharacterTypes.cpp:533 Unicode::canonicalize.
# 22.2.2.7.3 Canonicalize ( rer, ch ), https://tc39.es/ecma262/#sec-runtime-semantics-canonicalize-ch
pub func canonicalize(code_point: u32, unicode_mode: bool) -> u32:
    # 1. If HasEitherUnicodeFlag(rer) is true and rer.[[IgnoreCase]] is true, then
    #    a. If the file CaseFolding.txt of the Unicode Character Database provides a simple or common case folding mapping for ch, return the result of applying that mapping to ch.
    #    b. Return ch.
    if unicode_mode:
        return simple_case_folding(code_point)

    # 2. If rer.[[IgnoreCase]] is false, return ch.
    # NOTE: This is handled by the caller.

    # 3. Assert: ch is a UTF-16 code unit.
    # 4. Let cp be the code point whose numeric value is the numeric value of ch.
    # NOTE: We already have a code point.

    # 5. Let u be toUppercase(« cp »), according to the Unicode Default Case Conversion algorithm.
    # 6. Let uStr be CodePointsToString(u).

    # OPTIMIZATION: For ASCII characters, toUppercase is just to_ascii_uppercase.
    #               Conditions in 7 & 9 are trivially satisfied (ASCII always maps to a single code point, and the result stays in the same range).
    if code_point < 128:
        return code_point - 32 if code_point >= 0x61 and code_point <= 0x7a else code_point

    # String::from_code_point(code_point).to_uppercase(): the full uppercase mapping of the
    # one code point in the root locale.
    let single: u32[1] = [code_point]
    let uppercased = uppercase_code_points(single, CaseLocale.root)
    let code_points = uppercased.view()

    # 7. If the length of uStr ≠ 1, return ch.
    if code_points.length != 1:
        return code_point

    # 8. Let cu be uStr's single code unit element.
    let uppercased_code_point = code_points[0]

    # 9. If the numeric value of ch ≥ 128 and the numeric value of cu < 128, return ch.
    if code_point >= 128 and uppercased_code_point < 128:
        return code_point

    # 10. Return cu.
    return uppercased_code_point

## Ported from Libraries/LibUnicode/CharacterTypes.cpp:579 Unicode::expand_range_case_insensitive.
## icu::UnicodeSet(from, to).closeOver(USET_CASE_INSENSITIVE), as ranges.
pub func expand_range_case_insensitive(from_: u32, to: u32) -> ak.Vector[CodePointRange]:
    var result: ak.Vector[CodePointRange]
    let ranges = case_insensitive_ranges(from_, to)
    ak.vector_ensure_capacity(&result, ranges.count // 2)

    var index: usize = 0
    while index < ranges.count:
        ak.vector_append_t(&result, CodePointRange(from_ = ranges.items[index], to = ranges.items[index + 1]))
        index += 2

    return result

## The set [from, to] closed over case, as ascending (first, last) pairs.
func case_insensitive_ranges(from_: u32, to: u32) -> CodePointBuffer:
    # The code points the closure adds outside [from, to].
    var added = CodePointBuffer.create(8)
    var entry: usize = 0
    while entry < ucd_case_closure.length:
        let code_point = ucd_hex(ucd_case_closure, entry, 6)
        if code_point >= from_ and code_point <= to:
            var members = CodePointBuffer.create(4)
            append_case_pool(ucd_hex(ucd_case_closure, entry + 6, 4), ucd_hex(ucd_case_closure, entry + 10, 2), &members)
            for member in members.view():
                if member < from_ or member > to:
                    added.append(member)
        entry += 12
    sort_code_points(&added)
    # Merge the range with the added code points.
    var ranges = CodePointBuffer.create(8)
    var pending_range = true
    for code_point in added.view():
        if pending_range and code_point > to:
            append_range(&ranges, from_, to)
            pending_range = false
        append_range(&ranges, code_point, code_point)
    if pending_range:
        append_range(&ranges, from_, to)
    return ranges

## Append [first, last] to ascending ranges, merging with the last range when adjacent.
func append_range(ranges: CodePointBuffer*, first: u32, last: u32):
    if ranges.count >= 2:
        let previous_last = ranges.items[ranges.count - 1]
        if first <= previous_last +% 1 and first >= ranges.items[ranges.count - 2]:
            if last > previous_last:
                ranges.items[ranges.count - 1] = last
            return
    ranges.append(first)
    ranges.append(last)

## Sort code points ascending (insertion sort: the lists are short).
func sort_code_points(buffer: CodePointBuffer*):
    for index in 1..<buffer.count:
        let value = buffer.items[index]
        var position = index
        while position > 0 and buffer.items[position - 1] > value:
            buffer.items[position] = buffer.items[position - 1]
            position -= 1
        buffer.items[position] = value

## The code points of the case closure of `code_point` (itself included), ascending.
func case_closure_sorted(code_point: u32) -> CodePointBuffer:
    var closure = CodePointBuffer.create(4)
    closure.append(code_point)
    append_case_closure(code_point, &closure)
    sort_code_points(&closure)
    return closure

## Ported from Libraries/LibUnicode/CharacterTypes.cpp:594 Unicode::for_each_case_folded_code_point.
pub func for_each_case_folded_code_point(code_point: u32, callback: ak.Function1[u32, ak.IterationDecision]):
    let canonical = canonicalize(code_point, true)

    # icu::UnicodeSet closure(canonical, canonical); closure.closeOver(USET_CASE_INSENSITIVE);
    let closure = case_closure_sorted(canonical)

    var callback_ = callback
    for cp in closure.view():
        if call_code_point_callback(&callback_, cp) == ak.IterationDecision.break_:
            return

## Ported from Libraries/LibUnicode/CharacterTypes.cpp:612 Unicode::code_point_matches_range_ignoring_case.
pub func code_point_matches_range_ignoring_case(code_point: u32, from_: u32, to: u32, unicode_mode: bool) -> bool:
    if code_point >= from_ and code_point <= to:
        return true

    # icu::UnicodeSet candidates(code_point, code_point); candidates.closeOver(...);
    # candidates.retain(from, to);
    let closure = case_closure_sorted(code_point)
    var candidates = CodePointBuffer.create(4)
    for candidate in closure.view():
        if candidate >= from_ and candidate <= to:
            candidates.append(candidate)

    if candidates.count == 0:
        return false

    let canonical_ch = canonicalize(code_point, unicode_mode)
    for candidate_cp in candidates.view():
        if canonicalize(candidate_cp, unicode_mode) == canonical_ch:
            return true

    return false

## Ported from Libraries/LibUnicode/CharacterTypes.h:106 Unicode::ranges_equal_ignoring_case.
## The ranges are spans of code points.
pub func ranges_equal_ignoring_case(range1: const u32[], range2: const u32[], unicode_mode: bool) -> bool:
    var it1: usize = 0
    var it2: usize = 0
    let end1 = range1.length
    let end2 = range2.length

    while it1 != end1 and it2 != end2:
        if canonicalize(range1[it1], unicode_mode) != canonicalize(range2[it2], unicode_mode):
            return false
        it1 += 1
        it2 += 1

    return it1 == end1 and it2 == end2
