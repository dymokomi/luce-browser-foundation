## Ported from Libraries/LibUnicode/Segmenter.cpp:311 Unicode::Segmenter::create.
pub func segmenter_create_segmenter_granularity(segmenter_granularity: SegmenterGranularity) -> Segmenter*:
    return segmenter_create_string_view(default_locale(), segmenter_granularity)

## Ported from Libraries/LibUnicode/Segmenter.cpp:316 Unicode::Segmenter::create.
## The port's rules are the root locale's for every locale (ICU tailors a few locales).
pub func segmenter_create_string_view(locale: ak.StringView, segmenter_granularity: SegmenterGranularity) -> Segmenter*:
    _ = locale
    # createCharacterInstance, createLineInstance, createSentenceInstance, createWordInstance
    let segmenter = break_iterator_create(segmenter_granularity)
    return segmenter_impl_create(segmenter, segmenter_granularity)

## Ported from Libraries/LibUnicode/Segmenter.cpp:342 Unicode::Segmenter::create_for_ascii_grapheme.
pub func segmenter_create_for_ascii_grapheme(length: usize) -> Segmenter*:
    return ascii_grapheme_segmenter_create(length)

## Ported from Libraries/LibUnicode/Segmenter.cpp:347 Unicode::Segmenter::should_continue_beyond_word.
pub func segmenter_should_continue_beyond_word(word: ak.Utf16View) -> bool:
    var code_points = CodePointBuffer.create(utf16_view_length(&word) + 1)
    if utf16_view_is_ascii(&word):
        for byte in utf16_view_ascii(&word):
            code_points.append((u32)byte)
    else:
        decode_utf16(utf16_view_units(&word), &code_points, none)
    for code_point in code_points.view():
        if not code_point_has_punctuation_general_category(code_point) and not code_point_has_separator_general_category(code_point):
            return false
    return true

