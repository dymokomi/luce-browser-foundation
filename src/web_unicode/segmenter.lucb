## Ported from Libraries/LibUnicode/Segmenter.h:58 Unicode::Segmenter::Segmenter.
pub func segmenter_construct(this: Segmenter*, segmenter_granularity: SegmenterGranularity):
    this.m_segmenter_granularity = segmenter_granularity
